# Claude Code: session state and personal settings stay local; the shared
# hooks file (.claude/settings.json) is versioned.
.claude/*
!.claude/settings.json

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp

# Local-only env / temp
.env
.env.local
*.log

# Terraform local state + provider cache
**/.terraform/
**/.terraform.lock.hcl
*.tfstate
*.tfstate.*
*.tfplan
__pycache__/
# CocoIndex Code (ccc) — ignore index DBs, keep the shared settings
/.cocoindex_code/*
!/.cocoindex_code/settings.yml

# DeepSec AI scan workspace — local-only, never committed.
# 441MB of node_modules plus scan findings. Its own .gitignore reads as if the
# directory were meant to be tracked; it is not. Decided 2026-08-16.
medbrains/.deepsec/

# Build output and test-run artefacts — rebuilt, never committed.
**/target/
**/dist/
*.tsbuildinfo
*.a
allure-results/
allure-report/
allure-combined/
medbrains/apps/web/e2e/smoke/latency-report.jsonl
.DS_Store

# Office lock files, editor folders, run debris
~$*
.idea/
*.trace
server_err.log
test-results/
