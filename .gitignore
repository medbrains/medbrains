# Claude Code session state — do not commit
.claude/

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp

# Local-only env / temp
.env
.env.local
*.log

# Terraform local state + provider cache
**/.terraform/
**/.terraform.lock.hcl
*.tfstate
*.tfstate.*
*.tfplan
__pycache__/
# CocoIndex Code (ccc) — ignore index DBs, keep the shared settings
/.cocoindex_code/*
!/.cocoindex_code/settings.yml

# DeepSec AI scan workspace — local-only, never committed.
# 441MB of node_modules plus scan findings. Its own .gitignore reads as if the
# directory were meant to be tracked; it is not. Decided 2026-08-16.
medbrains/.deepsec/

# r8r — the workflow automation engine, developed alongside this repository but
# released on its own cadence. It is deliberately not part of this repo's
# history: a change there must not be able to reach the hospital without
# somebody choosing a version.
#
# Once it has a remote, replace this ignore with the pinned pointer:
#   git rm -r --cached r8r && git submodule add https://github.com/DomnicAmalan/r8r.git r8r
/r8r/
