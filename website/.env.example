# Marketing site config — copy to `.env` (local) or set in CI / Cloudflare / pipeline.
# Only PUBLIC_-prefixed vars reach the build. All optional — fallbacks in src/consts.ts.

PUBLIC_SITE_URL=https://www.medbrains.in     # full origin, used for canonical URLs + sitemap
PUBLIC_DOMAIN=medbrains.in               # bare domain (links to news.<domain>, etc.)
PUBLIC_BRAND=MedBrains
PUBLIC_TAGLINE=The whole hospital, on one system.
PUBLIC_EMAIL=hello@medbrains.in

PUBLIC_WHATSAPP=917200026117              # intl format, digits only
PUBLIC_FACEBOOK=https://www.facebook.com/share/17i9Q7CDHs/?mibextid=wwXIfr
PUBLIC_INSTAGRAM=https://instagram.com/medbrains_official
PUBLIC_LINKEDIN=                          # company page; hidden until set

PUBLIC_ENQUIRY_TENANT=                    # MedBrains' own hospital code on the app; unset = demo form opens WhatsApp
PUBLIC_APP_URL=https://app.medbrains.in   # where staff sign in
