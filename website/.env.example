# Marketing site config — copy to `.env` (local) or set in CI / Cloudflare / pipeline.
# Only PUBLIC_-prefixed vars reach the build. All optional — fallbacks in src/consts.ts.

PUBLIC_SITE_URL=https://medbrains.com     # full origin, used for canonical URLs + sitemap
PUBLIC_DOMAIN=medbrains.com               # bare domain (links to news.<domain>, etc.)
PUBLIC_BRAND=MedBrains
PUBLIC_TAGLINE=The hospital management system built audit-ready.
PUBLIC_EMAIL=hello@medbrains.com

PUBLIC_WHATSAPP=917200026117              # intl format, digits only
PUBLIC_FACEBOOK=https://www.facebook.com/share/17i9Q7CDHs/?mibextid=wwXIfr
PUBLIC_INSTAGRAM=https://instagram.com/medbrains_official
PUBLIC_GITHUB=https://github.com/YOUR_ORG/medbrains
PUBLIC_LINKEDIN=https://linkedin.com/company/YOUR_PAGE

PUBLIC_FORMSPREE_ID=YOUR_FORM_ID          # from https://formspree.io
