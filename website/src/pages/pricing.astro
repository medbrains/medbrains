---
// Pricing: the product and updates are free; implementation, customisation and AMC are charged.
// Every line comes from src/data/pricing.ts.
import chibi from "../assets/mascot/crab-chibi.svg?raw";
import Demo from "../components/Demo.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import Mission from "../components/Mission.astro";
import WhatsAppFloat from "../components/WhatsAppFloat.astro";
import { SITE } from "../consts";
import {
  CHARGES, COMMITMENTS, FREE, PASS_THROUGH, PILOT, PRICING_FAQ, QUOTE_ANSWERS, QUOTE_QUESTIONS, SEVA, STEPS, SUPPORT_US, ZERO,
} from "../data/pricing";
import Base from "../layouts/Base.astro";

const title = "MedBrains Pricing: Free Software, Paid Implementation";
const description = "MedBrains hospital software and every update cost ₹0, with a free 1-month pilot. Hospitals pay for implementation, customisation and a yearly AMC.";
const home = new URL("/", Astro.site).href;
const url = new URL("/pricing", Astro.site).href;
const schema = [
  {
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: SITE.brand, item: home },
      { "@type": "ListItem", position: 2, name: "Pricing", item: url },
    ],
  },
  { "@type": "WebPage", name: "MedBrains pricing", url, description, inLanguage: "en-IN" },
  {
    "@type": "FAQPage",
    mainEntity: PRICING_FAQ.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
  },
];
---

<script>
  // The hero's ₹0: the currency symbol turns through a few currencies ("zero in any
  // currency"). Static under reduced motion; pauses on hover, focus or the button.
  const fig = document.querySelector<HTMLElement>("[data-zero]");
  const cur = fig?.querySelector<HTMLElement>("[data-cur]");
  const toggle = fig?.parentElement?.querySelector<HTMLButtonElement>("[data-cur-toggle]");
  if (fig && cur && toggle && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
    const symbols = ["₹", "$", "€", "£", "د.إ", "ر.س", "¥"];
    let i = 0, hold = false, stopped = false;
    const box = fig.parentElement!;
    box.addEventListener("pointerenter", () => { hold = true; });
    box.addEventListener("pointerleave", () => { hold = false; });
    box.addEventListener("focusin", () => { hold = true; });
    box.addEventListener("focusout", () => { hold = false; });
    toggle.hidden = false;
    toggle.addEventListener("click", () => {
      stopped = !stopped;
      toggle.setAttribute("aria-pressed", String(stopped));
      toggle.textContent = stopped ? "Play currencies" : "Pause currencies";
    });
    const flip = async () => {
      if (hold || stopped) return;
      i = (i + 1) % symbols.length;
      await cur.animate([{ transform: "none", opacity: 1 }, { transform: "translateY(-60%)", opacity: 0 }], { duration: 120, easing: "ease-in" }).finished;
      cur.textContent = symbols[i];
      cur.classList.toggle("wide", symbols[i].length > 1);
      cur.animate([{ transform: "translateY(60%)", opacity: 0 }, { transform: "none", opacity: 1 }], { duration: 120, easing: "ease-out" });
    };
    setInterval(flip, 2000);
  }

  // "Get a quote": three answers about the hospital say how its go-live would look.
  const form = document.querySelector<HTMLFormElement>(".quote");
  if (form) {
    const answers = JSON.parse(form.dataset.answers ?? "{}");
    const show = () => {
      const a = new FormData(form);
      const clinic = a.get("kind") === "clinic";
      const id = a.get("scale") === "yes" ? "group" : clinic ? "clinic" : a.get("acute") === "yes" ? "acute" : "hospital";
      form.querySelector("[data-out=title]")!.textContent = answers[id].title;
      form.querySelector("[data-out=body]")!.textContent = answers[id].body;
      form.querySelector<HTMLElement>("[data-q=acute]")!.hidden = clinic;
    };
    form.addEventListener("change", show);
    show();
  }
</script>

<Base title={title} description={description} schema={schema}>
  <Header />
  <main id="main">
    <section class="hero">
      <div class="wrap">
        <nav class="crumbs-dark" aria-label="Breadcrumb"><a href="/">{SITE.brand}</a> / <span>Pricing</span></nav>
        <p class="eyebrow">Pricing</p>
        <h1>Free software. <span>Expert implementation.</span></h1>
        <p class="lede">MedBrains and every update are free for every hospital and clinic. No subscription, no charge per user. We earn by setting it up well and keeping it running.</p>
        <div class="zero">
          <p class="figure" data-zero>
            <span class="sr-only">Zero, in any currency.</span>
            <span class="slot" aria-hidden="true"><span class="cur" data-cur>₹</span></span><span aria-hidden="true">0</span>
          </p>
          <ul class="zero-list">
            {ZERO.map((z) => <li><span class="amt" aria-hidden="true"><span class="sym">₹</span>0</span><span class="sr-only">Zero rupees: </span>{z}</li>)}
          </ul>
          <button type="button" class="cur-toggle" aria-pressed="false" data-cur-toggle hidden>Pause currencies</button>
        </div>
        <div class="actions">
          <a class="btn btn-primary" href="#quote">Get a quote <span aria-hidden="true">→</span></a>
          <a class="btn btn-ghost" href="#demo">Book a demo</a>
        </div>
        <p class="terms-link">Read our <a href="/terms">commercial terms</a>.</p>
      </div>
    </section>

    <Mission />

    <div class="paper">
      <section class="section" aria-labelledby="free-title">
        <div class="wrap">
          <p class="eyebrow tag">Free, for everyone</p>
          <h2 id="free-title" class="title">What every hospital gets</h2>
          <div class="grid">
            {FREE.map((d) => (
              <article class="feature">
                <p class="price"><span aria-hidden="true"><span class="sym">₹</span>0</span><span class="sr-only">Zero rupees</span></p>
                <h3>{d.title}</h3><p>{d.body}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="section tinted" aria-labelledby="charge-title">
        <div class="wrap">
          <p class="eyebrow tag">Where we earn</p>
          <h2 id="charge-title" class="title">What we charge for</h2>
          <div class="charges">
            {CHARGES.map((c) => (
              <article class="charge">
                <p class="price quoted">Quoted</p>
                <h3>{c.title}</h3>
                <p class="when">{c.when}</p>
                <p>{c.body}</p>
                <ul>{c.items.map((i) => <li>{i}</li>)}</ul>
              </article>
            ))}
          </div>
          <p class="note">{PASS_THROUGH} Full details in our <a href="/terms">commercial terms</a>.</p>
        </div>
      </section>

      <section class="section" aria-labelledby="how-title">
        <div class="wrap">
          <h2 id="how-title" class="title">How it works</h2>
          <p class="pilot"><strong>{PILOT.line}</strong> {PILOT.body}</p>
          <ol class="steps">
            {STEPS.map((s) => <li><h3>{s.title}</h3><p>{s.body}</p></li>)}
          </ol>
        </div>
      </section>

      <section id="quote" class="section tinted" aria-labelledby="quote-title">
        <div class="wrap">
          <form class="calc quote" data-answers={JSON.stringify(QUOTE_ANSWERS)} aria-labelledby="quote-title" action="#demo">
            <div>
              <h2 id="quote-title">Get a quote</h2>
              {QUOTE_QUESTIONS.map((q) => (
                <fieldset data-q={q.name}>
                  <legend>{q.legend}</legend>
                  <div class="opts">
                    {q.options.map(([v, label]) => (
                      <label class="opt"><input type="radio" name={q.name} value={v} checked={v === q.value} /><span>{label}</span></label>
                    ))}
                  </div>
                </fieldset>
              ))}
            </div>
            <div class="calc-result" aria-live="polite">
              <span class="crab bob mascot" aria-hidden="true" set:html={chibi} />
              <p class="eyebrow tag">What to expect</p>
              <p class="big" data-out="title">{QUOTE_ANSWERS.acute.title}</p>
              <p data-out="body">{QUOTE_ANSWERS.acute.body}</p>
              <p class="small">The software is free. Your written quote covers implementation, any customisation and AMC.</p>
              <a class="btn btn-primary" href="?from=quote#demo">Ask for my quote <span aria-hidden="true">→</span></a>
              <p class="small">See our <a href="/terms">commercial terms</a>.</p>
            </div>
          </form>
        </div>
      </section>

      <section class="section" aria-labelledby="promise-title">
        <div class="wrap narrow">
          <h2 id="promise-title" class="title">Our promises, to everyone</h2>
          <ul class="commit">{COMMITMENTS.map((c) => <li>{c}</li>)}</ul>
          <p class="small">How we use AI and protect your data: <a href="/ai-and-data-safety">AI and data safety</a>.</p>
          <div class="seva">
            <p><strong>{SEVA.line}</strong> <a href={SEVA.cta.href}>{SEVA.cta.label} <span aria-hidden="true">→</span></a></p>
            <details>
              <summary>What we ask for</summary>
              <ul>{SEVA.documents.map((d) => <li>{d}</li>)}</ul>
              <p>{SEVA.process}</p>
            </details>
          </div>
        </div>
      </section>

      <section class="section tinted" aria-labelledby="support-title">
        <div class="wrap narrow">
          <h2 id="support-title" class="title">{SUPPORT_US.title}</h2>
          <p class="lead-p">{SUPPORT_US.body}</p>
          <ul class="ways">{SUPPORT_US.ways.map((w) => <li>{w}</li>)}</ul>
          <p class="small">{SUPPORT_US.rules}</p>
          <p class="small">Other ways in: <a href="/sponsors">sponsor MedBrains</a>, or install and support it for hospitals near you through the <a href="/partners">partner programme</a>.</p>
          <a class="btn btn-ghost dark" href={`mailto:${SITE.email}?subject=${encodeURIComponent(SUPPORT_US.cta.subject)}`}>{SUPPORT_US.cta.label}</a>
        </div>
      </section>

      <section class="section" aria-labelledby="faq-title">
        <div class="wrap narrow">
          <h2 id="faq-title" class="title">Questions</h2>
          {PRICING_FAQ.map((f) => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}
        </div>
      </section>
    </div>

    <Demo source="pricing" size={{ label: "What do you run?", options: ["Clinic or day-care centre", "Hospital or nursing home", "Multi-specialty hospital", "Group of hospitals or medical college", "Charitable, trust or government hospital"] }} />
  </main>
  <Footer />
  <WhatsAppFloat />
</Base>

<style lang="scss">
  @use "../styles/mixins" as *;

  .hero {
    color: #fff; padding: 72px 0 88px;
    background:
      radial-gradient(700px 460px at 12% 110%, var(--glow-purple), transparent 65%),
      radial-gradient(900px 500px at 80% -20%, rgb(15 98 254 / 35%), transparent 60%), var(--night);
    .eyebrow { color: var(--pulse); }
    h1 { font: 900 clamp(2.3rem, 6vw, 4.4rem) var(--display); letter-spacing: -.035em; line-height: 1.02; margin: 0 0 20px; max-width: 16ch; }
    h1 span { color: var(--sky); }
    .lede { color: var(--night-text); font-size: 1.15rem; max-width: 58ch; margin: 0 0 32px; }
    .btn-ghost { color: #fff; }
  }
  .zero {
    position: relative; display: flex; flex-wrap: wrap; align-items: center; gap: 12px 40px; margin: 0 0 36px;
    padding: 24px 28px; max-width: 720px; border: 1px solid var(--night-line); border-radius: var(--radius-lg); background: rgb(255 255 255 / 4%);
  }
  .figure {
    display: flex; align-items: center; height: 1em; margin: 0;
    font: 900 clamp(4rem, 10vw, 6.4rem)/1 var(--display); letter-spacing: -.04em; color: #fff;
  }
  /* Fixed-width slot: the symbol changes, nothing around it moves. */
  .slot { display: inline-flex; align-items: center; justify-content: flex-end; width: .78em; height: 1em; overflow: hidden; color: var(--sky); }
  .cur { display: inline-block; }
  /* ₹ sits outside Archivo's latin subset; drawing currency symbols in the system face
     keeps the 86 KB latin-ext font off the page. */
  .cur, .sym { font-family: system-ui, sans-serif; }
  .cur.wide { font-size: .42em; letter-spacing: 0; }
  .zero-list {
    margin: 0; padding: 0; list-style: none; display: grid; gap: 8px; color: var(--night-text);
    .amt { display: inline-block; min-width: 2.6em; font: 800 1.15rem var(--display); color: #fff; }
  }
  .cur-toggle {
    position: absolute; top: 12px; right: 12px; min-height: 32px; padding: 0 14px;
    border: 1px solid var(--night-line); border-radius: 999px; background: none; color: var(--night-text);
    font: 600 .82rem var(--sans); cursor: pointer;
  }
  .cur-toggle:hover { color: #fff; }
  .cur-toggle[hidden] { display: none; }
  .price { margin: 0 0 10px !important; font: 900 2.2rem/1 var(--display) !important; letter-spacing: -.03em; color: var(--blue) !important; }
  .quoted { font-size: 1.6rem !important; color: var(--blue-deep) !important; }
  .pilot {
    margin: -12px 0 32px; padding: 16px 20px; max-width: 860px; border-left: 4px solid var(--purple);
    background: var(--paper-2); border-radius: 0 var(--radius) var(--radius) 0; color: var(--ink-2);
    strong { color: var(--ink); }
  }
  .crumbs-dark { margin-bottom: 28px; font-size: .88rem; color: var(--night-text); a { color: #fff; } }
  .actions { display: flex; flex-wrap: wrap; gap: 12px; }

  .paper { background: var(--paper); color: var(--ink); }
  .paper .section { padding: 88px 0; }
  .tinted { background: var(--paper-2); }
  .narrow > * { max-width: 860px; }
  .title { font: 800 clamp(1.7rem, 3.4vw, 2.4rem)/1.1 var(--display); letter-spacing: -.025em; margin: 0 0 32px; max-width: 24ch; }
  .eyebrow.tag { color: var(--purple); }
  .note, .small { margin: 20px 0 0; color: var(--muted); font-size: .95rem; }

  .grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }
  .feature {
    padding: 26px; border: 1px solid var(--line); border-radius: 18px; background: #fff; box-shadow: var(--shadow-soft);
    h3 { font: 800 1.12rem var(--display); letter-spacing: -.02em; margin: 0 0 8px; }
    p { margin: 0; color: var(--ink-2); }
  }

  .charges { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .charge {
    padding: 30px 26px; border: 1px solid var(--line); border-top: 4px solid var(--blue); border-radius: var(--radius-lg);
    background: #fff; box-shadow: var(--shadow-soft);
    h3 { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; font: 800 1.5rem var(--display); letter-spacing: -.02em; margin: 0 0 4px; }
    p { margin: 0 0 14px; color: var(--ink-2); }
    ul { margin: 0; padding-left: 1.1em; display: grid; gap: 8px; color: var(--ink-2); }
  }
  .when { font: 600 .82rem var(--mono) !important; color: var(--blue-deep) !important; }
  .terms-link { margin: 20px 0 0; color: var(--night-text); font-size: .95rem; a { color: #fff; } }
  .note a, .small a { color: var(--blue-deep); }
  .lead-p { margin: 0 0 16px; color: var(--ink-2); font-size: 1.08rem; }
  .ways { margin: 0; padding-left: 1.1em; display: grid; gap: 8px; color: var(--ink-2); }
  .btn.dark { margin-top: 24px; color: var(--ink); }
  .steps {
    margin: 0; padding: 0; list-style: none; counter-reset: step;
    display: grid; grid-template-columns: repeat(4, 1fr); gap: 28px 20px;
    li { counter-increment: step; padding-top: 16px; border-top: 2px solid var(--line); }
    li::before { content: counter(step, decimal-leading-zero); font: 600 .8rem var(--mono); color: var(--purple); }
    h3 { font: 800 1.15rem var(--display); margin: 6px 0 6px; }
    p { margin: 0; color: var(--ink-2); }
  }

  .calc {
    display: grid; grid-template-columns: 1.2fr 1fr; gap: 40px; align-items: center;
    padding: 40px; border-radius: var(--radius-lg); background: var(--blue-tint);
    h2 { font: 800 clamp(1.5rem, 3vw, 2rem)/1.1 var(--display); letter-spacing: -.02em; margin: 0 0 16px; }
  }
  fieldset { margin: 0 0 18px; padding: 0; border: 0; }
  fieldset[hidden] { display: none; }
  legend { padding: 0; margin-bottom: 10px; font-weight: 600; color: var(--ink); }
  .opts { display: flex; flex-wrap: wrap; gap: 10px; }
  .opt {
    position: relative; display: inline-flex; cursor: pointer;
    input { position: absolute; opacity: 0; inset: 0; margin: 0; cursor: pointer; }
    span {
      display: inline-flex; align-items: center; min-height: 44px; padding: 0 18px; border-radius: 999px;
      border: 1.5px solid var(--line); background: #fff; color: var(--ink-2); font-weight: 600;
      transition: background .15s ease, border-color .15s ease, color .15s ease;
    }
    input:checked + span { background: var(--blue); border-color: var(--blue); color: #fff; }
    input:focus-visible + span { outline: 3px solid var(--blue); outline-offset: 3px; }
  }
  .calc-result {
    position: relative; padding: 28px; border-radius: var(--radius-lg); background: #fff; box-shadow: var(--shadow-soft);
    p { margin: 0; color: var(--ink-2); }
    .eyebrow { margin-bottom: 8px; }
    .small { margin: 14px 0 18px; }
    .btn-primary { color: #fff; }
    .mascot { position: absolute; top: -34px; right: 18px; width: 64px; height: 64px; }
  }
  .big { margin: 0 0 8px !important; font: 800 1.6rem/1.15 var(--display); letter-spacing: -.02em; color: var(--ink) !important; }

  .commit {
    margin: 0; padding: 0; list-style: none; display: grid; gap: 12px;
    li { padding: 16px 20px 16px 24px; border-left: 4px solid var(--blue); background: var(--paper-2); border-radius: 0 var(--radius) var(--radius) 0; color: var(--ink-2); font-size: 1.05rem; }
  }
  .seva {
    margin-top: 32px; padding: 24px; border-radius: var(--radius-lg); border: 1px solid var(--line);
    background: linear-gradient(135deg, rgb(133 27 127 / 6%), rgb(15 98 254 / 6%)), var(--paper);
    p { margin: 0; color: var(--ink-2); }
    a { color: var(--purple); font-weight: 600; }
    details { border: 0; margin-top: 8px; }
    summary { padding: 10px 0; font-size: 1rem; }
    ul { margin: 0 0 12px; padding-left: 1.1em; color: var(--ink-2); display: grid; gap: 6px; }
  }

  details { border-bottom: 1px solid var(--line); }
  summary { cursor: pointer; padding: 20px 0; font-weight: 700; font-size: 1.08rem; }
  details p { margin: 0 0 20px; color: var(--ink-2); }

  @include below(xl) { .charges { grid-template-columns: 1fr; max-width: 640px; } .steps { grid-template-columns: 1fr 1fr; } }
  @include below(lg) { .grid { grid-template-columns: 1fr 1fr; } .calc { grid-template-columns: 1fr; padding: 28px 20px; gap: 48px; } }
  @include below(sm) {
    .grid, .steps { grid-template-columns: 1fr; }
    .paper .section { padding: 56px 0; }
    .charge { padding: 24px 20px; }
  }
</style>
