---
import { getCollection, render, type CollectionEntry } from "astro:content";
import Footer from "../../components/Footer.astro";
import Header from "../../components/Header.astro";
import WhatsAppFloat from "../../components/WhatsAppFloat.astro";
import { SITE } from "../../consts";
import Base from "../../layouts/Base.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props as { post: CollectionEntry<"blog"> };
const { Content } = await render(post);
const { title, description, date, tags, sources } = post.data;
const url = new URL(`/blog/${post.id}`, Astro.site).href;
const day = new Intl.DateTimeFormat("en-IN", { dateStyle: "long" });
const schema = [
  {
    "@type": "BlogPosting",
    headline: title,
    description,
    datePublished: date.toISOString(),
    url,
    author: { "@type": "Organization", name: SITE.brand },
    publisher: { "@type": "Organization", name: SITE.brand },
    citation: sources.map((s) => s.url),
  },
  {
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: SITE.brand, item: new URL("/", Astro.site).href },
      { "@type": "ListItem", position: 2, name: "Blog", item: new URL("/blog", Astro.site).href },
      { "@type": "ListItem", position: 3, name: title, item: url },
    ],
  },
];
---

<Base title={`${title} | ${SITE.brand}`} description={description} schema={schema}>
  <Header />
  <main id="main">
    <article>
      <header class="hero">
        <div class="wrap narrow">
          <nav class="crumbs" aria-label="Breadcrumb"><a href="/blog">Health blog</a> / <span>{tags.join(" · ")}</span></nav>
          <h1>{title}</h1>
          <p class="meta">By the {SITE.brand} team · <time datetime={date.toISOString()}>{day.format(date)}</time></p>
        </div>
      </header>
      <div class="body">
        <div class="wrap narrow prose">
          <Content />
          <aside class="cta" aria-label="MedBrains for hospitals">
            <p><strong>Run a hospital or clinic?</strong> MedBrains puts OPD, wards, lab, pharmacy and billing on one system.</p>
            <a class="btn btn-primary" href="/?from=blog#demo">Book a demo <span aria-hidden="true">→</span></a>
          </aside>
          <aside class="sources" aria-label="Sources">
            <h2>Sources</h2>
            <ul>{sources.map((s) => <li><a href={s.url} target="_blank" rel="noopener">{s.title}</a></li>)}</ul>
          </aside>
          <a class="back" href="/blog">← All articles</a>
        </div>
      </div>
    </article>
  </main>
  <Footer />
  <WhatsAppFloat />
</Base>

<style lang="scss">
  .hero {
    padding: 64px 0 56px;
    background: radial-gradient(900px 500px at 80% -20%, rgb(15 98 254 / 35%), transparent 60%), var(--night);
    h1 { font: 900 clamp(1.9rem, 4.2vw, 3.2rem) var(--display); letter-spacing: -.03em; line-height: 1.08; margin: 0 0 18px; }
  }
  .narrow { max-width: 760px; }
  .crumbs { margin-bottom: 24px; font-size: .88rem; color: var(--night-text); a { color: #fff; } }
  .meta { margin: 0; color: var(--night-text); font-size: .95rem; }
  .body { background: var(--paper); color: var(--ink); padding: 56px 0 96px; }
  .prose {
    font-size: 1.08rem; line-height: 1.7;
    :global(h2) { font: 800 1.45rem/1.25 var(--display); letter-spacing: -.02em; margin: 48px 0 12px; }
    :global(p), :global(li) { color: var(--ink-2); }
    :global(li) { margin-bottom: 8px; }
    :global(strong) { color: var(--ink); }
    :global(a) { color: var(--blue-deep); }
    :global(code) { font: 500 .92em var(--mono); background: var(--paper-2); padding: 1px 6px; border-radius: 4px; }
  }
  .cta {
    display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px;
    margin-top: 48px; padding: 24px 28px; border-radius: var(--radius); background: var(--blue-tint);
    p { margin: 0; flex: 1 1 320px; }
    :global(a.btn) { color: #fff; }
  }
  .sources {
    margin-top: 48px; padding: 24px 28px; border: 1px solid var(--line); border-radius: var(--radius); background: var(--paper-2);
    h2 { margin-top: 0; font-size: 1rem; }
    ul { margin: 0; padding-left: 20px; }
  }
  .back { display: inline-block; margin-top: 32px; font-weight: 600; }
</style>
