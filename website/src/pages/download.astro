---
// Download: every MedBrains release asset, linked from GitHub Releases so the page
// never needs editing per release.
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import WhatsAppFloat from "../components/WhatsAppFloat.astro";
import { SITE } from "../consts";
import Base from "../layouts/Base.astro";

// The version shown on the page. Change this one line per release.
const VERSION = "3.33.0";
const REPO = "https://github.com/medbrains/medbrains";
// ponytail: OS image and desktop asset names carry the version, so they can only link to the
// release page. Drop version numbers from asset names in release.yml for stable latest/download links.
const RELEASE = `${REPO}/releases/latest`;
const direct = (asset: string) => `${REPO}/releases/latest/download/${asset}`;
const os = (suffix: string) => `medbrains-os-v${VERSION}-${suffix}`;
const app = (suffix: string) => `MedBrains_${VERSION}_${suffix}`;
// The format a link names, from the file name: "x.raw.zst" is "RAW", "x.msi" is "MSI".
const format = (file: string) => file.replace(/\.zst$/, "").split(".").pop()?.toUpperCase();
const arch = (file: string) => (file.includes("arm64") ? "arm64" : "x86-64");

const OS_TARGETS = [
  { where: "Bare metal", how: "Write the ISO to a USB stick and boot the machine from it.", files: [os("x86-64.iso"), os("arm64.iso")] },
  { where: "VMware", how: "Import the OVA, or attach the VMDK to a new virtual machine.", files: [os("x86-64.ova"), os("x86-64.vmdk")] },
  { where: "Hyper-V", how: "Attach the VHDX to a new Generation 2 virtual machine.", files: [os("x86-64.vhdx")] },
  { where: "KVM and Proxmox", how: "Use the qcow2 file as the virtual machine's disk.", files: [os("x86-64.qcow2"), os("arm64.qcow2")] },
  { where: "Azure", how: "Decompress with zstd, then upload the VHD as a managed disk.", files: [os("x86-64-azure.vhd.zst")] },
  { where: "AWS", how: "Decompress with zstd, then import the raw disk as a snapshot.", files: [os("x86-64.raw.zst"), os("arm64.raw.zst")] },
];
const DESKTOP = [
  { where: "Windows", files: [app("x64-setup-unsigned.exe"), app("x64-unsigned.msi")] },
  { where: "macOS", files: [app("universal-unsigned.dmg")] },
  { where: "Linux", files: [app("amd64.AppImage"), app("amd64.deb"), `MedBrains-${VERSION}-1.x86_64.rpm`] },
];
const SERVER = [
  { label: "Server binaries for Linux x86-64", file: "medbrains-server-bins-linux-x86-64.tar.gz" },
  { label: "Server binaries for Linux arm64", file: "medbrains-server-bins-linux-arm64.tar.gz" },
  { label: "Web app, built", file: "medbrains-web-dist.tar.gz" },
];

const title = "Download MedBrains: OS image, desktop and apps";
const description = "Download MedBrains OS for bare metal, VMware, Hyper-V, KVM, Azure or AWS, plus the desktop client, the Android staff app and the server binaries.";
const home = new URL("/", Astro.site).href;
const url = new URL("/download", Astro.site).href;
const schema = [
  {
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: SITE.brand, item: home },
      { "@type": "ListItem", position: 2, name: "Download", item: url },
    ],
  },
  { "@type": "WebPage", name: title, url, description, inLanguage: "en-IN" },
];
---

<Base title={title} description={description} schema={schema}>
  <Header />
  <main id="main">
    <section class="hero">
      <div class="wrap">
        <nav class="crumbs-dark" aria-label="Breadcrumb"><a href="/">{SITE.brand}</a> / <span>Download</span></nav>
        <p class="eyebrow">Version {VERSION}</p>
        <h1>Download <span>MedBrains.</span></h1>
        <p class="lede">Everything comes from our GitHub releases. Start with the OS image: it runs the whole hospital. MedBrains is open source under the AGPL-3.0-only licence.</p>
        <div class="actions">
          <a class="btn btn-primary" href="#os-title">Get the OS image</a>
          <a class="btn btn-ghost" href="#verify-title">Verify your download</a>
        </div>
      </div>
    </section>

    <div class="paper">
      <section class="section" aria-labelledby="os-title">
        <div class="wrap">
          <p class="eyebrow tag">Recommended</p>
          <h2 id="os-title" class="title">OS image</h2>
          <p class="note">One image for every machine. Pick where it will run. Each link opens the release page; download the file named below the link.</p>
          <div class="grid">
            {OS_TARGETS.map((t) => (
              <article class="feature">
                <h3>{t.where}</h3>
                <p>{t.how}</p>
                <ul class="files">
                  {t.files.map((f) => <li><a href={RELEASE}>{t.where}: {format(f)} for {arch(f)}</a><code>{f}</code></li>)}
                </ul>
              </article>
            ))}
          </div>
          <p class="small">Not sure which processor you have? Most servers and PCs are x86-64 (Intel or AMD). See the <a href="/os">MedBrains OS page</a> for hardware sizes.</p>
        </div>
      </section>

      <section class="section tinted" aria-labelledby="desktop-title">
        <div class="wrap">
          <p class="eyebrow tag">For staff computers</p>
          <h2 id="desktop-title" class="title">Desktop client</h2>
          <div class="grid">
            {DESKTOP.map((d) => (
              <article class="feature">
                <h3>{d.where}</h3>
                <ul class="files">
                  {d.files.map((f) => <li><a href={RELEASE}>{d.where}: {format(f)} installer</a><code>{f}</code></li>)}
                </ul>
              </article>
            ))}
          </div>
          <div class="warn" role="note">
            <h3>The desktop apps are not code-signed yet</h3>
            <p>Windows and macOS will warn you when you install them. Check the file first: its checksum must match the line in SHA256SUMS (see <a href="#verify-title">Verify your download</a>). If it does not match, delete the file.</p>
            <ul>
              <li><strong>Windows:</strong> on the "Windows protected your PC" screen, choose "More info", then "Run anyway".</li>
              <li><strong>macOS:</strong> open the app once, then go to System Settings, Privacy and Security, and choose "Open Anyway".</li>
            </ul>
          </div>
        </div>
      </section>

      <section class="section" aria-labelledby="android-title">
        <div class="wrap narrow">
          <p class="eyebrow tag">For staff phones</p>
          <h2 id="android-title" class="title">Android staff app</h2>
          <p class="note">Install the APK on a staff phone. Android will ask you to allow installs from your browser or file manager.</p>
          <div class="actions">
            <a class="btn btn-primary" href={direct("medbrains-staff-android.apk")}>Download the Android staff app (APK)</a>
          </div>
          <p class="small">The Play Store bundle (.aab) is on the <a href={RELEASE}>release page</a>. The iPhone apps are coming to the App Store. The patient app is not in this release yet.</p>
        </div>
      </section>

      <section class="section tinted" aria-labelledby="server-title">
        <div class="wrap narrow">
          <p class="eyebrow tag">For advanced users</p>
          <h2 id="server-title" class="title">Server binaries</h2>
          <p class="note">Run MedBrains on your own Linux server instead of the OS image. You set up PostgreSQL and the services yourself.</p>
          <ul class="files list">
            {SERVER.map((s) => <li><a href={direct(s.file)}>{s.label}</a><code>{s.file}</code></li>)}
          </ul>
        </div>
      </section>

      <section class="section" aria-labelledby="verify-title">
        <div class="wrap narrow">
          <p class="eyebrow tag">Check before you install</p>
          <h2 id="verify-title" class="title">Verify your download</h2>
          <p class="note">Download <a href={direct("SHA256SUMS")}>SHA256SUMS</a> and its signature <a href={direct("SHA256SUMS.sigstore.json")}>SHA256SUMS.sigstore.json</a> into the same folder as your file.</p>
          <ol class="commit">
            <li>Check that the file is not damaged or changed. Every file you downloaded should say "OK".
              <pre><code>sha256sum --ignore-missing -c SHA256SUMS</code></pre>
              On macOS, use <code>shasum -a 256 --ignore-missing -c SHA256SUMS</code>. On Windows, run <code>certutil -hashfile FILE SHA256</code> and compare it with the line for that file.
            </li>
            <li>Check that SHA256SUMS came from our release workflow, using <a href="https://docs.sigstore.dev/cosign/system_config/installation/">cosign</a>. It should say "Verified OK".
              <pre><code>{`cosign verify-blob SHA256SUMS \\
  --bundle SHA256SUMS.sigstore.json \\
  --certificate-identity-regexp '^${REPO}/.github/workflows/release.yml@refs/tags/v' \\
  --certificate-oidc-issuer https://token.actions.githubusercontent.com`}</code></pre>
            </li>
          </ol>
          <p class="small">If either check fails, do not install the file. Tell us at <a href={`mailto:${SITE.email}`}>{SITE.email}</a>.</p>
        </div>
      </section>
    </div>
  </main>
  <Footer />
  <WhatsAppFloat />
</Base>

<style lang="scss">
  @use "../styles/mixins" as *;

  .hero {
    color: #fff; padding: 72px 0 88px;
    background:
      radial-gradient(700px 460px at 12% 110%, var(--glow-green), transparent 65%),
      radial-gradient(900px 500px at 80% -20%, var(--glow-blue), transparent 60%), var(--night);
    .eyebrow { color: var(--pulse); }
    h1 { font: 900 clamp(2.3rem, 6vw, 4.4rem) var(--display); letter-spacing: -.035em; line-height: 1.02; margin: 0 0 20px; max-width: 16ch; }
    h1 span { color: var(--sky); }
    .lede { color: var(--night-text); font-size: 1.15rem; max-width: 60ch; margin: 0 0 32px; }
    .btn-ghost { color: #fff; }
  }
  .crumbs-dark { margin-bottom: 28px; font-size: .88rem; color: var(--night-text); a { color: #fff; } }
  .actions { display: flex; flex-wrap: wrap; gap: 12px; }

  .paper { background: var(--paper); color: var(--ink); }
  .paper .section { padding: 88px 0; }
  .tinted { background: var(--paper-2); }
  .narrow > * { max-width: 860px; }
  .title { font: 800 clamp(1.7rem, 3.4vw, 2.4rem)/1.1 var(--display); letter-spacing: -.025em; margin: 0 0 32px; max-width: 26ch; }
  .eyebrow.tag { color: var(--purple); }
  .note { margin: -16px 0 28px; color: var(--ink-2); max-width: 70ch; }
  .small { margin: 24px 0 0; color: var(--muted); font-size: .95rem; max-width: 80ch; }
  .paper a:not(.btn) { color: var(--blue-deep); }

  .grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }
  .feature {
    padding: 26px; border: 1px solid var(--line); border-radius: 18px; background: var(--paper); box-shadow: var(--shadow-soft);
    h3 { font: 800 1.12rem var(--display); letter-spacing: -.02em; margin: 0 0 8px; }
    p { margin: 0; color: var(--ink-2); }
  }

  .files {
    margin: 16px 0 0; padding: 0; list-style: none; display: grid; gap: 12px;
    li { display: grid; gap: 2px; }
    a { font-weight: 700; min-height: 24px; }
    code { font: .78rem var(--mono); color: var(--muted); overflow-wrap: anywhere; }
  }
  .files.list li { padding: 16px 20px; border: 1px solid var(--line); border-radius: var(--radius); background: var(--paper); }

  .warn {
    margin-top: 28px; padding: 24px 26px; border-left: 4px solid var(--purple); background: var(--paper); border-radius: 0 var(--radius) var(--radius) 0;
    h3 { font: 800 1.12rem var(--display); margin: 0 0 8px; }
    p, li { color: var(--ink-2); }
    p { margin: 0 0 12px; }
    ul { margin: 0; padding-left: 20px; display: grid; gap: 6px; }
  }

  .commit {
    margin: 0; padding: 0; list-style: none; display: grid; gap: 12px; counter-reset: step;
    li { min-width: 0; counter-increment: step; padding: 16px 20px 16px 24px; border-left: 4px solid var(--blue); background: var(--paper-2); border-radius: 0 var(--radius) var(--radius) 0; color: var(--ink-2); font-size: 1.05rem; }
    li::before { content: counter(step) ". "; font-weight: 700; color: var(--ink); }
    code { font: .88rem var(--mono); }
  }
  pre {
    margin: 12px 0; padding: 16px 18px; overflow-x: auto; border-radius: var(--radius);
    background: var(--night); color: var(--night-text);
    code { white-space: pre; }
  }

  @include below(lg) { .grid { grid-template-columns: 1fr 1fr; } }
  @include below(sm) {
    .grid { grid-template-columns: 1fr; }
    .paper .section { padding: 56px 0; }
  }
</style>
