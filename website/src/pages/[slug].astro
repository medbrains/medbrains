---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import WhatsAppFloat from "../components/WhatsAppFloat.astro";
import { SITE } from "../consts";
import { MODULE_PAGES, type ModulePage } from "../data/modules";
import Base from "../layouts/Base.astro";
import { getPosts, postPath } from "../lib/blog";

export function getStaticPaths() {
  return MODULE_PAGES.map((page) => ({ params: { slug: page.slug }, props: { page } }));
}

const { page } = Astro.props as { page: ModulePage };
const url = new URL(`/${page.slug}`, Astro.site).href;
const parent = MODULE_PAGES.find((p) => p.slug === page.parent);
const crumbs = [
  { name: SITE.brand, href: "/" },
  ...(parent ? [{ name: parent.eyebrow, href: `/${parent.slug}` }] : []),
  { name: page.eyebrow, href: `/${page.slug}` },
];
const related = page.related
  .map((slug) => MODULE_PAGES.find((p) => p.slug === slug))
  .filter((p): p is ModulePage => Boolean(p));
const posts = (await getPosts()).filter((p) => page.posts?.includes(p.id));
const schema = [
  {
    "@type": "BreadcrumbList",
    itemListElement: crumbs.map((c, i) => ({
      "@type": "ListItem", position: i + 1, name: c.name, item: new URL(c.href, Astro.site).href,
    })),
  },
  {
    "@type": "FAQPage",
    mainEntity: page.faq.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
  },
];
---

<Base title={page.title} description={page.description} schema={schema}>
  <Header />
  <main id="main">
    <section class="hero">
      <div class="wrap">
        <nav class="crumbs" aria-label="Breadcrumb">
          {crumbs.slice(0, -1).map((c) => <><a href={c.href}>{c.name}</a> / </>)}<span>{page.eyebrow}</span>
        </nav>
        <p class="eyebrow">{page.eyebrow}</p>
        <h1>{page.h1}</h1>
        <p class="lede">{page.intro}</p>
        <a class="btn btn-primary" href="/#demo">Book a demo <span aria-hidden="true">→</span></a>
      </div>
    </section>

    {page.sections?.map((sec, i) => (
      <section class:list={["section", "prose", { tinted: i % 2 === 0 }]}>
        <div class="wrap narrow">
          <h2 class="section-title">{sec.title}</h2>
          {sec.body?.map((para) => <p set:html={para} />)}
          {sec.steps && (
            <ol class="steps" style={sec.start ? `counter-reset: step ${sec.start - 1}` : undefined}>
              {sec.steps.map((st) => (
                <li><h3>{st.title}</h3><p set:html={st.body} /></li>
              ))}
            </ol>
          )}
          {sec.table && (
            <div class="table-scroll" role="region" aria-label={sec.table.caption} tabindex="0">
              <table>
                <caption>{sec.table.caption}</caption>
                <thead><tr>{sec.table.head.map((h) => <th scope="col">{h}</th>)}</tr></thead>
                <tbody>
                  {sec.table.rows.map(([first, ...rest]) => (
                    <tr><th scope="row">{first}</th>{rest.map((c) => <td>{c}</td>)}</tr>
                  ))}
                </tbody>
              </table>
            </div>
          )}
          {sec.after?.map((para) => <p set:html={para} />)}
        </div>
      </section>
    ))}

    <section class="section">
      <div class="wrap">
        <h2 class="section-title">{page.featuresTitle ?? "What it does"}</h2>
        <div class="grid">
          {page.features.map((f) => (
            <article class="feature reveal">
              <h3>{f.title}</h3>
              <p>{f.body}</p>
            </article>
          ))}
        </div>
        {page.caveat && <p class="caveat">{page.caveat}</p>}
      </div>
    </section>

    <section class="section faq">
      <div class="wrap narrow">
        <h2 class="section-title">Questions</h2>
        {page.faq.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </section>

    {posts.length > 0 && (
      <section class="section related">
        <div class="wrap">
          <h2 class="section-title">From the blog</h2>
          <div class="links">
            {posts.map((p) => (
              <a href={postPath(p)}><strong>Article</strong><span>{p.data.title}</span></a>
            ))}
          </div>
        </div>
      </section>
    )}

    {related.length > 0 && (
      <section class="section related">
        <div class="wrap">
          <h2 class="section-title">{page.relatedTitle ?? "Also in MedBrains"}</h2>
          <div class="links">
            {related.map((r) => (
              <a href={`/${r.slug}`}><strong>{r.eyebrow}</strong><span>{r.h1}</span></a>
            ))}
          </div>
        </div>
      </section>
    )}
  </main>
  <Footer />
  <WhatsAppFloat />
</Base>

<style lang="scss">
  @use "../styles/mixins" as *;

  .hero {
    color: #fff; padding: 72px 0 88px;
    background: radial-gradient(900px 500px at 80% -20%, rgb(15 98 254 / 35%), transparent 60%), var(--night);
    .eyebrow { color: var(--pulse); }
    h1 { font: 900 clamp(2.2rem, 5vw, 4rem) var(--display); letter-spacing: -.035em; line-height: 1.02; margin: 0 0 20px; max-width: 20ch; }
    .lede { color: var(--night-text); font-size: 1.15rem; max-width: 60ch; margin: 0 0 32px; }
  }
  .crumbs {
    margin-bottom: 28px; font-size: .88rem; color: var(--night-text);
    a { color: #fff; }
  }
  .grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; margin-top: 40px; }
  .feature {
    padding: 28px; border: 1px solid var(--line); border-radius: 18px; background: #fff; color: var(--ink); box-shadow: var(--shadow);
    h3 { font: 800 1.2rem var(--display); letter-spacing: -.02em; margin: 0 0 8px; }
    p { margin: 0; color: var(--ink-2); }
  }
  .faq, .tinted { background: var(--paper-2); color: var(--ink); }
  .prose {
    p { color: var(--night-text); font-size: 1.08rem; max-width: 68ch; }
    &.tinted p { color: var(--ink-2); }
    :global(a) { color: var(--sky); text-underline-offset: 3px; }
    &.tinted :global(a) { color: var(--blue-deep); }
    :global(strong) { font-weight: 600; }
  }
  .steps {
    list-style: none; counter-reset: step; padding: 0; margin: 32px 0 0; display: grid; gap: 14px;
    li {
      counter-increment: step; position: relative; padding: 22px 24px 22px 76px;
      border: 1px solid var(--line); border-radius: 18px; background: #fff; color: var(--ink);
    }
    li::before {
      content: counter(step); position: absolute; left: 22px; top: 22px; width: 36px; height: 36px;
      display: grid; place-items: center; border-radius: 50%; background: var(--purple); color: #fff;
      font: 700 .95rem var(--mono);
    }
    h3 { font: 800 1.12rem var(--display); letter-spacing: -.02em; margin: 0 0 6px; }
    p { margin: 0; color: var(--ink-2); font-size: 1rem; }
    :global(a) { color: var(--blue-deep); }
  }
  .table-scroll { overflow-x: auto; margin: 28px 0; border: 1px solid var(--line); border-radius: 18px; background: #fff; }
  table { width: 100%; border-collapse: collapse; color: var(--ink); font-size: .96rem; min-width: 640px; }
  caption { text-align: left; padding: 18px 20px 4px; font: 600 .74rem var(--mono); letter-spacing: .12em; text-transform: uppercase; color: var(--ink-2); }
  th, td { text-align: left; vertical-align: top; padding: 14px 20px; border-top: 1px solid var(--line); }
  thead th { font-weight: 700; background: var(--paper-2); }
  tbody th { font-weight: 600; }
  .caveat { margin: 28px 0 0; max-width: 72ch; color: var(--night-text); font-size: .98rem; }
  .narrow { max-width: 860px; }
  details { border-bottom: 1px solid var(--line); }
  summary { cursor: pointer; padding: 20px 0; font-weight: 700; font-size: 1.08rem; }
  details p { margin: 0 0 20px; color: var(--ink-2); }
  .links {
    display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; margin-top: 32px;
    a { display: grid; gap: 6px; padding: 22px; border-radius: 16px; border: 1px solid var(--line); text-decoration: none; transition: border-color .2s ease; }
    a:hover { border-color: var(--blue); }
    strong { font: 600 .74rem var(--mono); letter-spacing: .12em; text-transform: uppercase; color: var(--sky); }
    span { font-weight: 600; }
  }
  @include below(lg) { .grid, .links { grid-template-columns: 1fr 1fr; } }
  @include below(sm) { .grid, .links { grid-template-columns: 1fr; } }
</style>
