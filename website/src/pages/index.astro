---
import Apps from "../components/Apps.astro";
import Demo from "../components/Demo.astro";
import Faq from "../components/Faq.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Intelligence from "../components/Intelligence.astro";
import Mission from "../components/Mission.astro";
import Proof from "../components/Proof.astro";
import Rail from "../components/Rail.astro";
import Statement from "../components/Statement.astro";
import Story from "../components/Story.astro";
import Trust from "../components/Trust.astro";
import WhatsAppFloat from "../components/WhatsAppFloat.astro";
import { SAME_AS, SITE, WHATSAPP } from "../consts";
import { FAQ, MODULE_GROUPS } from "../data/content";
import Base from "../layouts/Base.astro";

const home = new URL("/", Astro.site).href;
const org = { "@id": `${home}#org` };
const schema = [
  {
    "@type": "Organization",
    ...org,
    name: SITE.brand,
    url: home,
    logo: new URL("/apple-touch-icon.png", Astro.site).href,
    email: SITE.email,
    address: { "@type": "PostalAddress", addressLocality: "Karaikudi", addressRegion: "Tamil Nadu", addressCountry: "IN" },
    contactPoint: { "@type": "ContactPoint", telephone: `+${WHATSAPP.number}`, contactType: "sales", availableLanguage: ["en", "ta"] },
    sameAs: SAME_AS,
  },
  { "@type": "WebSite", "@id": `${home}#site`, name: SITE.brand, url: home, inLanguage: "en-IN", publisher: org },
  {
    "@type": "SoftwareApplication",
    name: `${SITE.brand} hospital management system`,
    applicationCategory: "BusinessApplication",
    applicationSubCategory: "Hospital management software",
    operatingSystem: "Web, iOS, Android",
    url: home,
    description: "OPD, IPD, lab, pharmacy, billing and native staff and patient apps for hospitals and clinics.",
    featureList: MODULE_GROUPS.flatMap((g) => g.items),
    provider: org,
  },
  {
    "@type": "FAQPage",
    mainEntity: FAQ.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
  },
];
---

<Base
  title={`Free Hospital Management Software: HMS & HIMS | ${SITE.brand}`}
  description="Free, open-source hospital management software: OPD, IPD, lab, pharmacy, GST billing and patient apps on one record. An NABH-aligned HMS built for ABDM."
  schema={schema}
>
  <Header />
  <main id="main">
    <Hero />
    <Proof />
    <Mission />
    <Statement text="One patient. One record. Every department. Nothing typed twice." accent={["record.", "twice."]} />
    <Story />
    <Rail />
    <Intelligence />
    <Apps />
    <Trust />
    <Faq />
    <Demo />
  </main>
  <Footer />
  <WhatsAppFloat />
</Base>
