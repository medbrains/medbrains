---
// Goes to /blog/search, which runs the Pagefind index. A plain GET form, so
// it still lands on the results page with JavaScript off.
import Icon from "./Icon.astro";

interface Props {
  id: string;
  size?: "sm" | "lg";
  value?: string;
}
const { id, size = "sm", value = "" } = Astro.props;
---

<form class:list={["search", size]} action="/blog/search" method="get" role="search">
  <label class="sr-only" for={id}>Search the blog</label>
  <Icon name="search" size={size === "lg" ? 22 : 18} class="glass" />
  <input id={id} name="q" type="search" value={value} placeholder="Search articles, e.g. heat stroke" autocomplete="off" />
  <button type="submit" class:list={[{ "sr-only": size === "sm" }]}>Search</button>
</form>

<style>
  .search {
    position: relative; display: flex; align-items: center; gap: 8px; width: 100%;
    background: var(--paper); border: 1.5px solid var(--line); border-radius: 999px;
    transition: border-color .18s ease, box-shadow .18s ease;
  }
  .search:focus-within { border-color: var(--blue); box-shadow: 0 0 0 4px var(--blue-tint); }
  .search :global(.glass) { position: absolute; left: 16px; color: var(--muted); pointer-events: none; }
  input {
    flex: 1; min-width: 0; min-height: 44px; padding: 0 12px 0 44px; border: 0; background: transparent;
    font: inherit; font-size: .95rem; color: var(--ink); border-radius: 999px;
  }
  input:focus { outline: none; }
  input::placeholder { color: var(--muted); }
  .lg { box-shadow: var(--shadow-soft); padding: 6px; }
  .lg input { min-height: 52px; padding-left: 48px; font-size: 1.05rem; }
  .lg :global(.glass) { left: 22px; }
  button {
    min-height: 48px; padding: 0 22px; border: 0; border-radius: 999px; cursor: pointer;
    background: var(--blue); color: #fff; font: 600 .98rem var(--sans);
  }
  button:hover { background: var(--blue-deep); }
</style>
