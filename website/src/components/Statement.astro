---
// A sentence that lights up word by word as the reader scrolls through it.
interface Props { text: string; accent?: string[] }
const { text, accent = [] } = Astro.props;
const words = text.split(" ");
---

<section class="statement" data-scroll="pin" style={`--n: ${words.length}`} aria-label={text}>
  <div class="sticky">
    <p class="wrap" aria-hidden="true">
      {words.map((w, i) => <span class={accent.includes(w) ? "w accent" : "w"} style={`--i: ${i}`}>{w} </span>)}
    </p>
  </div>
</section>

<style lang="scss">
  @use "../styles/mixins" as *;

  .statement { height: 220vh; background: var(--night); color: #fff; }
  .sticky { position: sticky; top: 0; height: 100vh; display: grid; place-items: center; }
  p {
    margin: 0; text-align: center; font: 900 clamp(2.2rem, 6.4vw, 5.6rem) var(--display);
    letter-spacing: -.035em; line-height: 1.04; max-width: 15ch;
  }
  .w { opacity: clamp(.12, calc(var(--p, 0) * (var(--n) + 3) - var(--i)), 1); transition: opacity .1s linear; }
  .accent { color: var(--pulse); }
  :global(.still) .w { opacity: 1; }
</style>
