---
import { DEPARTMENTS, STATS } from "../data/content";
---

<section class="proof" aria-label="At a glance">
  <div class="ticker" aria-hidden="true">
    <div class="track">
      {[...DEPARTMENTS, ...DEPARTMENTS].map((d) => <span>{d}</span>)}
    </div>
  </div>
  <p class="sr-only">Departments covered: {DEPARTMENTS.join(", ")}.</p>
  <div class="wrap stats">
    {STATS.map((s) => (
      <div class="stat reveal">
        <strong data-count={s.count} data-suffix={s.suffix}>{s.value}</strong>
        <span>{s.label}</span>
      </div>
    ))}
  </div>
</section>

<style lang="scss">
  @use "../styles/mixins" as *;

  .proof { background: var(--night); color: #fff; padding: 56px 0 80px; border-top: 1px solid var(--night-line); }
  .ticker { overflow: hidden; mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent); }
  .track { display: flex; gap: 12px; width: max-content; animation: slide 70s linear infinite; }
  .ticker:hover .track { animation-play-state: paused; }
  .track span {
    padding: 10px 18px; border: 1px solid var(--night-line); border-radius: 999px;
    font: 500 .9rem var(--sans); color: var(--night-text); white-space: nowrap; background: var(--night-2);
  }
  @keyframes slide { to { transform: translateX(-50%); } }
  .stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px; margin-top: 64px; }
  .stat { border-top: 1px solid var(--night-line); padding-top: 20px; }
  .stat strong {
    display: block; font: 900 clamp(2.4rem, 5vw, 3.8rem) var(--display); letter-spacing: -.04em;
    background: linear-gradient(180deg, #fff, #9fb7e0); -webkit-background-clip: text; background-clip: text; color: transparent;
  }
  .stat span { color: var(--night-text); }
  @include below(md) { .stats { grid-template-columns: 1fr 1fr; } }
</style>
