---
import { FORMSPREE_ID, SITE, WHATSAPP } from "../consts";

const waBase = `https://wa.me/${WHATSAPP.number}`;
const waHref = `${waBase}?text=${encodeURIComponent(WHATSAPP.prefilledText)}`;
const action = FORMSPREE_ID ? `https://formspree.io/f/${FORMSPREE_ID}` : waBase;
---

<section id="demo" class="section demo" aria-labelledby="demo-title">
  <div class="wrap layout">
    <div>
      <p class="eyebrow">Book a demo</p>
      <h2 id="demo-title" class="section-title">See it run on your departments.</h2>
      <p class="section-lede">Tell us about your hospital. We'll walk through the screens your teams would use — with your workflows, not a slideshow.</p>
      <ul class="points">
        <li>A 30-minute walkthrough, online or at your hospital</li>
        <li>Your departments, your tariff, your forms</li>
        <li>A clear plan and price for going live</li>
      </ul>
      <p class="alt">Rather talk now? <a href={waHref} target="_blank" rel="noopener">WhatsApp us</a> or write to <a href={`mailto:${SITE.email}`}>{SITE.email}</a>.</p>
    </div>
    <form class="form reveal" action={action} method="POST" data-whatsapp={FORMSPREE_ID ? undefined : waBase}>
      <label>Your name<input name="name" required autocomplete="name" /></label>
      <label>Hospital or clinic<input name="hospital" required autocomplete="organization" /></label>
      <div class="two">
        <label>Phone<input name="phone" type="tel" required autocomplete="tel" inputmode="tel" /></label>
        <label>City<input name="city" autocomplete="address-level2" /></label>
      </div>
      <label>Beds
        <select name="beds">
          <option>Clinic (no beds)</option>
          <option>Up to 50 beds</option>
          <option>50–200 beds</option>
          <option>200+ beds</option>
          <option>Group of hospitals</option>
        </select>
      </label>
      <label>What would you like to see?<textarea name="message" rows="3"></textarea></label>
      <button class="btn btn-primary" type="submit">Request a demo <span aria-hidden="true">→</span></button>
      <p class="fine">We reply within one working day. We never share your details.</p>
    </form>
  </div>
</section>

<script>
  // Without a form service configured, the request goes out on WhatsApp.
  const form = document.querySelector<HTMLFormElement>(".demo form[data-whatsapp]");
  form?.addEventListener("submit", (e) => {
    e.preventDefault();
    const data = new FormData(form);
    const line = (k: string, label: string) => (data.get(k) ? `${label}: ${data.get(k)}` : "");
    const text = ["Hi MedBrains, I'd like a demo.", line("name", "Name"), line("hospital", "Hospital"),
      line("phone", "Phone"), line("city", "City"), line("beds", "Size"), line("message", "Interested in")]
      .filter(Boolean).join("\n");
    window.open(`${form.dataset.whatsapp}?text=${encodeURIComponent(text)}`, "_blank", "noopener");
  });
</script>

<style lang="scss">
  @use "../styles/mixins" as *;

  .demo {
    background: radial-gradient(800px 500px at 90% 20%, var(--glow-blue), transparent 65%),
      radial-gradient(600px 420px at 0% 90%, var(--glow-green), transparent 65%), var(--night-2);
  }
  .layout { display: grid; grid-template-columns: 1fr 1fr; gap: 72px; align-items: start; }
  .points { list-style: none; padding: 0; margin: 32px 0; display: grid; gap: 12px; }
  .points li { padding-left: 32px; position: relative; font-weight: 500; }
  .points li::before { content: "✓"; position: absolute; left: 0; width: 22px; height: 22px; border-radius: 50%; display: grid; place-items: center; font-size: .7rem; background: var(--blue); color: #fff; }
  .alt { color: var(--night-text); }
  .alt a { color: var(--sky); font-weight: 600; }
  .form { color: var(--ink); background: #fff; border: 1px solid var(--line); border-radius: 20px; padding: 32px; display: grid; gap: 16px; box-shadow: var(--shadow); }
  .two { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  label { display: grid; gap: 6px; font-weight: 600; font-size: .9rem; }
  input, select, textarea {
    font: 400 1rem var(--sans); color: var(--ink); min-height: 48px; padding: 10px 14px;
    border: 1.5px solid var(--line); border-radius: 10px; background: #fff;
  }
  input:focus-visible, select:focus-visible, textarea:focus-visible { outline: 3px solid var(--blue-tint); border-color: var(--blue); outline-offset: 0; }
  .form .btn { justify-content: center; margin-top: 4px; }
  .fine { margin: 0; font-size: .82rem; color: var(--muted); text-align: center; }
  @include below(lg) { .layout { grid-template-columns: 1fr; gap: 48px; } }
  @include below(sm) { .two { grid-template-columns: 1fr; } .form { padding: 24px; } }
</style>
