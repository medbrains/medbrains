---
// A landing page for one regulation or scheme a hospital is asking about:
// the promise, the verified facts (numbered to their sources), what MedBrains
// does about it, questions, and the demo form.
import { SITE } from "../consts";
import type { Guide } from "../data/guides";
import Base from "../layouts/Base.astro";
import Demo from "./Demo.astro";
import Footer from "./Footer.astro";
import Header from "./Header.astro";
import WhatsAppFloat from "./WhatsAppFloat.astro";

interface Props {
  guide: Guide;
}
const { guide } = Astro.props;
const home = new URL("/", Astro.site).href;
const url = new URL(`/${guide.slug}`, Astro.site).href;
const schema = [
  {
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: SITE.brand, item: home },
      { "@type": "ListItem", position: 2, name: guide.eyebrow, item: url },
    ],
  },
  {
    "@type": "WebPage",
    name: guide.h1,
    url,
    description: guide.description,
    inLanguage: "en-IN",
    citation: guide.sources.map((s) => ({ "@type": "CreativeWork", name: s.title, url: s.url })),
  },
  {
    "@type": "FAQPage",
    mainEntity: guide.faq.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
  },
];
---

<Base title={guide.title} description={guide.description} schema={schema}>
  <Header />
  <main id="main">
    <section class="hero">
      <div class="wrap">
        <nav class="crumbs-dark" aria-label="Breadcrumb"><a href="/">{SITE.brand}</a> / <span>{guide.eyebrow}</span></nav>
        <p class="eyebrow">{guide.eyebrow}</p>
        <h1>{guide.h1}</h1>
        <p class="lede">{guide.intro}</p>
        <div class="actions">
          <a class="btn btn-primary" href="#demo">Book a demo <span aria-hidden="true">→</span></a>
          {guide.resource && <a class="btn btn-ghost" href={guide.resource.page}>{guide.resource.title}</a>}
        </div>
      </div>
    </section>

    <div class="paper">
      <section class="section" aria-labelledby="problem-title">
        <div class="wrap narrow">
          {guide.notice && <p class="notice">{guide.notice}</p>}
          <h2 id="problem-title" class="title">{guide.problemTitle}</h2>
          <ul class="facts">
            {guide.facts.map((f) => (
              <li>
                {f.text}{" "}
                {f.sources.map((n) => <a class="cite" href={`#source-${n}`} aria-label={`Source ${n}`}>[{n}]</a>)}
              </li>
            ))}
          </ul>
        </div>
      </section>

      <section class="section tinted" aria-labelledby="does-title">
        <div class="wrap">
          <h2 id="does-title" class="title">What {SITE.brand} does about it</h2>
          <div class="grid">
            {guide.does.map((d) => (
              <article class="feature">
                <h3>{d.title}</h3>
                <p>{d.body}</p>
              </article>
            ))}
          </div>
          {guide.caveat && <p class="caveat">{guide.caveat}</p>}
        </div>
      </section>

      {guide.resource && (
        <section class="section" aria-labelledby="resource-title">
          <div class="wrap narrow">
            <div class="resource">
              <div>
                <p class="eyebrow">Free download · no sign-up</p>
                <h2 id="resource-title">{guide.resource.title}</h2>
                <p>{guide.resource.body}</p>
              </div>
              <div class="resource-actions">
                <a class="btn btn-primary" href={guide.resource.pdf} download>Download PDF <span aria-hidden="true">↓</span></a>
                <a class="btn btn-ghost" href={guide.resource.page}>Open the printable page</a>
              </div>
            </div>
          </div>
        </section>
      )}

      <section class="section tinted" aria-labelledby="faq-title">
        <div class="wrap narrow">
          <h2 id="faq-title" class="title">Questions</h2>
          {guide.faq.map((f) => (
            <details>
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>
      </section>

      <section class="section sources" aria-labelledby="sources-title">
        <div class="wrap narrow">
          <h2 id="sources-title">Sources</h2>
          <ol>
            {guide.sources.map((s, i) => (
              <li id={`source-${i + 1}`}>
                <a href={s.url} target="_blank" rel="noopener">{s.title}</a>
                <span class="host">{new URL(s.url).hostname.replace(/^www\./, "")}</span>
              </li>
            ))}
          </ol>
          <p class="checked">Checked {guide.checked}. Rules change — check the source before you act on any figure here.</p>
        </div>
      </section>
    </div>

    <Demo source={guide.slug} />
  </main>
  <Footer />
  <WhatsAppFloat />
</Base>

<style lang="scss">
  @use "../styles/mixins" as *;

  .hero {
    color: #fff; padding: 72px 0 88px;
    background: radial-gradient(900px 500px at 80% -20%, rgb(15 98 254 / 35%), transparent 60%), var(--night);
    .eyebrow { color: var(--pulse); }
    h1 { font: 900 clamp(2.1rem, 5vw, 3.8rem) var(--display); letter-spacing: -.035em; line-height: 1.04; margin: 0 0 20px; max-width: 20ch; }
    .lede { color: var(--night-text); font-size: 1.15rem; max-width: 60ch; margin: 0 0 32px; }
  }
  .crumbs-dark {
    margin-bottom: 28px; font-size: .88rem; color: var(--night-text);
    a { color: #fff; }
  }
  .actions { display: flex; flex-wrap: wrap; gap: 12px; }
  .hero .btn-ghost { color: #fff; }

  .paper { background: var(--paper); color: var(--ink); }
  .paper .section { padding: 80px 0; }
  .tinted { background: var(--paper-2); }
  /* Left-aligned with the full-width sections, but a readable line length. */
  .narrow > * { max-width: 860px; }
  .title { font: 800 clamp(1.7rem, 3.4vw, 2.4rem)/1.1 var(--display); letter-spacing: -.025em; margin: 0 0 28px; max-width: 24ch; }
  .notice {
    margin: 0 0 32px; padding: 14px 18px; border-radius: var(--radius); border: 1px solid var(--line);
    background: var(--paper-2); color: var(--ink-2); font-size: .95rem;
  }

  .facts {
    margin: 0; padding: 0; list-style: none; display: grid; gap: 16px;
    li { padding: 18px 20px 18px 24px; border-left: 4px solid var(--blue); background: var(--paper-2); border-radius: 0 var(--radius) var(--radius) 0; color: var(--ink-2); font-size: 1.05rem; }
  }
  .cite { color: var(--blue-deep); font: 600 .85rem var(--mono); text-decoration: none; padding: 2px; }
  .cite:hover { text-decoration: underline; }

  .grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }
  .feature {
    padding: 26px; border: 1px solid var(--line); border-radius: 18px; background: #fff; box-shadow: var(--shadow-soft);
    h3 { font: 800 1.12rem var(--display); letter-spacing: -.02em; margin: 0 0 8px; }
    p { margin: 0; color: var(--ink-2); }
  }
  .caveat { margin: 24px 0 0; color: var(--muted); font-size: .95rem; max-width: 80ch; }

  .resource {
    display: grid; gap: 20px; padding: 28px; border-radius: var(--radius-lg); background: var(--blue-tint);
    .eyebrow { color: var(--blue-deep); }
    h2 { font: 800 1.5rem/1.2 var(--display); letter-spacing: -.02em; margin: 0 0 8px; }
    p { margin: 0; color: var(--ink-2); }
  }
  .resource-actions { display: flex; flex-wrap: wrap; gap: 12px; }
  .resource .btn-primary { color: #fff; }
  .resource .btn-ghost { color: var(--ink); }

  details { border-bottom: 1px solid var(--line); }
  summary { cursor: pointer; padding: 20px 0; font-weight: 700; font-size: 1.08rem; }
  details p { margin: 0 0 20px; color: var(--ink-2); }

  .sources {
    h2 { margin: 0 0 12px; font: 600 .74rem var(--mono); letter-spacing: .14em; text-transform: uppercase; color: var(--muted); }
    ol { margin: 0; padding-left: 1.6em; color: var(--ink-2); font-size: .98rem; }
    li { margin-bottom: 8px; scroll-margin-top: 96px; }
    li:target { background: var(--blue-tint); }
    a { color: var(--blue-deep); overflow-wrap: anywhere; }
    .host { margin-left: 6px; color: var(--muted); font-size: .86rem; }
    .checked { margin: 20px 0 0; color: var(--muted); font-size: .9rem; }
  }

  @include below(lg) { .grid { grid-template-columns: 1fr 1fr; } }
  @include below(sm) {
    .grid { grid-template-columns: 1fr; }
    .paper .section { padding: 56px 0; }
    .resource { padding: 22px; }
  }
</style>
