---
import { SITE } from "../consts";

interface Props {
  /** White bar for light pages (the blog). */
  light?: boolean;
}
const { light = false } = Astro.props;
---

<header class:list={["header", { light }]}>
  <div class="wrap bar">
    <a class="brand" href="/" aria-label={`${SITE.brand} home`}>
      <img src="/logo/medbrains-mark.svg" alt="" width="32" height="32" />
      <span>{SITE.brand}</span>
    </a>
    <nav aria-label="Main">
      <a href="/#journey">How it works</a>
      <a href="/#modules">Modules</a>
      <a href="/#apps">Apps</a>
      <a href="/#trust">Compliance</a>
      <a href="/#faq">FAQ</a>
      <a href="/blog">Blog</a>
    </nav>
    <a class="signin" href={SITE.signIn}>Sign in</a>
    <a class="btn btn-primary cta" href="/#demo">Book a demo</a>
  </div>
</header>

<style lang="scss">
  @use "../styles/mixins" as *;

  .header {
    position: sticky; top: 0; z-index: 50;
    background: rgb(10 22 48 / 88%); backdrop-filter: saturate(160%) blur(14px);
    border-bottom: 1px solid rgb(255 255 255 / 8%); color: #fff;
  }
  .bar { display: flex; align-items: center; gap: 32px; height: 68px; }
  .brand {
    display: inline-flex; align-items: center; gap: 10px; text-decoration: none;
    font-family: var(--display); font-weight: 900; font-size: 1.2rem; letter-spacing: -.02em;
  }
  nav { display: flex; gap: 28px; margin-left: auto; font-size: .94rem; }
  nav a { text-decoration: none; color: var(--night-text); }
  nav a:hover { color: #fff; }
  .signin { color: #fff; text-decoration: none; font-size: .94rem; font-weight: 600; }
  .signin:hover { color: var(--pulse); }
  .cta { min-height: 40px; padding: 0 18px; font-size: .9rem; box-shadow: none; }
  .light {
    background: rgb(255 255 255 / 90%); color: var(--ink); border-bottom-color: var(--line);
    nav a { color: var(--ink-2); }
    nav a:hover, .signin { color: var(--ink); }
    .signin:hover { color: var(--blue-deep); }
  }
  .signin, .cta { white-space: nowrap; }
  @include below(sm) { .bar { gap: 16px; } }
  @include below(lg) {
    nav { display: none; }
    .signin { margin-left: auto; }
  }
</style>
