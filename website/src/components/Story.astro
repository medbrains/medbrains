---
import { JOURNEY } from "../data/content";
import StoryScreens from "./StoryScreens.astro";
---

<section id="journey" class="story" data-scroll="pin" data-steps={JOURNEY.length} data-active="0" aria-labelledby="story-title">
  <div class="sticky">
    <div class="wrap layout">
      <div class="copy">
        <p class="eyebrow">How it works · one patient's day</p>
        <h2 id="story-title" class="sr-only">One patient's day, step by step</h2>
        <ol class="steps">
          {JOURNEY.map((j, i) => (
            <li class="step" data-i={i}>
              <p class="meta"><span class="n">{String(i + 1).padStart(2, "0")}</span>{j.step}<span class="tag">{j.tag}</span></p>
              <h3>{j.title}</h3>
              <p class="body">{j.body}</p>
            </li>
          ))}
        </ol>
        <div class="bar" aria-hidden="true"><span></span></div>
      </div>
      <div class="device" aria-hidden="true">
        <div class="chrome"><i></i><i></i><i></i><p>app.medbrains.in</p></div>
        <div class="screens"><StoryScreens /></div>
      </div>
    </div>
  </div>
</section>

<style lang="scss">
  @use "../styles/mixins" as *;

  .story { height: 760vh; background: radial-gradient(900px 600px at 80% 30%, var(--glow-blue), transparent 65%), linear-gradient(180deg, var(--night) 0%, var(--night-2) 100%); color: #fff; }
  .sticky { position: sticky; top: 0; height: 100vh; display: grid; align-items: center; overflow: hidden; }
  .layout { display: grid; grid-template-columns: .9fr 1.3fr; gap: 64px; align-items: center; width: 100%; }
  .copy { position: relative; }
  .eyebrow { display: inline-block; color: #fff; background: var(--purple); padding: .35em .75em; border-radius: 999px; }
  .steps { list-style: none; margin: 0; padding: 0; display: grid; min-height: 290px; }
  .step {
    grid-area: 1 / 1; opacity: 0; transform: translateY(24px);
    transition: opacity .45s ease, transform .55s cubic-bezier(.2, .7, .2, 1); pointer-events: none;
  }
  .meta { display: flex; gap: 12px; align-items: center; margin: 0 0 14px; font: 600 .78rem var(--mono); letter-spacing: .12em; text-transform: uppercase; color: var(--night-text); }
  .n { color: #fff; background: var(--purple); padding: 2px 8px; border-radius: 6px; }
  .tag { margin-left: auto; padding: 4px 10px; border-radius: 999px; border: 1px solid var(--night-line); letter-spacing: .04em; }
  h3 { margin: 0 0 16px; font: 900 clamp(2rem, 3.6vw, 3.2rem) var(--display); letter-spacing: -.035em; line-height: 1.02; }
  .body { margin: 0; font-size: 1.12rem; color: var(--night-text); max-width: 44ch; }
  .bar { margin-top: 36px; height: 4px; background: var(--night-line); border-radius: 3px; overflow: hidden; }
  .bar span { display: block; height: 100%; width: calc(var(--p, 0) * 100%); background: linear-gradient(90deg, var(--blue), var(--purple)); }
  .device {
    border-radius: 18px; overflow: hidden; background: #fff; border: 1px solid rgb(255 255 255 / 15%);
    box-shadow: 0 50px 140px rgb(15 98 254 / 35%), 0 0 0 10px rgb(255 255 255 / 4%);
    transform: perspective(1800px) rotateY(calc(-10deg + var(--p, 0) * 10deg));
  }
  .chrome { display: flex; gap: 7px; align-items: center; padding: 12px 16px; background: #eef1f6; border-bottom: 1px solid var(--line); }
  .chrome i { width: 11px; height: 11px; border-radius: 50%; background: #d3d9e3; }
  .chrome p { margin: 0 auto; font: 500 .74rem var(--mono); color: var(--muted); }
  .screens { position: relative; height: 440px; }
  .story[data-active="0"] .step[data-i="0"], .story[data-active="1"] .step[data-i="1"],
  .story[data-active="2"] .step[data-i="2"], .story[data-active="3"] .step[data-i="3"],
  .story[data-active="4"] .step[data-i="4"], .story[data-active="5"] .step[data-i="5"],
  .story[data-active="6"] .step[data-i="6"] { opacity: 1; transform: none; pointer-events: auto; }

  /* Reduced motion: the steps read as a list, the screen shows the first. */
  :global(.still) .story { height: auto; padding: 96px 0; }
  :global(.still) .story .sticky { position: static; height: auto; }
  :global(.still) .story .steps { gap: 40px; }
  :global(.still) .story .step { grid-area: auto; opacity: 1; transform: none; }

  @include below(lg) {
    .layout { grid-template-columns: 1fr; gap: 28px; }
    .steps { min-height: 230px; }
    .screens { height: 360px; }
    .device { transform: none; }
    h3 { font-size: 1.8rem; }
    .body { font-size: 1rem; }
  }
</style>
