// React Native bridge — UniFFI Interface Definition Language.
//
// Generates Kotlin (Android), Swift (iOS), and TypeScript (RN) bindings
// for:
//   - Loro CRDT operations (DocHandle) — mirrors web hooks
//   - JWT verification (verify_jwt) — offline auth
//   - ReBAC permission checks (AuthzCacheHandle) — offline permissions
//   - JWT revocation cache (RevocationCacheHandle) — denial list
//
// The same wire format runs on web (via wasm), edge (server), and
// mobile/TV (UniFFI). One protocol, multiple transports.

namespace edge_rn {
    /// Verify an Ed25519-signed JWT. The host hands the public key
    /// and current time; we do signature + expiry only. Revocation
    /// is a separate check via `RevocationCacheHandle::is_revoked`.
    JwtOutcome verify_jwt(string token, sequence<u8> public_key_bytes, i64 now_unix, u64 clock_skew_secs);

    /// True if the given (object_type, action) pair is on the
    /// online-required denylist. Hosts call this before queuing a
    /// write so they can show the right error UX before hitting
    /// the AuthzCache.
    boolean is_action_offline_required(string object_type, string action);

    /// Create this device's peer-to-peer sync identity.
    ///
    /// Called once, the first time a device is set up for sync. The
    /// caller MUST put `secret_hex` in platform secure storage —
    /// Keychain on iOS, Keystore on Android — and never in
    /// AsyncStorage or a log: anyone holding it can be this device.
    ///
    /// `node_id` is the public half and is meant to be shown. An
    /// administrator reads it off the screen and binds it to this
    /// device in Admin → Paired devices, which is what admits the
    /// device to sync.
    [Throws=BridgeError]
    NodeIdentity generate_node_identity();

    /// Recover the node id from a stored secret, on later launches.
    [Throws=BridgeError]
    string node_id_for_secret(string secret_hex);

    // ── Bedside decisions (medbrains-clinical-core) ───────────────
    // The rules the server enforces, answered on the device before the
    // tap so the refusal is explained rather than merely returned.

    /// Who may witness a high-alert dose: everyone on duty except the
    /// nurse giving it.
    sequence<WitnessCandidate> bcma_eligible_witnesses(sequence<WitnessCandidate> on_duty, string actor_id);
    /// Whether "Give now" may be pressed.
    boolean bcma_can_record_given(boolean is_high_alert, string? witness_id);
    /// "Wristband matched. Drug did not match." — both rights, every time.
    string bcma_scan_rights_summary(boolean right_patient, boolean right_drug);

    /// The transfusion chart, phase by phase, with what is overdue.
    sequence<TransfusionPhaseState> transfusion_phase_states(i64? started_unix, boolean ended, sequence<string> recorded_phases, i64 now_unix);
    boolean transfusion_is_running(i64? started_unix, boolean ended);
    boolean transfusion_can_start(string bag_number, string blood_group, string product_type, string expiry_date, boolean consent_on_file, boolean crossmatch_compatible, string? second_nurse_id);

    /// `4m 07s`, clamped at zero.
    string nurse_call_wait_label(i64 waiting_seconds);
    boolean nurse_call_is_open(string status);
    boolean nurse_call_is_overdue(string escalation);

    /// Morse banding: low / moderate / high.
    string fall_risk_morse_level(i64 score);

    /// Which open codes own the flash, code blue first, silenced ones dropped.
    sequence<OpenEmergencyCode> emergency_open_codes(sequence<CodeBlueRef> code_blues, sequence<EmergencyCodeRef> er_codes, sequence<string> silenced_keys);
    /// Feed one tap of the silence gesture.
    TapOutcome emergency_register_tap(sequence<i64> taps_ms, i64 now_ms);

    /// A doctor's clinic, earliest first; indices into the caller's list, timeless last.
    sequence<u32> clinic_order(sequence<string?> start_times);
    /// The earliest still-open appointment, as an index, or none when the clinic is finished.
    u32? clinic_next_patient(sequence<string?> start_times, sequence<string> statuses);
    u32 clinic_remaining_count(sequence<string> statuses);
    boolean clinic_is_still_to_come(string status);
    /// The message that stops a consultation note being saved, or none.
    string? consultation_problem(string chief_complaint, string examination, string assessment, string plan);
    /// After the duplicate-patient check: "confirm" | "proceed" | "proceed_unverified".
    string registration_action(boolean check_unavailable, u32 matches);
    /// Whether a registration field is desk context kept for the next walk-in.
    boolean registration_carries_over(string field);
    /// The first field that stops a registration, or none.
    RegistrationProblem? registration_problem(RegistrationDraft draft);
    /// 1 January of the birth year, for someone who only knows their age.
    string estimated_date_of_birth(u32 age_years, i32 today_year);
    /// What a booking offers the desk: "check_in" and "no_show" on its day while still open, else nothing.
    sequence<string> appointment_actions(string status, boolean is_today);
    /// Whether a slot may be offered: available and not already behind us (ISO date + HH:MM:SS).
    boolean slot_is_bookable(string date, string start_time, string today, string now_time, boolean is_available);
    /// What the desk should call a visitor pass now: "active" | "overdue" | "expired" | "revoked".
    string pass_state(string status, string valid_until, string now);
    /// Whether this pass counts among the people inside the building.
    boolean pass_is_inside(string state, boolean checked_out);
    /// What the desk may do with a pass: "check_in"/"check_out" then "revoke", or nothing.
    sequence<string> pass_actions(string state, boolean inside);

    /// Why the companion is open ("hospital" | "band" | "purchase"), or none: hidden.
    string? companion_access(boolean? licensed_by_hospital, boolean? band_paired, boolean? purchased);
    /// "reporting" | "stale" | "never_synced".
    string band_state(i64? last_synced_unix, i64 now_unix);
    string describe_band_state(string state);
    /// The day's brief from the phone's own record.
    DailyBrief daily_brief(sequence<MedicationPlan> medications, sequence<AdherenceEvent> adherence, sequence<string> observation_days, i64 now_unix);
};

dictionary RegistrationDraft {
    string first_name;
    string last_name;
    string phone;
    string date_of_birth;
    u32? age_years;
    boolean is_medico_legal;
    string mlc_number;
    string abha_number;
};

dictionary RegistrationProblem {
    string field;
    string message;
};

dictionary MedicationPlan {
    string id;
    string name;
    string instructions;
    sequence<string> times;
    string started_on;
    string? ends_on;
};

dictionary AdherenceEvent {
    string plan_id;
    string scheduled_for;
    string status;
};

dictionary DoseSlot {
    string plan_id;
    string name;
    string instructions;
    string time;
    string scheduled_for;
    string status;
};

dictionary DailyBrief {
    sequence<DoseSlot> slots;
    u32? adherence_percent;
    u32 streak_days;
    string confidence;
    string verdict;
};

dictionary WitnessCandidate {
    string nurse_user_id;
    string nurse_name;
    boolean is_charge;
};

dictionary TransfusionPhaseState {
    string phase;
    boolean recorded;
    boolean overdue;
};

dictionary CodeBlueRef {
    string id;
    string location;
};

dictionary EmergencyCodeRef {
    string id;
    string code_type;
    string? location;
};

dictionary OpenEmergencyCode {
    string key;
    string label;
    string code_type;
    string location;
    string? code_blue_id;
};

dictionary TapOutcome {
    sequence<i64> taps_ms;
    boolean triple;
};

/// A device's peer-to-peer sync identity.
dictionary NodeIdentity {
    /// Hex-encoded private key. Secure storage only.
    string secret_hex;
    /// The public node id, exactly as a peer sees it on the wire.
    string node_id;
};

// ── Errors ─────────────────────────────────────────────────────────

[Error]
enum BridgeError {
    "DocNotFound",
    "InvalidUpdate",
    "InvalidVersionVector",
    "Loro",
    "Serde",
    "BadVerifyingKey",
    "AuthzCache",
    "RevocationCache",
    "InvalidUuid",
    "InvalidNodeKey",
};

// ── Loro CRDT bridge ───────────────────────────────────────────────

dictionary AppendItem {
    string json_value;
};

dictionary TextSnapshot {
    string text;
    sequence<u8> version_vector;
};

interface DocHandle {
    [Throws=BridgeError]
    constructor(string doc_id);

    /// Apply a Loro update produced by another peer. Returns the
    /// merged version vector so the caller can ack.
    [Throws=BridgeError]
    sequence<u8> apply_update(sequence<u8> update_bytes);

    /// Export a delta since `their_vv` — what this peer needs to
    /// catch up. Empty result means nothing new.
    [Throws=BridgeError]
    sequence<u8> export_since(sequence<u8> their_vv);

    /// Append-only list operations (matches the web hook surface).
    /// Returns the produced update bytes the caller pushes upstream.
    [Throws=BridgeError]
    sequence<u8> append_to_list(string container_name, AppendItem item);

    [Throws=BridgeError]
    sequence<string> list_entries(string container_name);

    /// Free-form text container.
    [Throws=BridgeError]
    sequence<u8> set_text(string container_name, string new_text);

    [Throws=BridgeError]
    TextSnapshot read_text(string container_name);

    /// Doc id this handle was opened for.
    string doc_id();

    /// Current version vector (for use as `since` in pulls).
    [Throws=BridgeError]
    sequence<u8> version_vector();
};

// ── JWT verification ───────────────────────────────────────────────

dictionary JwtClaims {
    string sub;            // user UUID
    string tenant_id;      // tenant UUID
    i64 iat;               // issued-at, unix seconds
    i64 exp;               // expiry, unix seconds
    sequence<string> department_ids;
    sequence<string> permissions;
    string? role;
};

[Enum]
interface JwtOutcome {
    Valid(JwtClaims claims);
    Expired();
    NotYetValid();
    InvalidSignature();
    Malformed(string reason);
};

// ── AuthzCache (ReBAC decision cache) ──────────────────────────────

dictionary CacheKey {
    string tenant_id;       // UUID
    string user_id;         // UUID
    string object_type;
    string object_id;
    string action;
};

[Enum]
interface CacheSourceKind {
    CloudFresh();
    CloudCached();
    JwtFallback();
    OnlineRequiredDeny();
};

[Enum]
interface DenyReasonKind {
    CacheMissStrict();
    JwtLacksPermission();
    OnlineRequired();
    Expired();
};

[Enum]
interface CheckOutcome {
    Allow(CacheSourceKind source);
    Deny(DenyReasonKind reason);
};

[Enum]
interface OfflinePolicyKind {
    CacheOnly();
    CacheThenJwt();
    OnlineRequired();
};

interface AuthzCacheHandle {
    /// Open / create a cache rooted at `path`. Capacity bounds the
    /// in-memory LRU; sled persistence is unbounded.
    [Throws=BridgeError]
    constructor(string path, u32 capacity, u64 default_ttl_secs);

    /// Pure offline lookup. JWT permissions are passed in case the
    /// policy is `CacheThenJwt` and the cache misses.
    [Throws=BridgeError]
    CheckOutcome check_offline(CacheKey key, sequence<string> jwt_permissions, OfflinePolicyKind policy);

    /// Insert or refresh a cache entry. Hosts call this when the
    /// cloud has just answered, OR when a `CacheInvalidate` frame
    /// arrives over the WSS sync protocol.
    [Throws=BridgeError]
    void record(CacheKey key, boolean allowed, CacheSourceKind source);

    /// Drop entries pushed in `CacheInvalidate` frames.
    [Throws=BridgeError]
    void invalidate(sequence<CacheKey> keys);
};

// ── RevocationCache ────────────────────────────────────────────────

interface RevocationCacheHandle {
    [Throws=BridgeError]
    constructor(string path, u32 capacity);

    /// Record a revocation. Idempotent + monotonic — earlier
    /// timestamps never overwrite later ones.
    [Throws=BridgeError]
    void record_revocation(string user_id, i64 revoked_at_unix);

    /// True iff `user_id` has a revocation entry AND the JWT was
    /// issued before that timestamp.
    [Throws=BridgeError]
    boolean is_revoked(string user_id, i64 jwt_iat_unix);

    /// Largest revoked_at seen so far. Used as the `since` cursor
    /// on the next pull from `/api/auth/revocations`.
    i64 pull_window_max();

    /// Drop a record (admin re-activated the user).
    [Throws=BridgeError]
    void forget(string user_id);

    u32 len();

    boolean is_empty();
};
