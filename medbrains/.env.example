# PostgreSQL
DATABASE_URL=postgres://medbrains:medbrains_dev@localhost:5435/medbrains
DB_POOL_MAX_CONNECTIONS=20
DB_POOL_MIN_CONNECTIONS=2
DB_POOL_ACQUIRE_TIMEOUT_SECS=5
DB_POOL_IDLE_TIMEOUT_SECS=600
DB_POOL_MAX_LIFETIME_SECS=1800
DB_STATEMENT_CACHE_CAPACITY=256
DB_SLOW_QUERY_MS=250

# YottaDB REST API (optional in Phase 1)
# YOTTADB_URL=http://localhost:9080

# Server
HOST=0.0.0.0
PORT=3000
APP_ORIGIN=https://medbrains.localhost
EXPO_PUBLIC_API_BASE=https://medbrains.localhost

# Deployment environment: development (default) | production.
# production refuses to start without JWT keys and disables demo seeding.
# MEDBRAINS_ENV=production

# Initial admin password for first seed. REQUIRED in production
# (dev falls back to admin123). The account is flagged for forced
# password change on first login in production.
# MEDBRAINS_SEED_ADMIN_PASSWORD=<strong-initial-password>

# Outbound email. provider: sendgrid (default) | smtp | ses.
# smtp covers Zoho/Google Workspace/local relay (on-prem friendly).
# EMAIL_PROVIDER=smtp
# EMAIL_FROM_ADDRESS=noreply@hospital.example
# EMAIL_FROM_NAME=MedBrains
# SMTP_HOST=smtp.zoho.in
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_TLS=starttls   # starttls | implicit | none

# Retention enforcement: set true to log what the daily pass WOULD
# purge without deleting anything.
# MEDBRAINS_RETENTION_DRY_RUN=true

# JWT (Ed25519 keys — leave unset for auto-generated dev keypair;
# REQUIRED when MEDBRAINS_ENV=production)
# JWT_PRIVATE_KEY=<base64-encoded-ed25519-private-key>
# JWT_PUBLIC_KEY=<base64-encoded-ed25519-public-key>

# Local cryptographic material
# Use different random 32+ byte values per environment/tenant group.
# SIGNATURE key wraps doctor Ed25519 signing keys at rest.
# EVENT token key encrypts opaque QR/barcode event tokens.
# MEDBRAINS_SIGNATURE_KEY_ENCRYPTION_KEY=<random-32-byte-minimum-secret>
# MEDBRAINS_EVENT_TOKEN_KEY=<random-32-byte-minimum-secret>

# WHO ICD-11 terminology for diagnosis coding.
# Recommended dev/research mode: run the official WHO Docker image with `make icd-up`.
# Backend and browser/debug access go through the local HTTPS proxy.
# WHO_ICD_API_BASE_URL=https://medbrains-icd.localhost
# WHO_ICD_AUTH_MODE=none
# WHO_ICD_RELEASE_ID=2026-01
# ICD_API_PORT=8382
# ICD_API_INCLUDE=2026-01_en
# ICD_API_SAVE_ANALYTICS=false
#
# Cloud fallback mode: register at https://icd.who.int/icdapi and keep credentials
# out of source control. Local proxy mode should stay the default for dev/research installs.
# WHO_ICD_CLIENT_ID=<client-id>
# WHO_ICD_CLIENT_SECRET=<client-secret>
# WHO_ICD_API_BASE_URL=https://id.who.int
# WHO_ICD_AUTH_MODE=oauth
# WHO_ICD_TOKEN_URL=https://icdaccessmanagement.who.int/connect/token

# CORS & Cookies
CORS_ORIGIN=https://medbrains.localhost,https://medbrains-desktop.localhost,https://medbrains-icd.localhost
# COOKIE_DOMAIN=
SECURE_COOKIES=true
TRUSTED_PROXIES=127.0.0.1/32,::1/128

# Logging
RUST_LOG=medbrains_server=debug,tower_http=debug

# ──────────────────────────────────────────────────────────────────
# ReBAC — SpiceDB sidecar (optional; falls back to PgAuthzBackend)
# ──────────────────────────────────────────────────────────────────
SPICEDB_ENDPOINT=http://localhost:50051
SPICEDB_TOKEN=devsecret

# ──────────────────────────────────────────────────────────────────
# SMS — Twilio (production) or stub (dev) when unset
# ──────────────────────────────────────────────────────────────────
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_FROM_NUMBER=+91XXXXXXXXXX
# TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx  # India DLT routing (optional)
# DLT_ENFORCE=true                                                # India: refuse to send if no registered template matches event scope

# ──────────────────────────────────────────────────────────────────
# Email — SendGrid (production) or stub (dev) when unset
# ──────────────────────────────────────────────────────────────────
# EMAIL_PROVIDER=sendgrid                                          # or "ses" (pending SigV4)
# SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# EMAIL_FROM_ADDRESS=hospital@example.com
# EMAIL_FROM_NAME=MedBrains Hospital

# ──────────────────────────────────────────────────────────────────
# WhatsApp — Meta Cloud API
# ──────────────────────────────────────────────────────────────────
# WHATSAPP_PHONE_NUMBER_ID=000000000000000
# WHATSAPP_ACCESS_TOKEN=EAAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ──────────────────────────────────────────────────────────────────
# GitHub issue creation for frontend crash reports (optional)
# ──────────────────────────────────────────────────────────────────
# GITHUB_ISSUES_TOKEN=
# GITHUB_ISSUES_REPO=owner/repo
# GITHUB_ISSUES_LABELS=bug,client-error
# GITHUB_ISSUES_INCLUDE_CLIENT_STACK=false

# ──────────────────────────────────────────────────────────────────
# NHCX (insurance claims gateway, India)
# ──────────────────────────────────────────────────────────────────
# NHCX_BASE_URL=https://apisbx.abdm.gov.in/hcx/v1                  # sandbox
# NHCX_PARTICIPANT_CODE=hospital@nhcx
# NHCX_PRIVATE_KEY_PEM=                                            # multi-line PEM ok with quotes
# NHCX_BEARER_TOKEN=                                               # short-lived from /sessions
# NHCX_RECIPIENT_PUBLIC_KEY=                                       # default payer; per-payer keys via :{code} suffix
# NHCX_SENDER_PUBLIC_KEY:starhealth=                               # one per payer (callback verify)

# ──────────────────────────────────────────────────────────────────
# ABDM (Ayushman Bharat Digital Mission)
# ──────────────────────────────────────────────────────────────────
# ABDM_BASE_URL=https://abhasbx.abdm.gov.in
# ABDM_HIE_GATEWAY_URL=https://dev.abdm.gov.in/gateway/v0.5
# ABDM_BEARER_TOKEN=
# ABDM_HIP_ID=medbrains.hip

# ──────────────────────────────────────────────────────────────────
# S3 — patient document uploads (MLC, MRD, consent forms, etc.)
# Bucket is provisioned by infra/terraform/modules/hospital-package.
# Leave blank for local dev; the /api/upload/presign endpoints return
# 400 Bad Request when S3 is not configured.
# ──────────────────────────────────────────────────────────────────
# S3_BUCKET=medbrains-alagappa-uploads-ap-south-1
# S3_REGION=ap-south-1
# S3_ENDPOINT=                                       # leave blank for AWS; set for MinIO
# S3_ACCESS_KEY_ID=                                  # omit when running on EC2 with instance role
# S3_SECRET_ACCESS_KEY=                              # omit when running on EC2 with instance role

# Notes
# • All credentials are read at request time via the EnvSecretResolver,
#   so rotation = update .env + restart. No per-tenant DB vault needed.
# • Missing credentials → handlers return Ok({stub:true,reason:"creds_unset"})
#   for graceful dev/CI behaviour. Production deploys must set all
#   integrations they actually use.
# • Multi-tenant prod: prefer FileSecretResolver pointing at /etc/medbrains/secrets/
#   or wire a Vault/KMS-backed resolver in main.rs.
