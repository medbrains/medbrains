#!/bin/bash
# Rebuilds cog's Wayland plugin with one fix, because Debian's cog 0.18.4 cannot click: see
# patches/cog-0.18.4-wl-pointer-button.patch. The source is Debian's own tarball, pinned by
# hash. Only the plugin goes into the image. Drop this when Debian ships a fixed cog.
set -euo pipefail

VERSION=0.18.4
SHA256=31d7079db2eeed790899d2f1f824dd6a54bf30d072d196d737be572f105d99b1
TARBALL="cog_${VERSION}.orig.tar.xz"
PLUGIN_DIR="usr/lib/$(gcc -dumpmachine)/cog/modules"

cd "$(mktemp -d)"
curl -fsSL --retry 3 --retry-all-errors -o "$TARBALL" "https://deb.debian.org/debian/pool/main/c/cog/$TARBALL"
echo "$SHA256  $TARBALL" | sha256sum -c -
rm -rf "cog-$VERSION"
tar xf "$TARBALL"
cd "cog-$VERSION"
patch -p1 < "$SRCDIR/patches/cog-$VERSION-wl-pointer-button.patch"
meson setup build --prefix=/usr -Dplatforms=wayland -Dprograms=false >/dev/null
ninja -C build
install -D -m 0644 build/platform/wayland/libcogplatform-wl.so "$DESTDIR/$PLUGIN_DIR/libcogplatform-wl.so"
