#!/bin/sh
# In the boot file's initrd: says why the system did not start, on the console a person sees and in the
# kernel log (OS-VERITY.md).
words="MedBrains could not start its system: the system partition failed its check or could not be read, so nothing was started and patient data stays locked. Call your system administrator: the system must be reinstalled from a MedBrains USB installer."
printf '\n%s\n\n' "$words" > /dev/console
printf '<2>%s\n' "$words" > /dev/kmsg
