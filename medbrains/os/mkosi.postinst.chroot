#!/bin/bash
# Runs inside the image after packages and extra trees are installed.
set -euo pipefail

# PostgreSQL: no cluster in the image (each box gets its own system identifier
# and checksummed cluster at first boot). Its config follows the data onto the
# data partition, so the system partition holds no database state.
pg_dropcluster --stop 17 main 2>/dev/null || true
rm -rf /etc/postgresql /var/lib/postgresql/17
ln -s /var/lib/postgresql/conf /etc/postgresql

# Debian's ssl-cert makes a private key at package install, so every machine from one image would share
# it, in the clear on the system partition. PostgreSQL listens on loopback only and turns TLS off when
# the key is missing.
rm -f /etc/ssl/private/ssl-cert-snakeoil.key /etc/ssl/certs/ssl-cert-snakeoil.pem
# The same for chrony's command key, which nothing here uses: /etc/chrony/chrony.conf names no keyfile.
rm -f /etc/chrony/chrony.keys

# The time zone lives on the data partition, because the root will become read-only.
ln -sfn /var/lib/medbrains-settings/localtime /etc/localtime

# Secrets live on the data partition.
ln -sfn /var/lib/medbrains/config /etc/medbrains

# A firewall file that does not parse would boot a machine with no firewall, so it fails the build.
nft -c -f /etc/nftables.conf
# Nor may a main machine's own rules wait until a hospital's first boot to fail.
# Its rule names the agent's user, which must exist to parse it.
systemd-sysusers
cat /etc/nftables.conf /usr/lib/medbrains/main-machine.nft > /tmp/whole-firewall.nft
nft -c -f /tmp/whole-firewall.nft
rm /tmp/whole-firewall.nft
systemctl enable nftables chrony systemd-networkd systemd-resolved \
    medbrains-disk-setup medbrains-disk-notice medbrains-disk-finish medbrains-network-settings medbrains-os-setup medbrains-main.target medbrains-node.target \
    medbrains-agent medbrains-time-role cage-console medbrains-update-reconcile medbrains-update-health \
    medbrains-update-deadline.timer medbrains-update-look.timer medbrains-update-quiet.timer medbrains-boot-health@tty2
systemctl mask systemd-boot-update.service
# AppArmor's decisions reach the journal through the audit socket. Without it the kernel prints them, rate
# limited, and a burst of denials is lost (seen in the VM as "callbacks suppressed").
systemctl enable systemd-journald-audit.socket
# Nothing here may wait for the network: with a cable out this fails after two minutes, which reads as a
# failed service and would roll back a good update. Masked, because enabling networkd brings it back.
systemctl mask systemd-networkd-wait-online.service
# Only medbrains-main.target starts these, and only once setup has finished, so nothing
# answers on the network before then. Debian's packages enable them by default.
systemctl disable postgresql 2>/dev/null || true
# A udev rule starts iwd when a Wi-Fi card appears, so a wired machine doesn't pay for it.
systemctl disable iwd 2>/dev/null || true
# chrony.service serves the LAN its time. Debian's restricted variant cannot open the port, and
# whichever of the two starts first wins, so the LAN's time was down on some boots. chrony-wait
# would hold the boot for the internet, which setup must never need.
systemctl disable chronyd-restricted chrony-wait 2>/dev/null || true
# Debug images only: build.sh stages this unit nowhere else.
if [[ -e /usr/lib/systemd/system/kanidm-debug-account.service ]]; then systemctl enable kanidm-debug-account; fi
systemctl set-default graphical.target
# No login prompt anywhere (X6, Talos-style): no getty on a screen, a serial port or a container
# console, and no systemd.debug_shell, whatever the kernel command line says. The screen is the only way
# in. A debug image's root shell is its own unit, which none of these masks touches.
systemctl mask getty@.service serial-getty@.service autovt@.service console-getty.service \
    container-getty@.service debug-shell.service
# Root has no password that works, so neither a rescue prompt nor su can open a root shell.
usermod -L root
# Nor has the database's account a shell: services reach it with runuser and setpriv, never a login (CIS 5.4.2.7).
usermod -s /usr/sbin/nologin postgres
# What a login banner would show if one ever appeared: no OS name or version to aim an exploit at (CIS 1.6).
printf 'MedBrains appliance. Authorised use only.\n' | tee /etc/issue /etc/issue.net > /etc/motd
chmod 0644 /etc/issue /etc/issue.net /etc/motd

# No program may raise its privilege through a set-user-ID or set-group-ID bit, except D-Bus's activation
# helper, which the system bus needs. Nobody logs in, so su, passwd, mount and the rest have no one to serve
# (CIS 7.1.13; Kicksecure's permission-hardener). The OS test lists what is left.
find / -xdev -type f -perm /6000 ! -path /usr/lib/dbus-1.0/dbus-daemon-launch-helper -exec chmod ug-s {} +

# Debian's apparmor package ships profiles in complain mode for programs this image does not have. Complain
# mode protects nothing, so they go, and every profile left is enforced (CIS 1.3.1.4).
mapfile -t complain < <(find /etc/apparmor.d -maxdepth 1 -type f -exec grep -l 'flags=([^)]*complain' {} +)
rm -f "${complain[@]}"

# The screen's own fonts, installed by mkosi.build.chroot.
fc-cache -f /usr/share/fonts

# Unused in an appliance; trimmed for size (§3a).
rm -rf /usr/share/doc/* /usr/share/man/* /usr/share/info/* /var/cache/apt/* /var/lib/apt/lists/*
