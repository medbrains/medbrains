#!/bin/bash
# IT's reset for a member of staff: prints a link that lets that person choose a new password, for an hour.
# It uses Control's account, so it cannot reset an administrator. Written recovery: os/README.md.
#
#   kanidm-reset-password <username>
set -euo pipefail

. /usr/lib/medbrains/kanidm-lib.sh

username="${1:?usage: kanidm-reset-password <username>}"
INTENT_SECONDS=3600

intent="$(api_as "$(cat /var/lib/medbrains/config/idp-control-token)" \
    "$ORIGIN/v1/person/$username/_credential/_update_intent/$INTENT_SECONDS" | sed -n 's/.*"token":"\([^"]*\)".*/\1/p')"
[[ -n "$intent" ]] || { echo "could not reset $username" >&2; exit 1; }
echo "https://idm.medbrains.local:9443/ui/reset?token=$intent"
