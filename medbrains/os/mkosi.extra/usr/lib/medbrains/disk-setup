#!/bin/bash
# The encrypted data partition (/var). Class A code: docs/architecture/OS-KEYS.md has its failure table.
#
#   disk-setup prepare   before /var is mounted: create the partition if this disk has none
#   disk-setup notice    say what the passphrase prompt means if the disk did not open by itself
#   disk-setup finish    after /var is mounted: show the recovery key once, offer a PIN, record it
#   disk-setup reseal KEYFILE   seal to this machine's TPM again, after a board or TPM change; drops a PIN
#   disk-setup floor-check   before /var is opened: no TPM unlock for a version below the rollback floor
#   disk-setup floor-raise   raise the rollback floor to this version (the updater, before an install)
#   disk-setup floor-adopt   after /var is mounted: give a disk sealed before the floor existed one
set -euo pipefail

PART="${MEDBRAINS_DISK_PART:-/dev/disk/by-partlabel/medbrains-data}"
MAPPED=/dev/mapper/medbrains-data
DEFINITIONS=/usr/lib/medbrains/repart
CONFIG="${MEDBRAINS_DISK_CONFIG:-/var/lib/medbrains/config}"
RECORD="$CONFIG/disk-protection"
# Written once the person has shown they saved the recovery key. Holds no secret.
KEY_SAVED="$CONFIG/.recovery-key-saved"
# PCR 7 alone only when the firmware enforces Secure Boot and trusts our certificate and nothing else in
# PK, KEK and db: then only boot files we signed can have run, and a new one leaves 7 unchanged, so updates
# open by themselves. Any other trusted certificate, a mode that does not enforce, or anything unreadable
# keeps 4, the boot loader and boot file the firmware started, and every new boot file asks for the
# recovery key once. The decision is `medbrains-os-update seal-pcrs` (secure_boot.rs, unit-tested).
# Not 12: it changed between normal cold boots under test, so the machine stopped opening itself.
SEAL_PCRS_KEEP_4=4+7
SEAL_DECIDER="${MEDBRAINS_SEAL_DECIDER:-/usr/bin/medbrains-os-update}"
# Put here by the boot file when the image was signed. 11 alone protects nothing without 4 or Secure
# Boot: an attacker's system can extend it to the published values and replay this signature.
PCR_PUBLIC_KEY=/run/systemd/tpm2-pcr-public-key.pem
SIGNED_PCRS=11
# The rollback floor (OS-KEYS.md): a TPM monotonic counter. A version whose MEDBRAINS_ROLLBACK is below it
# gets no TPM unlock. A counter, not an ordinary index: deleting and defining it again cannot lower it.
FLOOR_INDEX=0x01004d42
TPM_DEVICE="${MEDBRAINS_TPM_DEVICE:-/dev/tpmrm0}"
export TPM2TOOLS_TCTI="device:$TPM_DEVICE"
PCR_EXTEND="${MEDBRAINS_PCR_EXTEND:-/usr/lib/systemd/systemd-pcrextend}"
OS_RELEASE="${MEDBRAINS_OS_RELEASE:-/usr/lib/os-release}"
# Each release raises OS_ROLLBACK by one, so an install normally takes one TPM increment, and a machine
# that skipped releases a few. 64 covers a year of weekly releases skipped at once; more is a release
# numbered wrongly. Each step is one NV write: real TPMs rate-limit those and rate them for about 100,000
# or more writes, so 64 is far inside both, and at a slow chip's ~100 ms each, inside the updater's 120 s.
MAX_FLOOR_STEPS=64
MIN_PIN_LENGTH=6
SETTLE_S=30
NOTICE_AFTER_S=20
RECOVERY_KEY_SHAPE='^[a-z]+(-[a-z]+){7}$'
RECOVERY_KEY_GROUPS=8
# systemd's recovery keys are 8 groups of 8 modhex letters.
RECOVERY_KEY_GROUP_LENGTH=8
# Where a typed key waits, briefly, to be checked: memory only, never the disk.
KEY_DIR="${MEDBRAINS_KEY_DIR:-/run}"

# Clears the machine's screen and shows the cursor, which the kernel command line hides.
clear_screen() { printf '\033c\033[?25h'; }

# Prints the PCRs to seal to. Only the two answers the decider can give are taken; anything else, or a
# decider that fails, keeps PCR 4.
seal_pcrs() {
    local answer
    answer="$("$SEAL_DECIDER" seal-pcrs 2>/dev/null)" || answer=""
    case "$answer" in
        7) echo 7 ;;
        *) echo "$SEAL_PCRS_KEEP_4" ;;
    esac
}

# Sets SEAL_ARGS: what to seal to, the same for first boot and for a later re-seal.
set_seal_args() {
    local pcrs
    pcrs="$(seal_pcrs)"
    SEAL_ARGS=(--tpm2-device=auto --tpm2-pcrs="$pcrs")
    if [[ -e "$PCR_PUBLIC_KEY" ]]; then
        SEAL_ARGS+=(--tpm2-public-key="$PCR_PUBLIC_KEY" --tpm2-public-key-pcrs="$SIGNED_PCRS")
    fi
}

# Asks what to do on a machine with no TPM. Returns only if the person typed the choice to store data
# unencrypted. A loop with no limit, on purpose: nothing may happen until a person decides.
ask_about_missing_tpm() {
    local answer
    clear_screen
    cat <<'TEXT'
MedBrains: this machine has no security chip (TPM 2.0).

Without one, anyone who takes or copies this disk can read every patient record.
Nothing has been stored yet.

Recommended: turn the machine off, turn on the TPM in its firmware settings or fit
a TPM 2.0 module, and start it again.

  To turn off now, type OFF and press Enter.

  To carry on WITHOUT encryption, type STORE UNENCRYPTED and press Enter. Do this only
  if your hospital accepts that risk. The choice is recorded.

TEXT
    while read -r -p '> ' answer; do
        case "$answer" in
            OFF) systemctl poweroff; exit 1 ;;
            'STORE UNENCRYPTED') return 0 ;;
            *) echo 'Please type OFF or STORE UNENCRYPTED.' ;;
        esac
    done
    exit 1
}

# Prints a copy of the data partition's definition that gives it this boot's machine id as its UUID. The
# root is read-only, so that UUID is where the initrd finds the id on every later start (OS-VERITY.md).
definitions_named_after_this_machine() {
    local id copy=/run/medbrains-repart
    id="$(cat /etc/machine-id)"
    [[ "$id" =~ ^[0-9a-f]{32}$ ]] || { echo "MedBrains: this machine has no usable id ($id)." >&2; exit 1; }
    rm -rf "$copy"
    cp -R "$DEFINITIONS/$1" "$copy"
    echo "UUID=${id:0:8}-${id:8:4}-${id:12:4}-${id:16:4}-${id:20:12}" >> "$copy/30-data.conf"
    echo "$copy"
}

# Creates the data partition unless this disk already has one. systemd-repart formats it and writes the
# partition table last, so a power cut here leaves a disk that simply starts over.
prepare() {
    local definitions=tpm
    modprobe -q -a loop dm_mod dm_crypt
    # A timeout only means the checks below may see too little. Neither can harm data: repart keeps an
    # existing partition, and a TPM that is merely late leads to the question, which a person can refuse.
    udevadm settle --timeout="$SETTLE_S" || true
    [[ -e "$PART" ]] && return 0
    if [[ ! -e /dev/tpmrm0 ]]; then
        ask_about_missing_tpm
        definitions=no-tpm
    fi
    clear_screen
    echo 'MedBrains: preparing the data disk. This takes a moment.'
    # Before the partition, so a sealed disk never exists without its floor.
    if [[ "$definitions" == tpm ]] && ! floor_raise; then
        echo 'MedBrains could not set the rollback floor in the security chip, so nothing was stored.'
        exit 1
    fi
    set_seal_args
    if ! systemd-repart --dry-run=no --definitions="$(definitions_named_after_this_machine "$definitions")" "${SEAL_ARGS[@]}"; then
        echo
        echo 'MedBrains could not prepare the data disk, so nothing was stored.'
        echo 'Call your system administrator. The reason is shown above.'
        exit 1
    fi
    udevadm settle --timeout="$SETTLE_S" || true
    clear_screen
}

# Explains the passphrase prompt that systemd shows on a disk the TPM will not open. The wait is bounded
# and ends at once on a machine whose disk opened normally.
notice() {
    local waited
    for ((waited = 0; waited < NOTICE_AFTER_S; waited++)); do
        [[ -e "$MAPPED" ]] && return 0
        sleep 1
    done
    cat <<'TEXT'

MedBrains: the data disk did not open by itself.

This happens if the disk was moved to another machine, or this machine's main board
or security chip changed, or its boot files were changed, or an older MedBrains version
was started than this machine allows. Patient data stays locked.
If it asks for a PIN, type your hospital's PIN. After two wrong tries it asks for the
recovery key instead; restart to try the PIN again. If it asks for the recovery key,
type what was written down at setup. Then press Enter. Typed characters are not shown.

TEXT
}

# Sets KEY_FILE to a private file on tmpfs, removed when this script ends, however it ends. Not a local:
# the trap runs after the function has returned.
use_key_file() {
    KEY_FILE="$(mktemp -p /run)"
    trap 'rm -f "$KEY_FILE"' EXIT
}

# Stops first boot with a plain message. The screen unit needs this step, so nothing draws over it.
fail() {
    echo
    echo "MedBrains could not finish setting up the data disk: $1"
    echo 'No patient data has been stored. Call your system administrator.'
    exit 1
}

# Makes a new recovery key and has the person prove they wrote it down, from their copy, with the screen
# cleared: they type the whole key back, and it must open the disk. Replaces any earlier key: until the
# proof, nobody can be relied on to have saved that one.
show_recovery_key() {
    local key typed
    # stderr holds a QR code of the key when it is a terminal, and must never reach the journal.
    key="$(systemd-cryptenroll --unlock-tpm2-device=auto --wipe-slot=recovery --recovery-key "$PART" 2>/dev/null)" \
        || fail 'the recovery key could not be made.'
    key_well_formed "$key" || fail 'the recovery key could not be made.'
    # A loop with no limit, on purpose: the machine holds no data until the key is saved. Printed, not
    # `read -p`: that writes to stderr, which is the journal.
    while true; do
        clear_screen
        cat <<TEXT
MedBrains: write down this disk's recovery key. It is shown only now.

    $key

You need it if this disk moves to another machine, or the main board or security
chip fails. MedBrains keeps no copy and cannot get it back. Keep it with your
hospital's important papers, away from this machine.

TEXT
        printf 'When it is written down, press Enter. The key will leave the screen.'
        read -r typed
        clear_screen
        printf 'From what you wrote down, type the whole recovery key, with its dashes, and press Enter:\n'
        read -r typed
        typed_key_opens "$typed" && break
        printf 'That is not the key on the screen. It will be shown again. Press Enter.'
        read -r typed
    done
    clear_screen
}

# Succeeds if $1 has a recovery key's shape: 8 groups of exactly 8 lower-case letters, between dashes.
key_well_formed() {
    local group
    local -a groups
    [[ "$1" =~ $RECOVERY_KEY_SHAPE ]] || return 1
    IFS=- read -r -a groups <<<"$1"
    (( ${#groups[@]} == RECOVERY_KEY_GROUPS )) || return 1
    for group in "${groups[@]}"; do
        (( ${#group} == RECOVERY_KEY_GROUP_LENGTH )) || return 1
    done
}

# Succeeds if what the person typed, $1, is a well-formed key that opens this disk by itself: proof they
# wrote down all of it, not one group. Checked through a private file in memory, removed at once.
typed_key_opens() {
    local file status
    key_well_formed "$1" || return 1
    file="$(umask 077 && mktemp "$KEY_DIR/medbrains-typed-key.XXXXXX")" || return 1
    printf '%s' "$1" > "$file"
    status=0
    check_key_file "$file" || status=1
    rm -f "$file"
    return "$status"
}

# Asks for a recovery key that was already saved, checks it, and leaves it in the file $1.
ask_for_saved_key() {
    local typed
    clear_screen
    echo 'MedBrains: setup was interrupted. Your recovery key is still the one you wrote down.'
    while true; do
        printf '\nType the recovery key and press Enter: '
        read -r typed
        printf '%s' "$typed" > "$1"
        check_key_file "$1" && return 0
        echo 'That key does not open this disk.'
    done
}

# Succeeds if the file holds a key that opens this disk by itself. Without the flag, a TPM token opens
# the disk whatever the key says.
check_key_file() {
    cryptsetup open --test-passphrase --disable-external-tokens --key-file="$1" "$PART" 2>/dev/null
}

# Offers a PIN at every start: stronger against someone with the machine in their hands, but it will not
# restart by itself after a power cut. Empty means no PIN. Sets PIN. A loop with no limit, on purpose.
ask_for_pin() {
    local again
    clear_screen
    cat <<'TEXT'
MedBrains: how should this machine start?

Press Enter on its own to start without typing. It comes back by itself after a power
cut. This protects a disk taken out of the machine. It does not stop someone who steals
the whole machine and can change what is on its disk.

Or choose a PIN of at least 6 characters. That protects a stolen machine as well. It is
asked on this screen at every start, so after a power cut the machine waits for a person. If the PIN is forgotten, the recovery
key still opens it, after two wrong tries.

TEXT
    while true; do
        printf 'PIN (nothing is shown as you type): '
        read -rs PIN
        echo
        [[ -z "$PIN" ]] && return 0
        printf 'Type it again: '
        read -rs again
        echo
        [[ "$PIN" == "$again" && ${#PIN} -ge MIN_PIN_LENGTH ]] && return 0
        echo 'Those did not match, or it is too short. Try again.'
    done
}

# Replaces the seal with one that also needs the PIN. A PIN changes the policy, so one call adds the new
# slot and then removes the old, and no moment is left with neither.
seal_with_pin() {
    set_seal_args
    NEWPIN="$PIN" systemd-cryptenroll --unlock-tpm2-device=auto --tpm2-with-pin=yes --wipe-slot=tpm2 \
        "${SEAL_ARGS[@]}" "$PART" >/dev/null || fail 'the PIN could not be set.'
}

# Writes how this disk is protected, in one step. It holds no secret: the desktop shows it.
write_record() {
    printf '%s\n' "$1" > "$RECORD.new"
    chmod 0644 "$RECORD.new"
    mv "$RECORD.new" "$RECORD"
    echo "data disk protection: $1" >&2
}

# First boot's sealed path: the key, then the PIN question, then the record.
finish_first_time() {
    show_recovery_key
    : > "$KEY_SAVED"
    ask_for_pin
    [[ -n "$PIN" ]] && seal_with_pin
    clear_screen
    if [[ -n "$PIN" ]]; then write_record encrypted-tpm2-pin; else write_record encrypted-tpm2; fi
}

# A power cut came after the key was saved and before the record. The seal may need a PIN nobody can
# vouch for, so it is replaced using the saved key, and the record says what the seal is now.
finish_after_interruption() {
    use_key_file
    ask_for_saved_key "$KEY_FILE"
    ask_for_pin
    set_seal_args
    systemd-cryptenroll --wipe-slot=tpm2 "$PART" >/dev/null 2>&1 || fail 'the old seal could not be removed.'
    if [[ -n "$PIN" ]]; then
        NEWPIN="$PIN" systemd-cryptenroll --unlock-key-file="$KEY_FILE" --tpm2-with-pin=yes "${SEAL_ARGS[@]}" "$PART" >/dev/null \
            || fail 'the disk could not be sealed.'
    else
        systemd-cryptenroll --unlock-key-file="$KEY_FILE" "${SEAL_ARGS[@]}" "$PART" >/dev/null \
            || fail 'the disk could not be sealed.'
    fi
    clear_screen
    if [[ -n "$PIN" ]]; then write_record encrypted-tpm2-pin; else write_record encrypted-tpm2; fi
}

# Records how this disk is protected, after the steps its slots call for. Only an empty-key slot, which
# a sealed disk never has, means someone chose to go unencrypted; anything unexplained stops first boot.
finish() {
    local slots
    slots="$(systemd-cryptenroll "$PART")" || fail 'its key slots could not be read.'
    if grep -qw password <<<"$slots"; then
        write_record unencrypted-chosen
    elif [[ -e "$KEY_SAVED" ]]; then
        finish_after_interruption
    elif grep -qw tpm2 <<<"$slots"; then
        finish_first_time
    else
        fail 'it has neither a seal nor a recorded choice.'
    fi
}

# Seals to this machine's TPM again, unlocking with the recovery key in file $1. Checks the key before
# touching anything. Two steps: in one, cryptenroll finds the same policy already enrolled and does
# nothing, though that TPM has gone. The new seal has no PIN, and the record says so.
reseal() {
    use_key_file
    tr -d '[:space:]' < "$1" > "$KEY_FILE"
    check_key_file "$KEY_FILE" || { echo 'That key does not open this disk; nothing changed.' >&2; exit 1; }
    set_seal_args
    systemd-cryptenroll --wipe-slot=tpm2 "$PART"
    systemd-cryptenroll --unlock-key-file="$KEY_FILE" "${SEAL_ARGS[@]}" "$PART"
    if mountpoint -q /var; then write_record encrypted-tpm2; fi
}

# Prints this system's rollback number, from the sealed system partition: the boot file carries its root
# hash, so no boot file can claim another system's number.
own_rollback() {
    local value
    value="$(sed -n 's/^MEDBRAINS_ROLLBACK=//p' "$OS_RELEASE" | tr -d '"')"
    [[ "$value" =~ ^[1-9][0-9]{0,8}$ ]] || return 1
    echo "$value"
}

# Prints the floor counter's value; fails if it is missing or unreadable.
floor_value() {
    local hex
    # Eight bytes, most significant first.
    hex="$(tpm2_nvread -C o -s 8 "$FLOOR_INDEX" 2>/dev/null | od -An -tx1 | tr -d ' \n')"
    [[ "$hex" =~ ^[0-7][0-9a-f]{15}$ ]] || return 1
    echo "$((16#$hex))"
}

# Defines the floor counter if it is missing. A new counter starts above any this TPM ever deleted.
floor_define() {
    tpm2_nvreadpublic "$FLOOR_INDEX" >/dev/null 2>&1 && return 0
    tpm2_nvdefine "$FLOOR_INDEX" -C o -s 8 -a 'nt=counter|ownerwrite|ownerread' >/dev/null &&
        tpm2_nvincrement -C o "$FLOOR_INDEX" >/dev/null
}

# Raises the floor to this system's rollback number, never lowering it: a counter cannot go down.
floor_raise() {
    local want have steps=0
    [[ -e "$TPM_DEVICE" ]] || return 0
    want="$(own_rollback)" || { echo 'This system has no rollback number.' >&2; return 1; }
    floor_define || return 1
    have="$(floor_value)" || return 1
    while (( have < want && steps < MAX_FLOOR_STEPS )); do
        tpm2_nvincrement -C o "$FLOOR_INDEX" >/dev/null || return 1
        have="$(floor_value)" || return 1
        steps=$((steps + 1))
    done
    (( have >= want ))
}

# Before the data disk opens. A version below the floor, or a floor that can't be read, gets no TPM
# unlock: PCR 11 is extended, so no signed policy matches for the rest of this boot, and the disk asks for
# its recovery key. Fails only if that refusal could not be made; then the disk is not opened at all.
floor_check() {
    local own="" floor=""
    [[ -e "$TPM_DEVICE" ]] || return 0
    if own="$(own_rollback)" && floor="$(floor_value)" && (( own >= floor )); then
        return 0
    fi
    echo "MedBrains: this version (rollback ${own:-unknown}) is below this machine's floor" \
        "(${floor:-unreadable}), so the data disk will ask for its recovery key." >&2
    "$PCR_EXTEND" --pcr=11 medbrains-below-rollback-floor
}

# After the data disk opened: a disk sealed before the floor existed gets one, at its lowest, never at
# this version, which may be a trial that must still be able to go back. Installs raise it.
floor_adopt() {
    [[ -e "$TPM_DEVICE" ]] || return 0
    floor_define && return 0
    echo 'MedBrains: the rollback floor could not be set in the security chip, so the next start will ask' \
        'for the data disk recovery key. Call your system administrator.' >&2
    return 1
}

# Sourced by its tests, which call the functions above; run, it does what it is asked.
[[ "${BASH_SOURCE[0]}" == "$0" ]] || return 0
case "${1:-}" in
    prepare) prepare ;;
    notice) notice ;;
    finish) finish ;;
    reseal) reseal "$2" ;;
    floor-check) floor_check ;;
    floor-raise) floor_raise ;;
    floor-adopt) floor_adopt ;;
    *) echo "usage: disk-setup prepare|notice|finish|reseal KEYFILE|floor-check|floor-raise|floor-adopt" >&2; exit 2 ;;
esac
