# Only a main machine's ports. Loaded by role-network into the base firewall's main_machine chain,
# so a node, and a machine not yet set up, never opens them.
#
# One address, or one IPv6 /64, gets a limited rate of new connections, so one machine cannot flood the front end.
add rule inet medbrains main_machine tcp dport { 80, 443, 9443 } ct state new meter web_new { ip saddr limit rate over 50/second burst 100 packets } drop
add rule inet medbrains main_machine tcp dport { 80, 443, 9443 } ct state new meter web_new6 { ip6 saddr and ffff:ffff:ffff:ffff:: limit rate over 50/second burst 100 packets } drop
add rule inet medbrains main_machine tcp dport { 80, 443 } accept
add rule inet medbrains main_machine tcp dport 9443 accept comment "identity provider sign-in"
add rule inet medbrains main_machine udp dport 123 accept comment "serves the LAN its time"
# A machine's connections reach the front end from its own 127.x.y.z, which the audit log and the
# sign-in limit believe. Only the agent may use those addresses, or any local program could appear
# as a machine.
insert rule inet medbrains output oif lo ip saddr 127.0.0.0/8 ip saddr != 127.0.0.0/16 tcp dport 8443 ct state new meta skuid != "medbrains-agent" reject
# iroh for nodes (OS-SETUP-AND-TRUST §8). Unknown keys get a refusal, and a limit on new flows keeps
# the handshakes cheap to refuse.
add rule inet medbrains main_machine udp dport 7844 ct state new limit rate over 100/second burst 200 packets drop
add rule inet medbrains main_machine udp dport 7844 accept comment "nodes, over iroh"
add rule inet medbrains main_machine udp dport 7845 limit rate 20/second burst 40 packets accept comment "who are you? for a typed address"
