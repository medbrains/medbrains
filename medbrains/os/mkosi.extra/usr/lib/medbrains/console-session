#!/bin/bash
# Runs inside cage as the kiosk user. Starts the screen's browser engine on the status
# page (which opens the app by itself when ready), and takes the screen back to that
# page if the server stops answering.
#
# A brief blip is not an outage: a web app holding a half-typed form survives one, so
# the screen moves only after OUTAGE_S of failed checks. Each return within FLAP_S of
# the last asks the status page to wait longer before going back to the app.
set -uo pipefail

STATUS_URL=file:///usr/share/medbrains/console/index.html
HEALTH=http://127.0.0.1:3000/api/health
POLL_S=5
OUTAGE_S=30
FLAP_S=600
BACKGROUND='#0a1630'

export DBUS_SESSION_BUS_ADDRESS="unix:path=$XDG_RUNTIME_DIR/bus"

# No page cache: returning to a cached app page after an outage painted nothing, and left
# the flat background on screen.
/usr/bin/cog --webprocess-failure=restart --enable-page-cache=false --bg-color="$BACKGROUND" \
    --content-filter=/usr/share/medbrains/console/content-filter.json "$STATUS_URL" &
cog_pid=$!
trap 'kill "$cog_pid" 2>/dev/null' EXIT

# Sends the screen to the status page. If cog cannot be told, ending it restarts this
# whole session, which also lands on the status page.
show_status_page() {
    /usr/bin/cogctl open "$STATUS_URL?attempt=$1" || kill "$cog_pid"
}

down_s=0
on_status=1
attempt=0
last_return=-$FLAP_S
while kill -0 "$cog_pid" 2>/dev/null; do
    sleep "$POLL_S"
    if curl -fsS -m 3 -o /dev/null "$HEALTH"; then
        down_s=0
        on_status=0
        continue
    fi
    down_s=$((down_s + POLL_S))
    if [[ "$on_status" == 0 && "$down_s" -ge "$OUTAGE_S" ]]; then
        if ((SECONDS - last_return < FLAP_S)); then attempt=$((attempt + 1)); else attempt=1; fi
        last_return=$SECONDS
        show_status_page "$attempt"
        on_status=1
    fi
done
wait "$cog_pid"
