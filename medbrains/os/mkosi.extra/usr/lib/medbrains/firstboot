#!/bin/bash
# First boot on this box: generate every secret and the database cluster.
# Nothing secret is in the image; everything lands on the data partition.
# Secret generation mirrors deploy/standalone/install.sh.
set -euo pipefail

CONF=/var/lib/medbrains/config
ENV="$CONF/env"
PG_VERSION=17
IDP_NAME=idm.medbrains.local

# Prints N random alphanumeric characters.
rand() { openssl rand -base64 48 | LC_ALL=C tr -cd 'A-Za-z0-9' | cut -c1-"$1"; }

write_env() {
    local tmp priv pub
    tmp="$(mktemp -d)"
    # JWT: PKCS#8 DER private key; raw 32-byte public key (see install.sh).
    openssl genpkey -algorithm Ed25519 -outform DER -out "$tmp/priv.der" 2>/dev/null
    openssl pkey -inform DER -in "$tmp/priv.der" -pubout -outform DER -out "$tmp/spki.der" 2>/dev/null
    priv="$(base64 -w0 < "$tmp/priv.der")"
    pub="$(tail -c 32 "$tmp/spki.der" | base64 -w0)"
    rm -rf "$tmp"

    install -m 0640 -o root -g medbrains /dev/null "$ENV.new"
    cat > "$ENV.new" <<ENVEOF
# Generated on first boot by /usr/lib/medbrains/firstboot. Back this file up
# with the database: the keys below cannot be regenerated without data loss.
MEDBRAINS_ENV=production
MEDBRAINS_SINGLE_HOSPITAL=true
DATABASE_URL=postgres://medbrains:$(rand 32)@127.0.0.1:5432/medbrains
DB_POOL_MAX_CONNECTIONS=10
DB_POOL_MIN_CONNECTIONS=1
HOST=127.0.0.1
PORT=3000
STATIC_DIR=/usr/share/medbrains/web
CORS_ORIGIN=https://medbrains.local
SECURE_COOKIES=true
TRUSTED_PROXIES=127.0.0.1/32,::1/128
RUST_LOG=medbrains_server=info,tower_http=warn
MEDBRAINS_OBJECTS_HOT=/var/lib/medbrains/objects
MEDBRAINS_OBJECTS_COLD=/var/lib/medbrains/cold
MEDBRAINS_OBJECTS_ARCHIVE=/var/lib/medbrains/archive
MEDBRAINS_ICD_LOCAL_SERVICE=false
MEDBRAINS_PUBLIC_BASE_URL=https://medbrains.local
SSL_CERT_FILE=$CONF/idp-front.pem
SSL_CERT_DIR=/etc/ssl/certs
JWT_PRIVATE_KEY=$priv
JWT_PUBLIC_KEY=$pub
MEDBRAINS_IDENTIFIER_HMAC_KEY=$(openssl rand -base64 48 | tr -d '\n')
MEDBRAINS_ABDM_SECRET_KEY=$(openssl rand -base64 48 | tr -d '\n')
MEDBRAINS_NHCX_SECRET_KEY=$(openssl rand -base64 48 | tr -d '\n')
MEDBRAINS_PACS_SECRET_KEY=$(openssl rand -base64 48 | tr -d '\n')
ENVEOF
    mv "$ENV.new" "$ENV"
}

create_cluster() {
    # Data checksums catch silent flash corruption; crash safety is never
    # traded for speed (§8o). JIT off: small box, and W^X under systemd.
    pg_createcluster "$PG_VERSION" main --start-conf=auto -- \
        --data-checksums --auth-local=peer --auth-host=scram-sha-256 --encoding=UTF8
    cat > "/etc/postgresql/$PG_VERSION/main/conf.d/10-medbrains.conf" <<'PGEOF'
listen_addresses = 'localhost'
fsync = on
full_page_writes = on
synchronous_commit = on
jit = off
shared_buffers = 256MB
effective_cache_size = 1GB
max_connections = 50
wal_compression = on
checkpoint_timeout = 15min
max_wal_size = 1GB
log_min_duration_statement = 2000
# Slow queries must not copy patient values into the log. The journal bounds its size.
log_parameter_max_length = 0
log_parameter_max_length_on_error = 0
log_destination = 'syslog'
PGEOF
    # This script runs under UMask=0077; PostgreSQL must be able to read it.
    chown postgres:postgres "/etc/postgresql/$PG_VERSION/main/conf.d/10-medbrains.conf"
}

# The certificate for the screen's own loopback front end (Caddyfile): self-signed, and
# the only certificate the kiosk trusts (cage-console.service).
create_local_cert() {
    install -d -m 0750 -o caddy -g caddy /var/lib/caddy/local
    openssl req -x509 -newkey ec -pkeyopt ec_paramgen_curve:prime256v1 -nodes -days 7300 \
        -keyout /var/lib/caddy/local/key.pem -out /var/lib/caddy/local/cert.pem \
        -subj "/CN=MedBrains local screen" -addext "subjectAltName=IP:127.0.0.1" 2>/dev/null
    chown caddy:caddy /var/lib/caddy/local/key.pem /var/lib/caddy/local/cert.pem
    install -m 0644 /var/lib/caddy/local/cert.pem /var/lib/kiosk/local-front.pem
}

# Writes a 20-year self-signed certificate for a name: key file, certificate file, name. CA:FALSE,
# because rustls refuses a CA certificate used as a server's own.
self_signed_leaf() {
    openssl req -x509 -newkey ec -pkeyopt ec_paramgen_curve:prime256v1 -nodes -days 7300 \
        -keyout "$1" -out "$2" -subj "/CN=$3" -addext "subjectAltName=DNS:$3" \
        -addext "basicConstraints=critical,CA:FALSE" 2>/dev/null
}

# The identity provider's two certificates. Kanidm only speaks TLS, so Caddy reaches it over TLS on
# loopback and trusts that one certificate; Caddy's own front on 9443 is the one the MedBrains server
# trusts by name.
create_idp_certs() {
    self_signed_leaf /var/lib/caddy/local/idp-key.pem /var/lib/caddy/local/idp-cert.pem "$IDP_NAME"
    chown caddy:caddy /var/lib/caddy/local/idp-key.pem /var/lib/caddy/local/idp-cert.pem
    install -m 0644 /var/lib/caddy/local/idp-cert.pem "$CONF/idp-front.pem"
    # The Identity tile opens this front on the machine's own screen, which trusts only what is here.
    cat /var/lib/caddy/local/idp-cert.pem >> /var/lib/kiosk/local-front.pem
    self_signed_leaf /var/lib/kanidm/tls-key.pem /var/lib/kanidm/tls-chain.pem "$IDP_NAME"
    chown kanidm:kanidm /var/lib/kanidm/tls-key.pem /var/lib/kanidm/tls-chain.pem
    install -m 0644 /var/lib/kanidm/tls-chain.pem /var/lib/caddy/local/kanidm-back.pem
}

systemd-tmpfiles --create /usr/lib/tmpfiles.d/medbrains.conf
[[ -s "$ENV" ]] || write_env
[[ -f "/etc/postgresql/$PG_VERSION/main/postgresql.conf" ]] || create_cluster
[[ -f /var/lib/caddy/local/cert.pem ]] || create_local_cert
[[ -f /var/lib/kanidm/tls-key.pem ]] || create_idp_certs
touch "$CONF/.firstboot-done"
