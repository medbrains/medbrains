#!/bin/bash
# The identity provider's own secrets, database role, database and schema, on the main machine only.
# Runs before every start, so an updated image's new migrations apply; each step is idempotent.
# Its API does not migrate itself (upstream runs `sqlx migrate` as a separate container), so psql
# applies them, in order, each in one transaction, recorded in a table of our own.
set -euo pipefail

ENV=/var/lib/medbrains/config/ferriskey.env
MIGRATIONS=/usr/share/ferriskey/migrations

# Prints N random alphanumeric characters.
rand() { openssl rand -base64 48 | LC_ALL=C tr -cd 'A-Za-z0-9' | cut -c1-"$1"; }

write_env() {
    install -m 0640 -o root -g ferriskey /dev/null "$ENV.new"
    cat > "$ENV.new" <<ENVEOF
# Generated by /usr/lib/medbrains/ferriskey-init. Back this up with the database: without the
# sealing key below, the realm signing keys and TOTP seeds in the database cannot be read.
ENV=production
SERVER_HOST=127.0.0.1
SERVER_PORT=3333
SERVER_ROOT_PATH=/api
SERVER_PUBLIC_URL=https://medbrains.local:9443
# Caddy is the only way in and overwrites this header. Off, FerrisKey sees every client as loopback,
# so its own throttle on failed client sign-ins would be shared by the whole hospital.
SERVER_TRUST_FORWARDED_FOR=true
WEBAPP_URL=https://medbrains.local:9443
ALLOWED_ORIGINS=https://medbrains.local:9443
DATABASE_HOST=127.0.0.1
DATABASE_NAME=ferriskey
DATABASE_USER=ferriskey
DATABASE_PASSWORD=$(rand 32)
DATABASE_MAX_CONNECTIONS=5
DATABASE_MIN_CONNECTIONS=1
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@medbrains.local
ADMIN_PASSWORD=$(rand 32)
SECRETS_ENCRYPTION_KEYS=k1:$(openssl rand -base64 32)
PASSWORD_HASH_MEMORY_BUDGET_MIB=64
LOG_JSON=true
SSL_CERT_FILE=/var/lib/ferriskey/idp-front.pem
ENVEOF
    mv "$ENV.new" "$ENV"
}

[[ -s "$ENV" ]] || write_env
# Its only trust root while it may reach nothing but this machine: the front end's own certificate.
install -m 0644 /var/lib/medbrains/config/idp-front.pem /var/lib/ferriskey/idp-front.pem
pw="$(sed -n 's/^DATABASE_PASSWORD=//p' "$ENV")"

runuser -u postgres -- psql -X -q -v ON_ERROR_STOP=1 -d postgres <<SQL
DO \$\$
BEGIN
    IF NOT EXISTS (SELECT 1 FROM pg_roles WHERE rolname = 'ferriskey') THEN
        CREATE ROLE ferriskey LOGIN NOSUPERUSER NOCREATEDB NOCREATEROLE;
    END IF;
END \$\$;
ALTER ROLE ferriskey PASSWORD '$pw';
SQL
if [[ -z "$(runuser -u postgres -- psql -X -tAc "SELECT 1 FROM pg_database WHERE datname = 'ferriskey'")" ]]; then
    runuser -u postgres -- createdb -O ferriskey ferriskey
    # The hospital's data is not this role's business, nor its data anyone else's.
    runuser -u postgres -- psql -X -q -c "REVOKE ALL ON DATABASE ferriskey FROM PUBLIC" -d postgres
fi

as_ferriskey() { runuser -u ferriskey -- psql -X -q -v ON_ERROR_STOP=1 -d ferriskey "$@"; }
as_ferriskey -c "CREATE TABLE IF NOT EXISTS medbrains_applied_migrations (name text PRIMARY KEY, applied_at timestamptz NOT NULL DEFAULT now())"
applied="$(as_ferriskey -tAc 'SELECT name FROM medbrains_applied_migrations')"
for file in "$MIGRATIONS"/*.up.sql; do
    name="$(basename "$file")"
    grep -qxF "$name" <<<"$applied" && continue
    # The leading semicolon: some upstream files end without one.
    { cat "$file"; echo; echo "; INSERT INTO medbrains_applied_migrations (name) VALUES ('$name');"; } |
        as_ferriskey -1 -f -
done
