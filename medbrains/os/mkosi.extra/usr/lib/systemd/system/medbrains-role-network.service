# What only a main machine offers the network: opens its ports, announces medbrains.local and serves
# the LAN its time. A machine with any other role opens none of it.
[Unit]
Description=MedBrains main machine network services
ConditionPathExists=/var/lib/medbrains/config/role-main
After=nftables.service chrony.service systemd-resolved.service

[Service]
Type=oneshot
RemainAfterExit=yes
TimeoutStartSec=60
ExecStart=/usr/lib/medbrains/role-network
# Sandbox (T1.1): `systemd-analyze security` scores are in os/README.md "Linux hardening".
# Loads the main machine's firewall rules and tells networkd, resolved and chrony; writes only /run.
ProtectSystem=strict
ReadWritePaths=/run
PrivateDevices=yes
PrivateTmp=yes
CapabilityBoundingSet=CAP_NET_ADMIN
RestrictAddressFamilies=AF_UNIX AF_NETLINK
ProtectHome=yes
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
ProtectKernelModules=yes
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
UMask=0022
