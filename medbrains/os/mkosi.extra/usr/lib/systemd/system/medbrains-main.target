# What a main machine runs. Off until setup writes the role, so nothing answers on the network
# before the first administrator exists (OS-SETUP-AND-TRUST §5).
[Unit]
Description=MedBrains main machine
ConditionPathExists=/var/lib/medbrains/config/role-main
Wants=medbrains-server.service medbrains-front.service medbrains-front-certs.timer medbrains-console-status.service medbrains-role-network.service medbrains-agent-main.service kanidmd.service kanidm-setup.service
After=medbrains-firstboot.service

[Install]
WantedBy=multi-user.target
