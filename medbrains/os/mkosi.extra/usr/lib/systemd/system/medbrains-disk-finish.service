# First boot, data disk open, no secret on it yet: show the recovery key once and record the protection.
# Runs again after a power cut until the recovery key has been confirmed.
[Unit]
Description=MedBrains data disk recovery key
After=local-fs.target systemd-tmpfiles-setup.service
Before=medbrains-firstboot.service
ConditionPathExists=!/var/lib/medbrains/config/disk-protection

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/lib/medbrains/disk-setup finish
TimeoutStartSec=infinity
UMask=0077
TTYPath=/dev/tty1
TTYReset=yes
StandardInput=tty
StandardOutput=tty
StandardError=journal

# Sandbox (T1.1): `systemd-analyze security` scores are in os/README.md "Linux hardening".
# Early boot, root, writing the partition table, LUKS and the TPM. Not ProtectSystem or a device or
# module limit: it creates a partition, loads dm-crypt and talks to the TPM. Nor RestrictNamespaces or
# RestrictSUIDSGID: systemd-repart forks its copy step into a new namespace and copies /var's setgid
# folders, and first boot failed with both (found by medbrains-os-test). These cannot get in the way.
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictRealtime=yes
LockPersonality=yes
NoNewPrivileges=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_NETLINK

[Install]
# Before the setup screen: it comes first on tty1, whatever role this machine later takes.
WantedBy=multi-user.target
