# Keeps the status file the appliance screen reads. tmpfs only, and only on change.
[Unit]
Description=MedBrains screen status
After=medbrains-firstboot.service systemd-tmpfiles-setup.service

[Service]
Type=exec
ExecStart=/usr/lib/medbrains/console-status
Restart=always
RestartSec=5s
# Root only for what it must do: read the first password, ask the database as postgres.
ProtectSystem=strict
ReadWritePaths=/run/medbrains-console /var/lib/medbrains/config
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_SETUID CAP_SETGID CAP_CHOWN CAP_DAC_OVERRIDE CAP_FOWNER CAP_AUDIT_WRITE
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictSUIDSGID=yes
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
