# First boot: create the encrypted data partition, before anything uses /var. On later boots the
# partition exists and this is skipped. See /usr/lib/medbrains/disk-setup.
[Unit]
Description=MedBrains data disk setup
DefaultDependencies=no
Conflicts=shutdown.target
After=systemd-udevd.service systemd-udev-trigger.service systemd-remount-fs.service tpm2.target
Before=systemd-cryptsetup@medbrains\x2ddata.service sysinit.target shutdown.target
ConditionPathExists=!/dev/disk/by-partlabel/medbrains-data

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/lib/medbrains/disk-setup prepare
TimeoutStartSec=infinity
TTYPath=/dev/tty1
TTYReset=yes
StandardInput=tty
StandardOutput=tty
StandardError=tty

# Sandbox (T1.1): `systemd-analyze security` scores are in os/README.md "Linux hardening".
# Early boot, root, writing the partition table, LUKS and the TPM. Not ProtectSystem or a device or
# module limit: it creates a partition, loads dm-crypt and talks to the TPM. Nor RestrictNamespaces or
# RestrictSUIDSGID: systemd-repart forks its copy step into a new namespace and copies /var's setgid
# folders, and first boot failed with both (found by medbrains-os-test). These cannot get in the way.
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictRealtime=yes
LockPersonality=yes
NoNewPrivileges=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_NETLINK

[Install]
WantedBy=sysinit.target
