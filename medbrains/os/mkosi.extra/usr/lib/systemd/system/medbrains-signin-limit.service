# Slows repeated sign-ins from one address; the front asks it before each one (crates/medbrains-signin-limit).
[Unit]
Description=MedBrains sign-in limit
ConditionPathExists=/var/lib/medbrains/config/role-main

[Service]
Type=exec
DynamicUser=yes
ExecStart=/usr/bin/medbrains-signin-limit
Restart=always
RestartSec=1s
MemoryMax=32M
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost
SystemCallFilter=@system-service
SystemCallArchitectures=native
