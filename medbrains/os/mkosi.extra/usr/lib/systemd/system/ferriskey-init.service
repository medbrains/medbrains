# The identity provider's secrets, database and schema. Main machine only.
[Unit]
Description=MedBrains identity provider database
Requires=postgresql@17-main.service
After=postgresql@17-main.service medbrains-firstboot.service
ConditionPathExists=/var/lib/medbrains/config/role-main

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/lib/medbrains/ferriskey-init
UMask=0077
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
SystemCallArchitectures=native
