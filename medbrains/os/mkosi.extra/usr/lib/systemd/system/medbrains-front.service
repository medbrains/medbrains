# The TLS front (plan N2.1): the only thing on this machine a stranger on the LAN can reach without
# signing in. Everything anyone sees goes through it, so it always comes back, cannot take the
# machine's memory with it, and holds nothing but the keys it serves with.
[Unit]
Description=MedBrains front (TLS, redirect, limits, reverse proxy)
# A condition on the target alone is not enough: systemd still starts what a skipped unit wants.
ConditionPathExists=/var/lib/medbrains/config/role-main
After=medbrains-firstboot.service
# Keep trying for as long as the machine is up: every screen and browser depends on this.
StartLimitIntervalSec=0

[Service]
Type=notify
NotifyAccess=main
# As root, with the + : makes whatever certificate is missing. If that fails, so does this unit,
# visibly, on the machine's screen; there is no plain HTTP to fall back to.
# Refuses to start unconfined: AppArmor off or this profile not enforcing (L6).
ExecStartPre=+/usr/lib/medbrains/require-apparmor medbrains-front
ExecStartPre=+/usr/lib/medbrains/front-certs
ExecStart=/usr/bin/medbrains-front --config /usr/lib/medbrains/front.toml
Restart=always
RestartSec=2s
# medbrains-front pings every 10 s from the runtime that serves requests.
WatchdogSec=30s
TimeoutStopSec=10s
User=medbrains-front
Group=medbrains-front
# 256 on port 80, plus 4,096 + 1,024 that each hold one to the back end, plus room to spare. The
# front checks its own configuration against this at start, and a test checks the shipped pair.
LimitNOFILE=11000
TasksMax=32
MemoryHigh=384M
MemoryMax=512M
# Binds its ports and nothing else: no write access anywhere, no way to gain a privilege.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectProc=invisible
ProcSubset=pid
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
UMask=0077
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @mount @debug
SystemCallErrorNumber=EPERM
