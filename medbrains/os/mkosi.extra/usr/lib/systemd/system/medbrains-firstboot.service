# A main machine's first start: secrets and the database cluster, generated on this box, never
# baked into the image. Setup starts this when a person chooses a new hospital, so a node never
# holds any of it. Idempotent; a no-op once both exist.
[Unit]
Description=MedBrains first boot (secrets, database cluster)
Requires=medbrains-disk-finish.service
After=local-fs.target systemd-sysusers.service systemd-tmpfiles-setup.service medbrains-disk-finish.service
Before=postgresql@17-main.service medbrains-server.service
ConditionPathExists=!/var/lib/medbrains/config/.firstboot-done

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/lib/medbrains/firstboot
UMask=0077
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
SystemCallArchitectures=native
# Sandbox (T1.1): `systemd-analyze security` scores are in os/README.md "Linux hardening".
# Makes secrets, the database cluster and the front's certificates on the data disk. /usr and /etc
# stay read-only; /etc/postgresql and /etc/medbrains are links onto /var.
ProtectSystem=full
PrivateDevices=yes
CapabilityBoundingSet=CAP_CHOWN CAP_DAC_OVERRIDE CAP_DAC_READ_SEARCH CAP_FOWNER CAP_FSETID CAP_SETUID CAP_SETGID
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
ProtectKernelModules=yes
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
