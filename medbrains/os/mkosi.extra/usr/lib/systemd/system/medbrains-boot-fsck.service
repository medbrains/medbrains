# Repairs the boot partition's FAT file system at start, before anything writes to it (OS-UPDATES.md):
# FAT has no journal, so a power cut mid-rename can leave a damaged entry. Runs before /boot is mounted;
# a failure is logged and the start goes on, because the boot partition is not needed to keep running.
[Unit]
Description=Check the boot partition
DefaultDependencies=no
Conflicts=shutdown.target
After=systemd-udevd.service
Before=boot.mount medbrains-seal.service sysinit.target shutdown.target

[Service]
Type=oneshot
ExecStart=-/usr/bin/medbrains-os-update boot-fsck

[Install]
WantedBy=sysinit.target
