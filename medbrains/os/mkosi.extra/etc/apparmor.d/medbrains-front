# The TLS front (task T1.1): binds its ports, reads its configuration and certificates, and only proxies.
# It writes nothing and runs no program.
abi <abi/4.0>,
include <tunables/global>

profile medbrains-front /usr/bin/medbrains-front flags=(attach_disconnected) {
  include <abstractions/base>
  include <abstractions/nameservice>

  capability net_bind_service,
  signal (receive) peer=unconfined,
  network inet stream,
  network inet6 stream,
  network inet dgram,
  network inet6 dgram,
  unix,

  /usr/bin/medbrains-front mr,
  /usr/lib/medbrains/front.toml r,
  /var/lib/medbrains-front/ r,
  /var/lib/medbrains-front/** r,
  @{PROC}/@{pid}/** r,
  @{PROC}/sys/kernel/** r,
  /sys/fs/cgroup/** r,
  /sys/devices/system/cpu/** r,

  include if exists <local/medbrains-front>
}
