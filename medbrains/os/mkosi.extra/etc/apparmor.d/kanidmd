# The identity provider (task T1.1): its own database, keys and backups under /var/lib/kanidm, its
# pages, and loopback. It runs no program.
abi <abi/4.0>,
include <tunables/global>

profile kanidmd /usr/bin/kanidmd flags=(attach_disconnected) {
  include <abstractions/base>
  include <abstractions/nameservice>
  include <abstractions/ssl_certs>

  signal (receive) peer=unconfined,
  network inet stream,
  network inet6 stream,
  network inet dgram,
  network inet6 dgram,
  network netlink raw,
  unix,

  /usr/bin/kanidmd mr,
  /etc/kanidm/** r,
  /usr/share/kanidm/** r,
  /var/lib/kanidm/ rw,
  /var/lib/kanidm/** rwk,
  /run/kanidmd/ rw,
  /run/kanidmd/** rwk,
  owner /tmp/** rwk,
  @{PROC}/@{pid}/** r,
  @{PROC}/sys/kernel/** r,
  @{PROC}/{meminfo,stat} r,
  /sys/fs/cgroup/** r,
  /sys/devices/system/cpu/** r,

  include if exists <local/kanidmd>
}
