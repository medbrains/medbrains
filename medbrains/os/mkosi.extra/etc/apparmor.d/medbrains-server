# The MedBrains server (task T1.1): reads the web app and its certificates, writes only its object stores and
# logs, and runs no other program. systemd's sandbox already narrows it; this holds if that is ever loosened.
abi <abi/4.0>,
include <tunables/global>

profile medbrains-server /usr/bin/medbrains-server flags=(attach_disconnected) {
  include <abstractions/base>
  include <abstractions/nameservice>
  include <abstractions/ssl_certs>

  signal (receive) peer=unconfined,
  network inet stream,
  network inet6 stream,
  network inet dgram,
  network inet6 dgram,
  network netlink raw,
  unix,

  /usr/bin/medbrains-server mr,
  /usr/share/medbrains/** r,
  /usr/share/zoneinfo/** r,
  /var/lib/medbrains/ r,
  /var/lib/medbrains/config/idp-front.pem r,
  /var/lib/medbrains/{objects,cold,archive}/ rw,
  /var/lib/medbrains/{objects,cold,archive}/** rwk,
  /var/log/medbrains/ rw,
  /var/log/medbrains/** rwk,
  owner /tmp/** rwk,
  @{PROC}/@{pid}/** r,
  @{PROC}/sys/kernel/** r,
  @{PROC}/sys/vm/** r,
  @{PROC}/{meminfo,stat,uptime,loadavg,cpuinfo} r,
  /sys/fs/cgroup/** r,
  /sys/kernel/mm/transparent_hugepage/** r,
  /sys/devices/system/cpu/** r,

  include if exists <local/medbrains-server>
}
