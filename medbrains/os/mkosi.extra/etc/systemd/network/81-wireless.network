# Wi-Fi joins through iwd; addressing stays with networkd, the same as a cable.
[Match]
Name=wl*

[Network]
DHCP=yes
MulticastDNS=yes
IgnoreCarrierLoss=3s

# A DHCP server must not rename the machine: the name is in its certificate and its authority.
[DHCPv4]
UseHostname=no

[DHCPv6]
UseHostname=no
