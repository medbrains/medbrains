# TLS front for the appliance. The server refuses plain-HTTP cookies in
# production, so even the LAN gets HTTPS: Caddy's local CA issues a certificate
# for whatever name the box is reached by. The first-boot wizard's own TLS
# step (trusted certificate) is D2.
{
	admin off
	default_sni medbrains.local
	on_demand_tls {
		interval 1m
		burst 10
	}
}

# Never a blank page when the server is down: a plain sentence, on the same 502.
(server) {
	encode zstd gzip
	reverse_proxy 127.0.0.1:3000
	handle_errors {
		respond "MedBrains is not answering. Try again in a moment; if it stays like this, call your system administrator." {err.status_code}
	}
}

# The machine's own screen, loopback only, with a certificate the kiosk trusts.
https://127.0.0.1:8443 {
	bind 127.0.0.1
	tls /var/lib/caddy/local/cert.pem /var/lib/caddy/local/key.pem
	import server
}

:80 {
	redir https://{host}{uri} permanent
}

:443 {
	tls internal {
		on_demand
	}
	import server
}

# The identity provider. A name of its own, not medbrains.local, because Kanidm's session cookies go
# to its whole domain and a browser sends cookies to every port of a name. A port of its own, so the
# LAN needs no new front end. Only loopback can reach Kanidm itself: see kanidmd.service.
:9443 {
	tls /var/lib/caddy/local/idp-cert.pem /var/lib/caddy/local/idp-key.pem
	encode zstd gzip
	# SCIM has crashed Kanidm twice through its filter parser and we do not use it. The landing page is
	# upstream sign-in, which has no setting to turn off and which we do not use either.
	@internal path /docs* /metrics* /scim/* /ui/login/oauth2_landing* /ui/radius*
	handle @internal {
		respond 404
	}
	# Every request that can carry a guess asks the limiter first: one address, a limited rate. If it is
	# down, Caddy answers 502: sign-ins fail closed, and systemd restarts it within a second.
	@signin {
		method POST
		path /ui/login/begin /ui/login/pw /ui/login/totp /ui/login/backup_code /v1/auth /v1/reauth
	}
	handle {
		forward_auth @signin 127.0.0.1:3101 {
			uri /check
		}
		reverse_proxy https://127.0.0.1:8444 {
			transport http {
				tls_trusted_ca_certs /var/lib/caddy/local/kanidm-back.pem
				tls_server_name idm.medbrains.local
			}
		}
	}
	handle_errors {
		respond "Sign-in is not answering. Try again in a moment; if it stays like this, call your system administrator." {err.status_code}
	}
}
