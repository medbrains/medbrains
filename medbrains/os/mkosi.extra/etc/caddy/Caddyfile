# TLS front for the appliance. The server refuses plain-HTTP cookies in
# production, so even the LAN gets HTTPS: Caddy's local CA issues a certificate
# for whatever name the box is reached by. The first-boot wizard's own TLS
# step (trusted certificate) is D2.
{
	admin off
	default_sni medbrains.local
	on_demand_tls {
		interval 1m
		burst 10
	}
}

# Never a blank page when the server is down: a plain sentence, on the same 502.
(server) {
	encode zstd gzip
	# Reused connections took the server from about 200 MB to about 1 GB when a page opened, and
	# the cause inside the server is still open. A new connection on loopback costs almost nothing.
	reverse_proxy 127.0.0.1:3000 {
		transport http {
			keepalive off
		}
	}
	handle_errors {
		respond "MedBrains is not answering. Try again in a moment; if it stays like this, call your system administrator." {err.status_code}
	}
}

# The machine's own screen, loopback only, with a certificate the kiosk trusts.
https://127.0.0.1:8443 {
	bind 127.0.0.1
	tls /var/lib/caddy/local/cert.pem /var/lib/caddy/local/key.pem
	import server
}

:80 {
	redir https://{host}{uri} permanent
}

:443 {
	tls internal {
		on_demand
	}
	import server
}
