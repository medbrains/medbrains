# API base URL — proxied in dev, direct in production
VITE_API_BASE=/api

# Body-site picker anatomy model (~33 MB). Dev serves apps/web/public/anatomy
# (`make anatomy-sync`); production points at the CDN, whose origin must also be
# set as ANATOMY_CDN_ORIGIN on the server so the CSP lets the browser fetch it.
VITE_ANATOMY_BASE_URL=/anatomy
