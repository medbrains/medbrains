{
  "name": "@medbrains/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "gen:crabs": "node scripts/build-crab-lottie.mjs",
    "dev:scan": "VITE_REACT_SCAN=true VITE_DEV_PORT=5174 vite --host 127.0.0.1 --port 5174",
    "build": "tsc -b && vite build && pnpm run build:help",
    "build:help": "pnpm --filter @medbrains/docs build && node -e \"require('node:fs').cpSync('../docs/build', 'dist/help', { recursive: true })\"",
    "preview": "vite preview",
    "lint": "biome check src/",
    "lint:fix": "biome check --write src/",
    "format": "biome format --write src/",
    "format:check": "biome format src/",
    "typecheck": "tsc --noEmit",
    "check:circular": "dpdm --no-warning --no-tree --exit-code circular:1 --tsconfig tsconfig.json src/main.tsx",
    "analyze": "ANALYZE=true vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:mock": "playwright test --project mock-chromium e2e/mock/",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@fontsource/ibm-plex-sans": "^5.2.8",
    "@hookform/resolvers": "^5.2.2",
    "@lottiefiles/dotlottie-react": "0.20.0",
    "@lottiefiles/dotlottie-web": "0.81.0",
    "@mantine/charts": "^9.3.2",
    "@mantine/core": "^9.3.2",
    "@mantine/dates": "^9.3.2",
    "@mantine/hooks": "^9.3.2",
    "@mantine/modals": "^9.3.2",
    "@mantine/notifications": "^9.3.2",
    "@mantine/schedule": "^9.3.2",
    "@mantine/spotlight": "^9.3.2",
    "@mantine/tiptap": "^9.3.2",
    "@medbrains/api": "workspace:*",
    "@medbrains/crdt": "workspace:*",
    "@medbrains/design-system": "workspace:*",
    "@medbrains/schemas": "workspace:*",
    "@medbrains/stores": "workspace:*",
    "@medbrains/types": "workspace:*",
    "@medbrains/utils": "workspace:*",
    "@sentry/react": "11.6.0",
    "@tabler/icons-react": "^3.40.0",
    "@tanstack/react-pacer": "0.22.0",
    "@tanstack/react-query": "^5.90.21",
    "@tiptap/extension-link": "^3.27.1",
    "@tiptap/pm": "^3.27.1",
    "@tiptap/react": "^3.27.1",
    "@tiptap/starter-kit": "^3.27.1",
    "@xyflow/react": "^12.10.1",
    "browser-image-compression": "^2.0.2",
    "dayjs": "^1.11.20",
    "echarts": "^6.0.0",
    "i18next": "^26.5.6",
    "i18next-http-backend": "^4.0.4",
    "motion": "^12.38.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-hook-form": "^7.71.2",
    "react-i18next": "^17.1.3",
    "react-markdown": "^10.1.0",
    "react-router": "^8.2.0",
    "react-use": "^17.6.0",
    "read-excel-file": "5.8.0",
    "recharts": "^3.8.0",
    "rehype-highlight": "^7.0.2",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "three": "^0.180.0",
    "write-excel-file": "^4.1.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.6",
    "@dotlottie/dotlottie-js": "1.8.0",
    "@playwright/test": "^1.60.0",
    "@sentry/vite-plugin": "5.4.1",
    "@storybook/react-vite": "^10.4.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^5.0.5",
    "axe-core": "4.11.4",
    "dpdm": "^3.14.0",
    "jsdom": "^29.1.1",
    "msw": "^2.14.2",
    "postcss": "^8.5.14",
    "postcss-preset-mantine": "^1.17.0",
    "postcss-simple-vars": "^7.0.1",
    "react-scan": "^0.5.6",
    "rollup-plugin-visualizer": "^7.0.1",
    "sass-embedded": "^1.99.0",
    "storybook": "^10.4.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vite-plugin-compression2": "^2.5.3",
    "vite-plugin-svgr": "4.5.0",
    "vite-plugin-wasm": "^3.6.0",
    "vitest": "^5.0.5"
  }
}
