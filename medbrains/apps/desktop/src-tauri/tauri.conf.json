{
  "$schema": "https://schema.tauri.app/config/2.0.0",
  "productName": "MedBrains",
  "version": "0.1.0",
  "identifier": "in.medbrains.desktop",
  "build": {
    "beforeDevCommand": "cd ../web && pnpm dev",
    "beforeBuildCommand": "cd ../web && pnpm build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'",
      "capabilities": [
        "main-capability"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Medical",
    "shortDescription": "MedBrains desktop client",
    "longDescription": "MedBrains for Windows and Mac PCs. Connects to your hospital's MedBrains server and adds silent printing and the system keychain.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": null,
      "entitlements": null,
      "providerShortName": null
    },
    "windows": {
      "wix": {
        "language": [
          "en-IN",
          "ta-IN",
          "hi-IN"
        ]
      },
      "nsis": null,
      "certificateThumbprint": null,
      "digestAlgorithm": null,
      "timestampUrl": null
    },
    "linux": {
      "deb": {
        "depends": []
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "createUpdaterArtifacts": false
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/medbrains/medbrains/releases/latest/download/latest.json"
      ],
      "dialog": false,
      "pubkey": "REPLACE_WITH_TAURI_UPDATER_PUBLIC_KEY"
    },
    "deep-link": {
      "schemes": [
        "medbrains"
      ]
    }
  }
}
