{
  "name": "@medbrains/mobile-staff",
  "private": true,
  "version": "0.1.0",
  "description": "MedBrains Staff \u2014 generated from medbrains-create-mobile-app, variant: staff",
  "main": "index.js",
  "scripts": {
    "android": "pnpm run build:native-plugin && expo run:android",
    "build:dev:android": "eas build --profile development --platform android",
    "build:dev:ios": "eas build --profile development --platform ios",
    "build:native-plugin": "pnpm --filter @medbrains/uniffi-rn-plugin build",
    "e2e:build": "detox build -c ios.sim.debug",
    "e2e:ios": "NODE_EXTRA_CA_CERTS=\"$(mkcert -CAROOT)/rootCA.pem\" detox test -c ios.sim.debug",
    "e2e:ios:release": "NODE_EXTRA_CA_CERTS=\"$(mkcert -CAROOT)/rootCA.pem\" detox test -c ios.sim.release",
    "ios": "pnpm run build:native-plugin && expo run:ios",
    "lint": "biome check src/",
    "prebuild": "pnpm run build:native-plugin && expo prebuild --clean",
    "start": "expo start",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@medbrains/api": "workspace:*",
    "@medbrains/design-system": "workspace:*",
    "@medbrains/edge-rn-bindings": "workspace:*",
    "@medbrains/mobile-shell": "workspace:*",
    "@medbrains/schemas": "workspace:*",
    "@medbrains/types": "workspace:*",
    "@medbrains/ui-mobile": "workspace:*",
    "@medbrains/uniffi-rn-plugin": "workspace:*",
    "@react-navigation/native": "^7.1.33",
    "@react-navigation/native-stack": "^7.14.4",
    "@tanstack/react-query": "^5.90.21",
    "expo": "^54.0.0",
    "expo-camera": "~17.0.10",
    "expo-local-authentication": "~17.0.8",
    "expo-notifications": "~0.32.17",
    "expo-secure-store": "~15.0.8",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-hook-form": "^7.71.2",
    "react-native": "0.81.5",
    "react-native-paper": "^5.15.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.6",
    "@medbrains/e2e-mobile": "workspace:*",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.1.10",
    "detox": "^20.51.4",
    "jest": "^29.7.0",
    "jest-circus": "^29.7.0",
    "ts-jest": "^29.4.12",
    "typescript": "5.9.3",
    "vitest": "^4.1.5"
  }
}
