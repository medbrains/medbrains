{
  "compilerOptions": {
    "target": "ES2022",
    "module": "node16",
    "moduleResolution": "node16",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": [
      "jest",
      "detox"
    ],
    "noEmit": true,
    "isolatedModules": true
  },
  "include": [
    "./**/*.ts"
  ]
}
