{
  "name": "@medbrains/tv",
  "private": true,
  "version": "0.1.0",
  "description": "MedBrains TV — generated from medbrains-create-mobile-app, variant: tv",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "build:native-plugin": "pnpm --filter @medbrains/uniffi-rn-plugin build",
    "android": "pnpm run build:native-plugin && expo run:android",
    "ios": "pnpm run build:native-plugin && expo run:ios",
    "prebuild": "pnpm run build:native-plugin && expo prebuild --clean",
    "build:dev:ios": "eas build --profile development --platform ios",
    "build:dev:android": "eas build --profile development --platform android",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src/"
  },
  "dependencies": {
    "@medbrains/api": "workspace:*",
    "@medbrains/mobile-shell": "workspace:*",
    "@medbrains/types": "workspace:*",
    "@medbrains/ui-mobile": "workspace:*",
    "@react-navigation/native": "^7.1.33",
    "@react-navigation/native-stack": "^7.14.4",
    "@tanstack/react-query": "^5.90.21",
    "expo": "^54.0.0",
    "expo-camera": "~17.0.10",
    "expo-local-authentication": "~17.0.8",
    "expo-secure-store": "~15.0.8",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-paper": "^5.15.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "zustand": "^5.0.11",
    "@react-native-tvos/config-tv": "^0.1.0",
    "@medbrains/uniffi-rn-plugin": "workspace:*"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.6",
    "@types/react": "~19.1.10",
    "typescript": "^7.0.2"
  }
}
