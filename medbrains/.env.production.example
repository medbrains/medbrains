DATABASE_URL=postgres://medbrains:CHANGE_ME@127.0.0.1:5432/medbrains
BIND_ADDR=127.0.0.1:3000
CORS_ORIGIN=https://hims.amh.org.in
# If you expose the ICD sidecar through a separate hospital-controlled domain,
# append it here; do not allow generic localhost or wildcard origins.
# CORS_ORIGIN=https://hims.amh.org.in,https://icd.amh.org.in
COOKIE_DOMAIN=hims.amh.org.in
SECURE_COOKIES=true
TRUSTED_PROXIES=127.0.0.1/32
RUST_LOG=medbrains_server=info
STATIC_DIR=apps/web/dist
MEDBRAINS_SIGNATURE_KEY_ENCRYPTION_KEY=CHANGE_ME_RANDOM_32_BYTE_MINIMUM_SECRET
MEDBRAINS_EVENT_TOKEN_KEY=CHANGE_ME_RANDOM_32_BYTE_MINIMUM_SECRET
WHO_ICD_RELEASE_ID=2026-01
# Recommended research/standalone mode is the official WHO ICD-API Docker service.
# The Pingora proxy exposes it under the same hospital domain at /icd/*.
MEDBRAINS_ICD_LOCAL_SERVICE=true
ICD_API_ACCEPT_LICENSE=true
ICD_API_PORT=8382
ICD_API_INCLUDE=2026-01_en
ICD_API_SAVE_ANALYTICS=false
WHO_ICD_API_BASE_URL=https://hims.amh.org.in
WHO_ICD_AUTH_MODE=none
# Cloud OAuth fallback, only if the local service is disabled:
# WHO_ICD_CLIENT_ID=CHANGE_ME_WHO_ICD_CLIENT_ID
# WHO_ICD_CLIENT_SECRET=CHANGE_ME_WHO_ICD_CLIENT_SECRET
# WHO_ICD_API_BASE_URL=https://id.who.int
# WHO_ICD_AUTH_MODE=oauth
# WHO_ICD_TOKEN_URL=https://icdaccessmanagement.who.int/connect/token
