[Unit]
Description=MedBrains HMS — Rust API + SPA server
Documentation=https://github.com/DomnicAmalan/MedBrains
# Ordering only: after every local cluster (each postgresql@ instance is
# Before=postgresql.service), harmless when the database is somebody
# else's (attach). No hard dependency: the server is restarted until the
# database answers (Restart=on-failure).
After=network-online.target postgresql.service
Wants=network-online.target
# Crash-loop guard: 5 restarts in 10 min then stop thrashing —
# CloudWatch/Uptime alerts take over from there.
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=simple
User=medbrains
Group=medbrains
EnvironmentFile=/etc/medbrains/env
ExecStart=/usr/local/bin/medbrains-server
Restart=on-failure
RestartSec=5s
# The server drains requests in flight for 10s after SIGTERM and then exits
# on its own (DRAIN_DEADLINE, crates/medbrains-server-core/src/shutdown.rs). This
# is the backstop above that, not the wait: systemd's default of 90s was the
# length of every restart while a browser tab held a stream open.
TimeoutStopSec=15s
StandardOutput=journal
StandardError=journal

# Hardening — none of these break the binary; standard systemd
# practice for a service that only needs the postgres socket + the
# /var/lib/medbrains tree.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/medbrains /var/log/medbrains

# File descriptor limit — uploads + streaming need headroom.
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
