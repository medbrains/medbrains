[Unit]
Description=MedBrains Pingora edge proxy
Documentation=https://github.com/DomnicAmalan/MedBrains
After=network-online.target medbrains-server.service medbrains-edge.service
Wants=network-online.target medbrains-edge.service
Requires=medbrains-server.service

[Service]
Type=simple
User=medbrains
Group=medbrains
Environment=RUST_LOG=medbrains_proxy=info,pingora=warn
ExecStart=/usr/local/bin/medbrains-proxy --config /etc/medbrains/proxy.toml
Restart=on-failure
RestartSec=5s
TimeoutStopSec=10s
StandardOutput=journal
StandardError=journal

AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/log/medbrains
# Memory: a share of this machine's RAM; 25% of 2 GB is the 512 MB the OS
# image's front runs under (flood peak measured there: 197 MB). At MemoryMax
# only the proxy is killed, and Restart=on-failure brings it back.
MemoryHigh=15%
MemoryMax=25%
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
