# MedBrains standalone production env — copy to /etc/medbrains/env on
# the target server and chmod 600. Keys are pulled from this file by
# both medbrains-server.service and medbrains-archive.service.

# ── Database ────────────────────────────────────────────────────────
DATABASE_URL=postgres://medbrains:CHANGEME@127.0.0.1:5432/medbrains
DB_POOL_MAX_CONNECTIONS=20
DB_POOL_MIN_CONNECTIONS=2

# ── HTTP server ─────────────────────────────────────────────────────
HOST=127.0.0.1
PORT=3000

# ── Static SPA frontend ─────────────────────────────────────────────
# install.sh copies the built `apps/web/dist/` here.
STATIC_DIR=/var/www/medbrains

# ── Backups ─────────────────────────────────────────────────────────
# One of these must be set or the nightly timer stays disabled.
#   BACKUP_BUCKET  S3, set by terraform on the tiers whose host we own.
#   BACKUP_DIR     a path on this host — the attach tier, where the box
#                  belongs to the hospital and there is no bucket. NOT
#                  offsite: survives a dropped table, not a dead disk.
BACKUP_BUCKET=
BACKUP_DIR=
BACKUP_KEEP_DAYS=14

# ── JWT (Ed25519) ───────────────────────────────────────────────────
# Generate once on the server:
#   openssl genpkey -algorithm Ed25519 | base64 -w0   → JWT_PRIVATE_KEY
#   openssl pkey -pubout -in priv.pem | base64 -w0    → JWT_PUBLIC_KEY
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# ── CORS / cookies (production hardening) ───────────────────────────
# install.sh substitutes __DOMAIN__ with the actual hostname.
CORS_ORIGIN=https://__DOMAIN__
# ICD-API is proxied under the same hospital domain at /icd/*, so no
# extra CORS origin is needed. Do not use wildcard CORS or generic
# localhost in production.
COOKIE_DOMAIN=__DOMAIN__
SECURE_COOKIES=true

# Pingora is the trusted proxy on the same host — accept X-Forwarded-For
# from loopback only so external clients can't spoof IPs.
TRUSTED_PROXIES=127.0.0.1/32,::1/128

# ── Logging ─────────────────────────────────────────────────────────
RUST_LOG=medbrains_server=info,tower_http=warn

# ── Object-storage tier roots (medbrains-archive sweeper) ──────────
# install.sh creates these dirs with appropriate ownership.
MEDBRAINS_OBJECTS_HOT=/var/lib/medbrains/objects
MEDBRAINS_OBJECTS_COLD=/var/lib/medbrains/cold
MEDBRAINS_OBJECTS_ARCHIVE=/var/lib/medbrains/archive

# ── Optional integrations (leave unset for pilot) ──────────────────
# SMS / Email / WhatsApp / NHCX / ABDM / SpiceDB. The server falls
# back to internal stubs when these are unset, which is fine for
# the pilot but should be filled in before real patient traffic.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# SENDGRID_API_KEY=
# SPICEDB_ENDPOINT=
# SPICEDB_TOKEN=

# ── WHO ICD-11 terminology ─────────────────────────────────────────
# Option A, recommended for research/hospital deployments:
# run the official WHO ICD-API Docker container locally via install.sh.
# This keeps ICD search available without internet and pins the release.
MEDBRAINS_ICD_LOCAL_SERVICE=true
ICD_API_ACCEPT_LICENSE=false
ICD_API_PORT=8382
ICD_API_INCLUDE=2026-01_en
ICD_API_SAVE_ANALYTICS=false
WHO_ICD_RELEASE_ID=2026-01
WHO_ICD_API_BASE_URL=https://__DOMAIN__
WHO_ICD_AUTH_MODE=none

# Option B, WHO cloud fallback:
# Register at https://icd.who.int/icdapi and set credentials.
# WHO_ICD_RELEASE_ID=2026-01
# WHO_ICD_API_BASE_URL=https://id.who.int
# WHO_ICD_AUTH_MODE=oauth
# WHO_ICD_TOKEN_URL=https://icdaccessmanagement.who.int/connect/token
# WHO_ICD_CLIENT_ID=
# WHO_ICD_CLIENT_SECRET=
