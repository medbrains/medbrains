[Unit]
Description=Daily MedBrains host log archive → S3
Requires=medbrains-log-archive.service

[Timer]
# Just after local midnight: yesterday's journal is complete.
OnCalendar=*-*-* 00:20:00
RandomizedDelaySec=300
Persistent=true
Unit=medbrains-log-archive.service

[Install]
WantedBy=timers.target
