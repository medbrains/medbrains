#!/usr/bin/env bash
# /usr/local/bin/medbrains-pg-backup — invoked by the systemd timer.
#
# Two destinations, because the tiers do not all have the same one.
#
#   BACKUP_BUCKET  S3, with Object Lock + versioning making the dumps
#                  tamper-proof for 5 years (configured in terraform).
#                  The tiers whose host we own.
#
#   BACKUP_DIR     a directory on the host. The attach tier: the machine
#                  belongs to the hospital, there is no bucket, and
#                  getting one would mean shipping a long-lived AWS key
#                  to a server we do not control. A local dump that the
#                  hospital's own backup regime already collects is the
#                  better trade — that regime is the premise of the tier.
#
# BACKUP_DIR is NOT a substitute for offsite. It survives "somebody
# dropped a table" and does not survive the disk. Say so to the hospital
# rather than letting a directory of dumps read as disaster recovery.

set -euo pipefail

: "${POSTGRES_USER:?POSTGRES_USER must be in /etc/medbrains/.compose-env}"
: "${POSTGRES_DB:?POSTGRES_DB must be in /etc/medbrains/.compose-env}"

BACKUP_BUCKET="${BACKUP_BUCKET:-}"
BACKUP_DIR="${BACKUP_DIR:-}"
BACKUP_KEEP_DAYS="${BACKUP_KEEP_DAYS:-14}"

if [[ -z "$BACKUP_BUCKET" && -z "$BACKUP_DIR" ]]; then
    echo "ERROR: no backup destination. Set BACKUP_BUCKET (S3) or BACKUP_DIR" >&2
    echo "       (local path) in /etc/medbrains/env." >&2
    exit 1
fi

DATE="$(date -u +%Y-%m-%dT%H-%M-%SZ)"
HOSTNAME_TAG="$(hostname)"

# The prefix is configurable because the bucket may not be ours.
#
# On a shared host the backup vault belongs to the hospital and its policy
# grants this instance write access to one prefix, not to the bucket. A
# hardcoded "pg-backups/" meant this script wrote where it had no permission
# and died with AccessDenied — while the prefix it was allowed to use sat
# one directory away. Set BACKUP_PREFIX in /etc/medbrains/env to whatever
# the bucket policy actually grants.
BACKUP_PREFIX="${BACKUP_PREFIX:-pg-backups}"
BACKUP_PREFIX="${BACKUP_PREFIX%/}"
KEY="${BACKUP_PREFIX}/${HOSTNAME_TAG}/${DATE}.sql.gz"

# --format=custom + --compress=9 = small, restorable via pg_restore.
#
# GRANTs and default privileges ARE kept (no --no-privileges). The app
# connects as medbrains_app and the workers as medbrains_outbox_worker
# (migrations 0981/0984); both hold only granted rights. A dump without them
# restores a database every request is refused on, and the migrations that
# granted them are already recorded so a reboot does not re-grant. Found by
# the 2026-10-12 restore drill (docs/ops/BACKUP-RESTORE.md).
# Streams straight to S3 — no /tmp staging.
#
# Two shapes to dump from. The dedicated host runs Postgres in our
# container, so pg_dump runs inside it and the host needs no client.
# The attach tier reuses the hospital's own Postgres, where that
# container does not exist — dump over DATABASE_URL instead. Silently
# skipping is not an option: a backup that stops running looks exactly
# like a backup that is running.
if command -v docker >/dev/null 2>&1 && docker container inspect medbrains-postgres >/dev/null 2>&1; then
    dump_postgres() {
        docker exec -i medbrains-postgres pg_dump \
            -U "$POSTGRES_USER" -d "$POSTGRES_DB" "$@"
    }
else
    : "${DATABASE_URL:?DATABASE_URL must be set in /etc/medbrains/env when no medbrains-postgres container exists}"
    # The owner: pg_dump refuses tables whose row level security would filter
    # it, and medbrains_app is filtered by design.
    dump_postgres() { pg_dump "${MIGRATION_DATABASE_URL:-$DATABASE_URL}" "$@"; }
fi

if [[ -n "$BACKUP_BUCKET" ]]; then
    echo "==> dumping postgres → s3://${BACKUP_BUCKET}/${KEY}"
    dump_postgres \
        --format=custom \
        --compress=9 \
        --no-owner \
      | aws s3 cp - "s3://${BACKUP_BUCKET}/${KEY}" \
        --expected-size 1073741824 \
        --content-type application/octet-stream \
        --metadata "host=${HOSTNAME_TAG},captured-utc=${DATE}"
    DEST="s3://${BACKUP_BUCKET}/${KEY}"

    # Files: generated documents, uploads, the cold/archive tiers, the audit
    # sink and the edge doc store. Postgres rows point at these objects; a
    # database restored without them is a record of documents nobody can open.
    #
    # `sync`, not a nightly tarball: objects are write-once and a CT series
    # clears 40 GB, so re-uploading the tree daily is the wrong cost. Only new
    # or changed files go up. Nothing is ever deleted remotely (no --delete),
    # and the bucket is versioned, so an overwrite or ransomware rewrite
    # leaves the previous version recoverable for the lifecycle window.
    # pgdata is excluded: a file copy of a live cluster is not a backup, the
    # dump above is.
    FILES_PREFIX="${BACKUP_FILES_PREFIX:-file-backups}"
    FILES_PREFIX="${FILES_PREFIX%/}"
    for root in ${BACKUP_FILES_ROOTS:-/var/lib/medbrains /var/lib/medbrains-edge}; do
        [[ -d "$root" ]] || { echo "==> files: $root absent, skipping"; continue; }
        echo "==> syncing files ${root} → s3://${BACKUP_BUCKET}/${FILES_PREFIX}/${HOSTNAME_TAG}${root}/"
        aws s3 sync "$root" "s3://${BACKUP_BUCKET}/${FILES_PREFIX}/${HOSTNAME_TAG}${root}/" \
            --exclude 'pgdata/*' --exclude '*.partial' \
            --no-follow-symlinks --only-show-errors
    done
else
    # No file copy on this branch. BACKUP_DIR sits on the same disk as the
    # files, so a second copy there survives nothing the originals do not;
    # the hospital's host backup — the premise of this tier — must cover
    # /var/lib/medbrains directly. docs/ops/BACKUP-RESTORE.md says so.
    # Refuse to prune anywhere that is not a plain absolute path well
    # below the root. This script runs as root on a machine belonging to
    # somebody else and ends in `find -delete`; a BACKUP_DIR of "/" or
    # "/var" would be the last mistake it ever made.
    case "$BACKUP_DIR" in
        /|/var|/etc|/home|/usr|/root|/tmp) echo "ERROR: refusing BACKUP_DIR=$BACKUP_DIR" >&2; exit 1 ;;
        /*/*) : ;;
        *) echo "ERROR: BACKUP_DIR must be an absolute path at least two levels deep, got '$BACKUP_DIR'" >&2; exit 1 ;;
    esac

    install -d -m 0700 "$BACKUP_DIR"
    DEST="${BACKUP_DIR}/${HOSTNAME_TAG}-${DATE}.dump"

    echo "==> dumping postgres → ${DEST}"
    # Written under .partial and renamed. A dump interrupted halfway
    # otherwise sits in the directory carrying a perfectly good-looking
    # name, sorts newest-first, and is the one somebody reaches for.
    # rename(2) within a directory is atomic, so the final name only ever
    # appears on a dump pg_dump finished writing.
    umask 077
    dump_postgres \
        --format=custom \
        --compress=9 \
        --no-owner \
      > "${DEST}.partial"
    mv "${DEST}.partial" "$DEST"

    echo "==> pruning dumps older than ${BACKUP_KEEP_DAYS} days"
    find "$BACKUP_DIR" -maxdepth 1 -type f -name '*.dump' \
        -mtime "+${BACKUP_KEEP_DAYS}" -print -delete
    # A .partial left behind is a dump that died; it is not a backup and
    # it is not small. Clear yesterday's wreckage.
    find "$BACKUP_DIR" -maxdepth 1 -type f -name '*.dump.partial' \
        -mtime +1 -print -delete
fi

# ponytail: no separate integrity check here. `pg_dump | aws s3 cp` under
# `set -o pipefail` already fails this unit when pg_dump dies mid-stream,
# and OnFailure= pages with the journal tail - so a truncated upload is
# never silent. What is NOT proven is that the bytes restore: pg_restore
# --list only parses the table of contents and returns 0 on an archive
# missing 6% of its data section, and reading the object back to check
# even that costs a full re-download nightly.
#
# The real control is a restore test - restore yesterday's archive into a
# scratch database and count rows. The repo already has that shape at
# infra/k8s/cronjobs/pgbackrest-restore-test.yaml, pointed at a tier
# nothing instantiates. Wire it to the tiers carrying patients; do not
# approximate it here.
echo "==> backup complete: ${DEST}"
