listen        = "127.0.0.1:7811"
mdns_enabled  = false
mdns_hostname = "medbrains-edge.local."
service_name  = "medbrains-edge"
docs_path     = "/var/lib/medbrains-edge/docs"
chain_path    = "/var/lib/medbrains-edge/chain"

# Peer-to-peer sync (iroh). Absent or disabled means this appliance serves its
# LAN listener only, which is how every existing install runs.
#
# Reaches devices the LAN listener cannot: a phone on cellular, a hotspot with
# client isolation, a vehicle whose wifi drops mid-round.
#
# `roster_path` is the list of paired devices this box admits from, fetched from
# `GET /api/devices/peer-roster`. Without a current one the appliance admits no
# peer at all — that is the safe direction, not a bug.
#
# The token behind `auth_token_path` should hold `devices.pairing.roster.read`
# and nothing else. This box polls unattended and keeps that file for months; a
# token that can also list every paired device is a map of the estate.
#
# `relays` are relays YOU run. Leaving it empty means direct connections only;
# it is empty on purpose, because a public relay would route this hospital's
# sync metadata through a third party.
#
# [iroh]
# enabled         = true
# tenant_id       = "00000000-0000-0000-0000-000000000000"
# secret_key_path = "/var/lib/medbrains-edge/node.key"
# roster_path     = "/var/lib/medbrains-edge/peer-roster.json"
# relays          = []
# roster_refresh_seconds = 900
# server_url            = "https://hms.example.org"
# auth_token_path       = "/var/lib/medbrains-edge/roster.token"
