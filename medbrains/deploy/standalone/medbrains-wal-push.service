[Unit]
Description=MedBrains WAL spool → S3 (opt-in point-in-time recovery)
Documentation=https://github.com/DomnicAmalan/MedBrains/blob/master/medbrains/docs/ops/BACKUP-RESTORE.md
After=postgresql.service network-online.target
Wants=network-online.target
# No OnFailure=: an S3 outage would page every minute. medbrains-host-check
# pages once the oldest spooled segment is 15 minutes old.

[Service]
Type=oneshot
EnvironmentFile=/etc/medbrains/env
EnvironmentFile=-/etc/medbrains/postgres.env
ExecStart=/usr/local/bin/medbrains-wal-g push
Nice=5
Restart=no
