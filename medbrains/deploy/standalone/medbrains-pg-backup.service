[Unit]
Description=MedBrains daily postgres dump → S3, or to disk on the attach tier
After=docker.service medbrains-postgres.service
# Wants, not Requires. This unit dumps a containerised Postgres on the starter
# tier and the host's own on the attach tier — where docker is deliberately
# never installed, because reusing the host's Postgres is the whole point of
# attaching. A hard Requires makes systemd refuse to start the timer at all
# there: "Failed to start medbrains-pg-backup.timer: Unit docker.service not
# found", and a hospital runs without a nightly dump. Wants still orders it
# after docker where docker exists.
Wants=docker.service
# Silence from the nightly PHI dump reads as success and is discovered at restore
# time. Publish the failure to the tier's alarm topic instead.
OnFailure=medbrains-alert@%n.service

[Service]
Type=oneshot
EnvironmentFile=/etc/medbrains/env
# Optional: written only where docker compose runs the database.
EnvironmentFile=-/etc/medbrains/.compose-env
ExecStart=/usr/local/bin/medbrains-pg-backup
StandardOutput=journal
StandardError=journal
# IAM instance profile gives this process s3:PutObject — no static creds.
# Unused on the attach tier, which dumps to BACKUP_DIR and touches no AWS.
Environment="AWS_DEFAULT_REGION=ap-south-1"

# No restart — the timer will fire again tomorrow if today fails.
Restart=no
