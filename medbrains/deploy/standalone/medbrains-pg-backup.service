[Unit]
Description=MedBrains daily postgres dump → S3, or to disk on the attach tier
# Ordering only (after every local cluster), never Requires: on the attach tier the database is the
# host's own, and a hard dependency on a unit that is not there makes systemd
# refuse the timer — a hospital without a nightly dump.
After=network-online.target postgresql.service
# Silence from the nightly PHI dump reads as success and is discovered at restore
# time. Publish the failure to the tier's alarm topic instead.
OnFailure=medbrains-alert@%n.service medbrains-backup-report@failure.service
# The hospital's own inbox hears too: the daily summary on success, the
# failure at once (beside the SNS page, never instead). Both no-op when
# BACKUP_REPORT_TO is unset. OnSuccess= needs systemd 249+ (Ubuntu 22.04+).
OnSuccess=medbrains-backup-report@success.service

[Service]
Type=oneshot
EnvironmentFile=/etc/medbrains/env
# PATH with the kit's PostgreSQL major first (native-postgres.sh), whatever
# other client versions the host carries.
EnvironmentFile=-/etc/medbrains/postgres.env
ExecStart=/usr/local/bin/medbrains-pg-backup
StandardOutput=journal
StandardError=journal
# IAM instance profile gives this process s3:PutObject — no static creds.
# Unused on the attach tier, which dumps to BACKUP_DIR and touches no AWS.
Environment="AWS_DEFAULT_REGION=ap-south-1"

# No restart — the timer will fire again tomorrow if today fails.
Restart=no
