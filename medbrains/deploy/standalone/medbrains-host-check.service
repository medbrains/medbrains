[Unit]
Description=MedBrains host check — disk, certificate, backups, log archive, clock
Documentation=https://github.com/DomnicAmalan/MedBrains
OnFailure=medbrains-alert@%n.service

[Service]
Type=oneshot
EnvironmentFile=/etc/medbrains/env
ExecStart=/usr/local/bin/medbrains-host-check
# The S3 listings (backup, log archive) need a region; without one the AWS
# CLI errors and the check reads it as "unknown" — silent forever.
Environment="AWS_DEFAULT_REGION=ap-south-1"
