#!/usr/bin/env bash
# Install or roll back the web app without breaking the tabs already open on it.
#
#   medbrains-web-swap install <dir>   # <dir> holds a built apps/web/dist
#   medbrains-web-swap rollback        # put the previous web tree back
#
# Each release is unpacked into its own directory under <root>.d/. The live
# path <root> (default /var/www/medbrains) and <root>.prev are symlinks into
# it, so switching is one rename(2) of a symlink: a request sees the old tree
# or the new one, never a half-copied one, and no restart is needed.
#
# A tab opened before the swap still asks for the old hashed chunks, so each
# new tree carries the previous release's own `assets/` files forward.
# Older ones are pruned: a tab two releases old reloads (the app does that
# once on a failed chunk). Any error before the rename leaves the live tree
# untouched; the half-built directory is removed.
#
# Root-only in practice: it refuses to run unless the caller owns the parent
# of <root> and nobody else can write to it, which on a server means root.
# -E: the cleanup trap in install_web also fires for a failure in a helper.
set -Eeuo pipefail
# The web files are root's and read by the server: never let the caller's
# umask (002 for an ordinary Ubuntu login) decide who else can write them.
umask 022

ROOT="${MEDBRAINS_WEB_ROOT:-/var/www/medbrains}"
PARENT="$(dirname "$ROOT")"
RELEASES="$ROOT.d"
RELNAME="$(basename "$RELEASES")"
# The list of a tree's own hashed assets, as opposed to those it carried.
OWN_LIST=".release-assets"

# Prints the error and stops.
die() {
    echo "medbrains-web-swap: $*" >&2
    exit 1
}

# Refuses unless the caller owns the parent of the web root and it is not
# group or world writable: someone else who can write there can swap the app.
require_safe_parent() {
    [[ -d "$PARENT" ]] || die "$PARENT does not exist"
    if [[ -z "$(find "$PARENT" -maxdepth 0 -user "$(id -u)" ! -perm -020 ! -perm -002)" ]]; then
        die "$PARENT must be owned by the caller (root on a server) and writable by nobody else"
    fi
}

# Replaces symlink $2 with symlink $1 in a single rename(2).
swap_link() {
    if mv --version >/dev/null 2>&1; then
        mv -T "$1" "$2"
    else
        # ponytail: BSD mv (macOS, where the test also runs); -h = do not follow $2.
        mv -h "$1" "$2"
    fi
}

# Moves a real directory at $1 (the layout before symlinks) into the releases
# directory and leaves a symlink in its place. Two renames, once per host.
adopt_legacy() {
    local path="$1" id
    [[ -d "$path" && ! -L "$path" ]] || return 0
    # An empty placeholder (an older kit made one) is not a release to keep.
    if rmdir "$path" 2>/dev/null; then return 0; fi
    id="legacy-$(basename "$path")-$$"
    mv "$path" "$RELEASES/$id"
    ln -s "$RELNAME/$id" "$path"
}

# Prints the release directory a symlink points at, or nothing.
link_target() {
    [[ -L "$1" ]] && readlink "$1"
    return 0
}

# Lists every file under $1/assets as a path relative to it, subfolders
# included: a build keeps fonts, images and worker chunks below the top level,
# and an open tab asks for those too.
own_assets() {
    [[ -d "$1/assets" ]] || return 0
    (cd "$1/assets" && find . -type f | sed 's|^\./||' | LC_ALL=C sort)
}

# Copies the live tree's own assets into $1/assets when the new build lacks
# them (hashed names, so an existing name is the same file). Paths come from
# the live tree's own list; one that climbs out of assets/ is skipped.
carry_assets() {
    local new="$1" live="$PARENT/$2" name
    [[ -n "$2" && -d "$live/assets" ]] || return 0
    mkdir -p "$new/assets"
    if [[ -f "$live/$OWN_LIST" ]]; then
        cat "$live/$OWN_LIST"
    else
        own_assets "$live"
    fi | while IFS= read -r name; do
        [[ -n "$name" && "$name" != /* && "$name" != *..* && -f "$live/assets/$name" ]] || continue
        [[ -e "$new/assets/$name" ]] && continue
        mkdir -p "$new/assets/$(dirname "$name")"
        cp -p "$live/assets/$name" "$new/assets/$name"
    done
}

# Removes every release directory that neither <root> nor <root>.prev uses.
prune_releases() {
    local live prev dir
    live="$(link_target "$ROOT")"
    prev="$(link_target "$ROOT.prev")"
    for dir in "$RELEASES"/*; do
        [[ -e "$dir" ]] || continue
        case "$RELNAME/$(basename "$dir")" in
            "$live" | "$prev") ;;
            *) rm -rf "$dir" ;;
        esac
    done
}

# Builds a new release from $1, swaps it live and keeps the old one as .prev.
install_web() {
    local src="${1:-}" id new old
    [[ -f "$src/index.html" ]] || die "$src/index.html not found; is it a built apps/web/dist?"
    [[ -z "$(find "$src" \( -perm -002 -o -perm -020 \) -print -quit)" ]] \
        || die "$src has files others can write; refusing to install it"
    install -d -m 0755 "$RELEASES"
    adopt_legacy "$ROOT"
    adopt_legacy "$ROOT.prev"
    id="$(date -u +%Y%m%dT%H%M%SZ)-$$"
    new="$RELEASES/$id"
    trap 'rm -rf "$new" "$ROOT.next" "$ROOT.prev.next"' ERR
    mkdir -m 0755 "$new"
    cp -R "$src/." "$new/"
    own_assets "$new" > "$new/$OWN_LIST"
    old="$(link_target "$ROOT")"
    carry_assets "$new" "$old"
    if [[ "$(id -u)" == 0 ]]; then chown -R 0:0 "$new"; fi
    chmod -R u=rwX,go=rX "$new"
    ln -s "$RELNAME/$id" "$ROOT.next"
    swap_link "$ROOT.next" "$ROOT"
    trap - ERR
    if [[ -n "$old" ]]; then
        ln -sfn "$old" "$ROOT.prev.next"
        swap_link "$ROOT.prev.next" "$ROOT.prev"
    fi
    prune_releases
    echo "web: $RELNAME/$id is live${old:+, previous kept as $ROOT.prev}"
}

# Swaps <root> and <root>.prev, so a second rollback rolls forward again.
rollback_web() {
    local cur prev
    [[ -e "$ROOT.prev" ]] || die "no previous web tree at $ROOT.prev"
    install -d -m 0755 "$RELEASES"
    adopt_legacy "$ROOT"
    adopt_legacy "$ROOT.prev"
    cur="$(link_target "$ROOT")"
    prev="$(link_target "$ROOT.prev")"
    [[ -d "$PARENT/$prev" ]] || die "$ROOT.prev points at a missing tree"
    ln -sfn "$prev" "$ROOT.next"
    swap_link "$ROOT.next" "$ROOT"
    ln -sfn "$cur" "$ROOT.prev.next"
    swap_link "$ROOT.prev.next" "$ROOT.prev"
    echo "web: rolled back to $prev"
}

require_safe_parent
case "${1:-}" in
    install) install_web "${2:-}" ;;
    rollback) rollback_web ;;
    *) die "usage: medbrains-web-swap install <dir> | rollback" ;;
esac
