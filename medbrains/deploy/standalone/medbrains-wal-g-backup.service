[Unit]
Description=MedBrains WAL-G base backup (opt-in point-in-time recovery) → S3
Documentation=https://github.com/DomnicAmalan/MedBrains/blob/master/medbrains/docs/ops/BACKUP-RESTORE.md
After=docker.service postgresql.service network-online.target
Wants=network-online.target
# A base backup that stops working leaves WAL with nothing to replay onto.
OnFailure=medbrains-alert@%n.service

[Service]
Type=oneshot
EnvironmentFile=/etc/medbrains/env
EnvironmentFile=-/etc/medbrains/.compose-env
# Daily; WALG_DELTA_MAX_STEPS=6 in walg.yaml makes six of seven a delta, so a
# full copy goes up weekly and every base is at most 7 days old (the bucket's
# lifecycle keeps the prefix 35 days on that assumption).
ExecStart=/usr/local/bin/medbrains-wal-g backup
Nice=10
IOSchedulingClass=idle
Restart=no
