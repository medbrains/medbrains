[Unit]
Description=MedBrains WAL-G base backup (opt-in, attach tier) → S3
Documentation=https://github.com/DomnicAmalan/MedBrains/blob/master/medbrains/docs/ops/BACKUP-RESTORE.md
After=postgresql.service network-online.target
Wants=network-online.target
# A base backup that stops working leaves WAL with nothing to replay onto.
OnFailure=medbrains-alert@%n.service

[Service]
Type=oneshot
User=postgres
# Daily; WALG_DELTA_MAX_STEPS=6 in walg.yaml makes six of seven a delta, so a
# full copy goes up weekly and every base is at most 7 days old (the S3
# lifecycle on wal-g/ keeps 35 days on that assumption).
ExecStart=/bin/sh -c 'exec /usr/local/bin/wal-g --config /etc/medbrains/walg.yaml backup-push "$(psql -XAtc "SHOW data_directory")"'
Nice=10
IOSchedulingClass=idle
Restart=no
