# Copy to .env and edit. Nothing here has a safe default except the ports.

# ── Required ──────────────────────────────────────────────────────

# Postgres superuser password for this deployment. Generate it, do not choose
# it: `openssl rand -base64 32`
POSTGRES_PASSWORD=

# The built web app. Relative to this directory, or absolute.
#   pnpm --filter @medbrains/web build
WEB_DIST=../../apps/web/dist

# ── Usually left alone ────────────────────────────────────────────

POSTGRES_DB=medbrains
POSTGRES_USER=medbrains

# Build locally with `docker build -t medbrains-server:local .` from the repo
# root, or set this to a tag from your registry. Building on the hospital's
# box is slow and needs a toolchain it should not have.
MEDBRAINS_IMAGE=medbrains-server:local

RUST_LOG=medbrains=info,tower_http=warn

# ── Object storage: leave empty for local disk ────────────────────
#
# Only set these to point at MinIO or a cloud bucket. Empty means the local
# filesystem tier on the medbrains-objects volume, which is what one hospital
# on one box should use.
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
