  "query": "INSERT INTO psych_directive_challenges (tenant_id, advance_directive_id, applicant_role, grounds, details, filed_by) SELECT $1, d.id, $3, $4, $5, $6 FROM psych_advance_directives d WHERE d.id = $2 AND d.tenant_id = $1 AND d.status = 'active' RETURNING id, tenant_id, advance_directive_id, applicant_role, grounds, details, status, board_reference, decided_at, decision_note, filed_by, created_at, updated_at",
