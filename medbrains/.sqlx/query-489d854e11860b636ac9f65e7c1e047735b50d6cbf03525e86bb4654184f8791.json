{
  "db_name": "PostgreSQL",
  "query": "INSERT INTO uhi_slot_ids (tenant_id, doctor_id, slot_date, slot_start) SELECT $1, d, s, t FROM UNNEST($2::uuid[], $3::date[], $4::time[]) AS u(d, s, t) ON CONFLICT (tenant_id, doctor_id, slot_date, slot_start) DO UPDATE SET doctor_id = EXCLUDED.doctor_id RETURNING id, doctor_id, slot_date, slot_start",
