  "query": "UPDATE patient_allergies SET verification_status = $1, verification_reason = NULLIF($2, ''), verified_by = $3, verified_at = now(), is_active = CASE WHEN $4 THEN false ELSE is_active END, updated_at = now() WHERE id = $5 AND patient_id = $6 AND tenant_id = $7 AND deleted_at IS NULL AND verification_status NOT IN ('refuted', 'entered_in_error') RETURNING *",
