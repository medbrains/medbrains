{
  "db_name": "PostgreSQL",
  "query": "SELECT sr.id, sr.signed_at, sr.signer_user_id, sr.display_image_snapshot, sr.display_block, sr.legal_class, COALESCE(dp.display_name, u.full_name) AS signer_name FROM signed_records sr LEFT JOIN doctor_profiles dp ON dp.user_id = sr.signer_user_id AND dp.tenant_id = sr.tenant_id LEFT JOIN users u ON u.id = sr.signer_user_id WHERE sr.tenant_id = $1 AND sr.record_type = $2 AND sr.record_id = $3 ORDER BY sr.signed_at LIMIT 5000",
