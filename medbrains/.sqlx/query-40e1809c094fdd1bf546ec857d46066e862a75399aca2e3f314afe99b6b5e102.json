  "query": "SELECT concat_ws(' ', p.first_name, NULLIF(btrim(p.middle_name), ''), p.last_name) AS \"patient_name!\", p.uhid, p.date_of_birth, p.gender::text AS \"gender!\", p.phone, NULLIF(concat_ws(', ', NULLIF(btrim(p.address->>'line1'), ''), NULLIF(btrim(p.address->>'city'), '')), '') AS address, p.created_at, p.opd_number, p.opd_date FROM patients p WHERE p.id = $1 AND p.tenant_id = $2 AND p.deleted_at IS NULL",
