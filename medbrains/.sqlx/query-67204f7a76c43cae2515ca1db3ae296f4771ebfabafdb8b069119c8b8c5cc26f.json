  "db_name": "PostgreSQL",
  "query": "SELECT concat_ws(' ', first_name, last_name) AS \"patient_name!\", uhid, date_of_birth, EXTRACT(YEAR FROM age(date_of_birth))::float8 AS age, gender::text AS \"gender!\", blood_group::text AS blood_group, phone, email, NULLIF(concat_ws(', ', NULLIF(btrim(address->>'line1'), ''), NULLIF(btrim(address->>'city'), '')), '') AS address, emergency_contact_name, emergency_contact_phone, photo_url, created_at FROM patients WHERE id = $1 AND tenant_id = $2 AND deleted_at IS NULL",
