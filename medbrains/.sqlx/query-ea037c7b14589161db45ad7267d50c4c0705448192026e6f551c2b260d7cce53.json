{
  "db_name": "PostgreSQL",
  "query": "SELECT c.id, c.tenant_id, c.advance_directive_id, c.applicant_role, c.grounds, c.details, c.status, c.board_reference, c.decided_at, c.decision_note, c.filed_by, c.created_at, c.updated_at FROM psych_directive_challenges c JOIN psych_advance_directives d ON d.id = c.advance_directive_id WHERE d.psych_patient_id = $1 AND c.tenant_id = $2 AND c.deleted_at IS NULL ORDER BY c.created_at DESC LIMIT 100",
