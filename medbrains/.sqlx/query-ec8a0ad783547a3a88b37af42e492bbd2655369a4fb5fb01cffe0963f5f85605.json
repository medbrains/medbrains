  "query": "SELECT a.id, a.warning_code, a.severity, a.action_taken, a.message, a.override_reason, u.full_name AS \"checked_by_name?\", a.checked_at FROM cpoe_safety_audit a LEFT JOIN users u ON u.id = a.checked_by AND u.tenant_id = a.tenant_id WHERE a.tenant_id = $1 AND a.source_module = 'pharmacy' AND a.source_record_id = $2 AND a.deleted_at IS NULL ORDER BY a.checked_at DESC LIMIT $3",
