# MedBrains infra credentials — single source of truth for terraform
# + every operational script. Copy to `medbrains/infra/.env` and fill
# in. The file is gitignored.
#
# Used by:
#   medbrains/infra/terraform/envs/standalone/alagappa/Makefile
#   medbrains/tools/setup-tenant-dns/  (reads same vars)

# ── Buyer tier ──
# Picks the AWS shape: test | demo | starter (EC2 + docker pg, ARM,
# default, simplest deploy) | growth (Fargate + RDS) |
# enterprise-k3s (k3s ARM + RDS, ₹4.5k — adds HPA + autoscaling) |
# enterprise (EKS + Aurora, ₹9k+).
TF_VAR_tier=starter

# Edge proxy for standalone tiers.
TF_VAR_edge_proxy=pingora

# Optional instance override. Empty uses package defaults:
# test=t4g.small; demo/starter/enterprise-k3s=t4g.medium.
TF_VAR_aws_instance_type=

# ── AWS (EC2 + Route53 + S3 if you ever swap object_store) ──
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...
AWS_REGION=ap-south-1

# Name of the EC2 keypair already in the AWS account.
# Look it up: `aws ec2 describe-key-pairs --query 'KeyPairs[].KeyName'`.
TF_VAR_aws_ssh_key_name=medbrains-deploy

# Path to the matching private key on the operator's machine.
TF_VAR_ssh_private_key_path=/Users/$(whoami)/.ssh/id_ed25519

# ── GoDaddy (DNS) ──
GODADDY_API_KEY=...
GODADDY_API_SECRET=...

# ── Operational ──
TF_VAR_admin_email=ops@amh.org.in

# Optional overrides — defaults usually work.
# TF_VAR_domain=hims.amh.org.in
# TF_VAR_zone_name=amh.org.in
