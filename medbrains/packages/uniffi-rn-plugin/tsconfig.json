{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "lib",
    "rootDir": "src",
    // package.json declares "type": "commonjs", so node16 emits CJS.
    // TypeScript 7 removed the node10 resolver that "node" aliased.
    "module": "node16",
    "moduleResolution": "node16",
    "lib": ["ES2022"],
    "types": ["node"]
  },
  "include": ["src"]
}
