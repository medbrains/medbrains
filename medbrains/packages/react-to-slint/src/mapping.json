{
  "_doc": "React (Mantine and our components/ui seam) to Slint. Each entry: the Slint element, which props become which Slint properties, and optional fixed properties. Targets starting with _ are handled by the kit component and not emitted; a target ending in ! is negated (disabled becomes enabled). Elements named Mb* come from medbrains-gui-kit, the shared Slint kit in docs/architecture/OS-NATIVE-GUI.md.",
  "version": 1,
  "layout": {
    "Stack": { "slint": "VerticalLayout", "props": { "gap": "spacing", "p": "padding" } },
    "Group": { "slint": "HorizontalLayout", "props": { "gap": "spacing", "p": "padding" } },
    "Flex": { "slint": "HorizontalLayout", "props": { "gap": "spacing" } },
    "SimpleGrid": { "slint": "GridLayout", "props": { "spacing": "spacing" } },
    "Grid": { "slint": "GridLayout", "props": { "gutter": "spacing" } },
    "Box": { "slint": "Rectangle", "props": {} },
    "Center": { "slint": "VerticalLayout", "props": {}, "fixed": { "alignment": "center" } },
    "ScrollArea": { "slint": "ScrollView", "props": {} },
    "Divider": { "slint": "MbDivider", "props": {} },
    "Space": { "slint": "Rectangle", "props": { "h": "height", "w": "width" } }
  },
  "text": {
    "Text": { "slint": "Text", "props": { "c": "color", "fw": "font-weight", "size": "font-size" } },
    "Title": { "slint": "Text", "props": { "order": "_heading" }, "fixed": { "font-weight": "700" } },
    "Anchor": { "slint": "MbLink", "props": { "href": "url" } },
    "Code": { "slint": "Text", "props": {}, "fixed": { "font-family": "\"IBM Plex Mono\"" } }
  },
  "input": {
    "Button": { "slint": "MbButton", "props": { "tone": "tone", "onClick": "clicked", "disabled": "enabled!", "loading": "busy", "children": "text" } },
    "IconButton": { "slint": "MbIconButton", "props": { "aria-label": "accessible-label", "onClick": "clicked", "tone": "tone" } },
    "ActionIcon": { "slint": "MbIconButton", "props": { "aria-label": "accessible-label", "onClick": "clicked" } },
    "TextInput": { "slint": "LineEdit", "props": { "label": "_label", "placeholder": "placeholder-text", "value": "text", "onChange": "edited", "error": "_error", "disabled": "enabled!" } },
    "Input": { "slint": "LineEdit", "props": { "label": "_label", "placeholder": "placeholder-text", "value": "text", "onChange": "edited" } },
    "PasswordInput": { "slint": "LineEdit", "props": { "label": "_label", "value": "text", "onChange": "edited" }, "fixed": { "input-type": "password" } },
    "NumberInput": { "slint": "SpinBox", "props": { "label": "_label", "value": "value", "min": "minimum", "max": "maximum", "onChange": "edited" } },
    "NumberField": { "slint": "SpinBox", "props": { "label": "_label", "value": "value", "min": "minimum", "max": "maximum", "onChange": "edited" } },
    "TextArea": { "slint": "TextEdit", "props": { "label": "_label", "value": "text", "onChange": "edited" } },
    "Textarea": { "slint": "TextEdit", "props": { "label": "_label", "value": "text", "onChange": "edited" } },
    "Select": { "slint": "ComboBox", "props": { "label": "_label", "data": "model", "value": "current-value", "onChange": "selected" } },
    "MultiSelect": { "slint": "MbMultiSelect", "props": { "label": "_label", "data": "model", "value": "selected-values", "onChange": "changed" } },
    "Checkbox": { "slint": "CheckBox", "props": { "label": "text", "checked": "checked", "onChange": "toggled" } },
    "Switch": { "slint": "Switch", "props": { "label": "text", "checked": "checked", "onChange": "toggled" } },
    "SegmentedControl": { "slint": "MbSegmented", "props": { "data": "model", "value": "current-value", "onChange": "selected" } },
    "Slider": { "slint": "Slider", "props": { "value": "value", "min": "minimum", "max": "maximum", "onChange": "changed" } },
    "Chip": { "slint": "MbChip", "props": { "checked": "checked", "onChange": "toggled", "children": "text" } },
    "DateInput": { "slint": "MbDateInput", "props": { "label": "_label", "value": "date", "onChange": "edited" } },
    "DatePickerInput": { "slint": "MbDateInput", "props": { "label": "_label", "value": "date", "onChange": "edited" } }
  },
  "display": {
    "Badge": { "slint": "MbBadge", "props": { "tone": "tone", "children": "text" } },
    "Card": { "slint": "MbCard", "props": { "onClick": "clicked" } },
    "Panel": { "slint": "MbPanel", "props": { "title": "title", "description": "description" } },
    "Paper": { "slint": "MbCard", "props": {} },
    "Alert": { "slint": "MbAlert", "props": { "tone": "tone", "title": "title" } },
    "ThemeIcon": { "slint": "MbIcon", "props": { "tone": "tone" } },
    "Image": { "slint": "Image", "props": { "src": "source", "alt": "accessible-label" } },
    "Avatar": { "slint": "MbAvatar", "props": { "src": "source", "alt": "accessible-label" } },
    "Loader": { "slint": "Spinner", "props": {} },
    "Skeleton": { "slint": "MbSkeleton", "props": {} },
    "Progress": { "slint": "ProgressIndicator", "props": { "value": "progress" } },
    "Tooltip": { "slint": "_passthrough", "props": { "label": "accessible-description" } },
    "Table": { "slint": "StandardTableView", "props": { "data": "rows" } },
    "DataTable": { "slint": "StandardTableView", "props": { "records": "rows", "columns": "columns" } },
    "Tabs": { "slint": "TabWidget", "props": { "value": "current-index" } },
    "Modal": { "slint": "MbModal", "props": { "opened": "_open", "onClose": "closed", "title": "title" } },
    "Breadcrumb": { "slint": "MbBreadcrumb", "props": { "items": "model" } },
    "Crab": { "slint": "MbCrab", "props": { "variant": "variant" } },
    "SignatureHero": { "slint": "MbHero", "props": { "title": "title" } },
    "PageHeader": { "slint": "MbPageHeader", "props": { "title": "title", "subtitle": "subtitle" } }
  },
  "dropped": ["Fragment", "Suspense", "ErrorBoundary", "Trans", "Portal", "Transition"]
}
