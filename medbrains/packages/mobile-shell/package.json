{
  "name": "@medbrains/mobile-shell",
  "private": true,
  "version": "0.1.0",
  "description": "Cross-cutting React Native shell — auth flow, biometric/secret-store wiring, navigation chrome, offline bridge to medbrains-edge-rn. Consumed by every generated mobile/TV app.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./runtime-polyfills": {
      "import": "./runtime-polyfills.cjs",
      "require": "./runtime-polyfills.cjs"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@medbrains/edge-rn-bindings": "workspace:*",
    "@medbrains/schemas": "workspace:*",
    "@medbrains/types": "workspace:*",
    "@medbrains/ui-mobile": "workspace:*",
    "react-hook-form": "^7.71.2",
    "zustand": "^5.0.11"
  },
  "peerDependencies": {
    "@react-navigation/native": ">=7",
    "@react-navigation/native-stack": ">=7",
    "expo-camera": ">=17",
    "expo-local-authentication": ">=17",
    "expo-secure-store": ">=15",
    "react": ">=19",
    "react-native": ">=0.76",
    "react-native-paper": ">=5"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "typescript": "^5.9.3",
    "vitest": "^4.1.5"
  }
}
