{
  "name": "@medbrains/design-system",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "sideEffects": [
    "*.css",
    "*.scss"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./tokens": {
      "types": "./src/theme/tokens.ts",
      "import": "./src/theme/tokens.ts"
    },
    "./styles/global.scss": "./src/styles/global.scss",
    "./assets/*": "./src/assets/*"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "gen:colors": "node scripts/gen-colors.mjs"
  },
  "peerDependencies": {
    "@mantine/core": "^9.3.2",
    "@mantine/dates": "^9.3.2",
    "react": "^19.0.0"
  }
}
