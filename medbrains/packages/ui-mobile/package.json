{
  "name": "@medbrains/ui-mobile",
  "private": true,
  "version": "0.1.0",
  "description": "React Native Paper v5 wrappers for MedBrains enterprise surfaces — cards, data tables, badges, ECG loader. Mirrors the web design system.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./tokens": {
      "types": "./lib/tokens.d.ts",
      "import": "./lib/tokens.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@medbrains/design-system": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-native": ">=0.76",
    "react-native-paper": ">=5"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "typescript": "^7.0.2",
    "vitest": "^4.1.5"
  }
}
