{
  "name": "medbrains",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev:web": "turbo run dev --filter=@medbrains/web",
    "dev:mobile": "turbo run start --filter=@medbrains/mobile",
    "dev:tv": "turbo run start --filter=@medbrains/tv",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test"
  },
  "packageManager": "pnpm@10.30.3",
  "devDependencies": {
    "allure": "^3.6.2",
    "allure-vitest": "^3.7.1",
    "turbo": "^2.8.14"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@<1.1.14": "1.1.14",
      "picomatch@<2.3.2": "2.3.2",
      "picomatch@>=4.0.0 <4.0.4": "4.0.4",
      "postcss@<8.5.14": "8.5.14",
      "yaml@>=2.0.0 <2.8.4": "2.8.4"
    }
  }
}
