{
  "name": "medbrains",
  "private": true,
  "version": "3.33.0",
  "scripts": {
    "dev:web": "turbo run dev --filter=@medbrains/web",
    "dev:storybook": "turbo run dev --filter=@medbrains/storybook",
    "build:storybook": "pnpm --filter @medbrains/storybook build-storybook",
    "dev:mobile": "turbo run start --filter=@medbrains/mobile",
    "dev:tv": "turbo run start --filter=@medbrains/tv",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test"
  },
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.0.0"
  },
  "devDependencies": {
    "turbo": "^2.8.14"
  },
  "pnpm": {
    "overrides": {
      "@opentelemetry/core@<2.8.0": "2.12.0",
      "brace-expansion@<1.1.21": "1.1.21",
      "file-type@>=19.0.0 <21.3.4": "21.3.4",
      "follow-redirects@>=1.16.0 <1.16.2": "1.16.2",
      "joi@>=17.1.1 <17.13.9": "17.13.9",
      "js-cookie@<3.0.7": "3.0.8",
      "node-forge@<1.4.1": "1.4.1",
      "picomatch@<2.3.2": "2.3.2",
      "picomatch@>=4.0.0 <4.0.4": "4.0.4",
      "postcss@<8.5.23": "8.5.31",
      "serialize-javascript@<7.0.5": "7.1.3",
      "sharp@<0.35.5": "0.35.5",
      "shell-quote@<1.11.0": "1.12.0",
      "tinypool@<2.1.2": "2.2.0",
      "yaml@>=2.0.0 <2.8.4": "2.8.4",
      "zod": "4.6.7",
      "image-size@>=0.6.3 <2.0.3": "2.0.4",
      "glob@>=9.0.0 <14.0.2": "14.0.2",
      "minimatch@>=7.0.0 <11.0.1": "11.0.1",
      "valibot@<1.4.2": "1.4.2",
      "uuid@<11.1.1": "11.1.1",
      "stream-json@<3.7.0": "3.7.0",
      "deepmerge@>=4.2.0 <=4.3.1": "4.1.1"
    }
  }
}
