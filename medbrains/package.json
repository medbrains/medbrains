{
  "name": "medbrains",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev:web": "turbo run dev --filter=@medbrains/web",
    "dev:storybook": "turbo run dev --filter=@medbrains/storybook",
    "build:storybook": "pnpm --filter @medbrains/storybook build-storybook",
    "dev:mobile": "turbo run start --filter=@medbrains/mobile",
    "dev:tv": "turbo run start --filter=@medbrains/tv",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test"
  },
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "devDependencies": {
    "turbo": "^2.8.14"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@<1.1.14": "1.1.14",
      "picomatch@<2.3.2": "2.3.2",
      "picomatch@>=4.0.0 <4.0.4": "4.0.4",
      "postcss@<8.5.14": "8.5.14",
      "react": "19.2.4",
      "react-dom": "19.2.4",
      "yaml@>=2.0.0 <2.8.4": "2.8.4"
    }
  }
}
