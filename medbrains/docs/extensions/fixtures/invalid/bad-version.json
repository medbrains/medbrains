{
  "manifestVersion": 1,
  "kind": "service",
  "name": "Ward census sync",
  "purpose": "Sends each new admission's patient and encounter ids to the regional bed dashboard.",
  "publisher": {
    "name": "Example Health Tech",
    "url": "https://example-health.dev",
    "contact": "security@example-health.dev"
  },
  "version": "v1",
  "permissions": [
    "patients.view",
    "opd.queue.view"
  ],
  "reads": [
    "Patient",
    "Encounter"
  ],
  "events": [
    "patient.created"
  ],
  "dataClasses": [
    "routine",
    "identifying"
  ],
  "sendsDataTo": [
    {
      "name": "Regional bed dashboard (India, Mumbai region)",
      "url": "https://beds.example-health.dev",
      "purpose": "Show bed availability to the district control room"
    }
  ],
  "webhookUrl": "https://beds.example-health.dev/hooks/medbrains",
  "$expect": "version must be semantic"
}
